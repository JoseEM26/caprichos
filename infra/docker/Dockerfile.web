# syntax=docker/dockerfile:1

# ==============================================================================
# Etapa 1: Base - Node.js 24 Alpine con pnpm 12
# ==============================================================================
FROM node:24-alpine AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@12 --activate

# ==============================================================================
# Etapa 2: Dependencias - Instalación de dependencias del monorepo
# ==============================================================================
FROM base AS deps
WORKDIR /app

# Copiar manifiestos y configuración del workspace
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/compartido/package.json ./packages/compartido/

# Cache de BuildKit del store de pnpm: reinstalar solo descarga lo que cambió
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

# ==============================================================================
# Etapa 3: Builder - Compilación de React + Vite (PWA y SPA)
# ==============================================================================
FROM deps AS builder
WORKDIR /app

COPY . .

# Compilar tipos/lógica compartida y la web
RUN pnpm --filter @caprichos/compartido build || true
RUN pnpm --filter @caprichos/web build || pnpm run build

# ==============================================================================
# Etapa 4: Runner - Servidor Nginx ultra-ligero (~30 MB de RAM - INV-CAP-001)
# ==============================================================================
FROM nginx:alpine AS runner
WORKDIR /usr/share/nginx/html
# parche de seguridad (CVE-2026-111497): la 1.2.1 solo esta en edge; se quita cuando la rama estable la traiga
RUN apk add --no-cache --upgrade --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main brotli-libs

# Limpiar configuración por defecto
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Configuración optimizada de Nginx para SPA (React Router, compresión y caché).
# Va en un archivo aparte: el heredoc dentro de RUN no funciona con el builder clásico de Docker.
COPY infra/docker/nginx-caprichos.conf /etc/nginx/conf.d/caprichos.conf

# Copiar el paquete estático generado por Vite
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
# Aviso de «Versión de demostración» (lo sirve nginx en /demo; solo se usa en la demo)
COPY infra/docker/demo-aviso.html /usr/share/nginx/html/demo.html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/salud || exit 1

CMD ["nginx", "-g", "daemon off;"]
