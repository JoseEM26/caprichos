# Plantilla de variables para docker-compose.evolution.yml. COPIAR a un archivo fuera de Git
# (p. ej. ~/.aybar/evolution.env, permisos 0600) y poner valores reales ahí. NUNCA commitear el real.
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=cambiar-por-una-clave-larga
EVOLUTION_REDIS_PASSWORD=cambiar-por-otra-clave-larga
# Clave maestra de Evolution (la misma va como EVOLUTION_API_KEY en el .env de la API de Caprichos)
EVOLUTION_API_KEY=cambiar-por-un-secreto-de-32-o-mas-caracteres
# Token del webhook (el mismo va como EVOLUTION_WEBHOOK_TOKEN en la API de Caprichos)
EVOLUTION_WEBHOOK_TOKEN=cambiar-por-un-token-aleatorio
# Opcional: URL del webhook y red del ambiente de la API (por defecto, prod)
# EVOLUTION_WEBHOOK_URL=http://api:3000/whatsapp/evolution/webhook
# EVOLUTION_RED_API=caprichos-demo_red_interna
# Prod: EVOLUTION_VOLUMEN_PREFIJO=caprichos_evolution_prod (volúmenes propios; por defecto caprichos_evolution = demo)
