  CIERRE_CAJA ||--o{ CIERRE_MEDIO : "caja_id"
  COBRO ||--o{ COBRO_PAGO : "cobro_id"
  PARTY ||--o{ CONSUMO_PERSONAL : "party_id"
  PARTY ||--o{ LIQUIDACION : "repartidor_party_id"
  PARTY ||--o{ MOVIMIENTO_PUNTOS : "party_id"
  PEDIDO ||--o{ COBRO : "pedido_id"
  PEDIDO ||--o{ CONSUMO_PERSONAL : "pedido_id"
