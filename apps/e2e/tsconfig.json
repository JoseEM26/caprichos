{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "@playwright/test"],
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "playwright.config.ts"]
}
