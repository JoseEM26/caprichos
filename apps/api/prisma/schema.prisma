datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Schema mínimo para inicializar el cliente de Prisma sin tablas de negocio (HU-CAP-178)
model ControlSistema {
  id             String   @id @default(uuid())
  clave          String   @unique
  valor          String
  actualizado_en DateTime @updatedAt

  @@map("sys_control")
}

// ---------- Ola 1: personas, acceso, auditoría y configuración (ADR-004, ADR-008, ADR-014) ----------

model Party {
  id         BigInt            @id @default(autoincrement())
  tipo       String // PERSONA | ORGANIZACION
  estado     String            @default("ACTIVO")
  creado_en  DateTime          @default(now()) @db.Timestamptz
  persona    Person?
  documentos PartyIdentifier[]
  usuario    UserAccount?
  sesiones          Sesion[]
  pedidos           Pedido[]          @relation("ClientePedido")
  pedidosRepartidos Pedido[]          @relation("RepartidorPedido")
  liquidaciones     Liquidacion[]     @relation("LiquidacionesRepartidor")
  comprobantesEmitidos Comprobante[]     @relation("ComprobantesEmitidos")
  reclamosRespondidos  Reclamo[]         @relation("ReclamosRespondidos")

  @@map("party")
}

model Person {
  party_id  BigInt  @id
  nombres   String
  apellidos String?
  party     Party   @relation(fields: [party_id], references: [id])

  @@map("person")
}

model PartyIdentifier {
  id       BigInt @id @default(autoincrement())
  party_id BigInt
  tipo     String // DNI | RUC | CE
  numero   String
  party    Party  @relation(fields: [party_id], references: [id])

  @@unique([tipo, numero])
  @@map("party_identifier")
}

model Rol {
  codigo   String        @id
  nombre   String
  permisos RolPermiso[]
  usuarios UserAccount[]

  @@map("rol")
}

model Permiso {
  id     BigInt       @id @default(autoincrement())
  modulo String
  accion String
  roles  RolPermiso[]

  @@unique([modulo, accion])
  @@map("permiso")
}

model RolPermiso {
  rol        String
  permiso_id BigInt
  r          Rol     @relation(fields: [rol], references: [codigo])
  permiso    Permiso @relation(fields: [permiso_id], references: [id])

  @@id([rol, permiso_id])
  @@map("rol_permiso")
}

model UserAccount {
  id           BigInt   @id @default(autoincrement())
  party_id     BigInt   @unique
  rol          String
  hash         String
  debe_cambiar Boolean  @default(true)
  pin_hash     String?
  activo       Boolean  @default(true)
  alta_en      DateTime @default(now()) @db.Date
  party        Party    @relation(fields: [party_id], references: [id])
  r            Rol      @relation(fields: [rol], references: [codigo])

  @@map("user_account")
}

model Sesion {
  id           BigInt    @id @default(autoincrement())
  audiencia    String // ADMIN | CARTA
  party_id     BigInt
  refresh_hash String    @unique
  dispositivo  String?
  expira_en    DateTime  @db.Timestamptz
  revocada_en  DateTime? @db.Timestamptz
  party        Party     @relation(fields: [party_id], references: [id])

  @@map("sesion")
}

model Parametro {
  clave String @id
  valor Json

  @@map("parametro")
}

// Solo se inserta: los triggers de la migración encadenan el hash y bloquean update y delete.
model Auditoria {
  id            BigInt   @id @default(autoincrement())
  categoria     String // CAMBIO | ACCESO | LECTURA_SENSIBLE
  modulo        String
  accion        String
  resultado     String   @default("OK")
  entidad       String?
  entidad_id    BigInt?
  antes         Json?
  despues       Json?
  motivo        String?
  party_id      BigInt?
  con_pin_admin Boolean  @default(false)
  ip            String?  @db.Inet
  dispositivo   String?
  request_id    String?
  en            DateTime @default(now()) @db.Timestamptz
  hash_anterior Bytes?
  hash          Bytes    @default(dbgenerated("'\\x'::bytea"))

  @@index([en(sort: Desc), modulo, party_id], map: "ix_auditoria_busqueda")
  @@index([entidad, entidad_id], map: "ix_auditoria_entidad")
  @@map("auditoria")
}

// ---------- Ola 2: catálogo, local y archivos (FT-CAR-01, FT-CFG-01/02, ADR-012) ----------

model Lista {
  id      BigInt          @id @default(autoincrement())
  codigo  String          @unique
  nombre  String
  valores ListaValor[]
  grupos  GrupoOpciones[]

  @@map("lista")
}

model ListaValor {
  id              BigInt           @id @default(autoincrement())
  lista_id        BigInt
  nombre          String
  orden           Int              @default(0)
  activo          Boolean          @default(true)
  lista           Lista            @relation(fields: [lista_id], references: [id])
  productoTamanos ProductoTamano[]
  opciones        Opcion[]
  movimientosOrigen  MovimientoStock[] @relation("MovimientoStockOrigen")
  movimientosDestino MovimientoStock[] @relation("MovimientoStockDestino")
  recetas            Receta[]

  @@unique([lista_id, nombre])
  @@map("lista_valor")
}

model HorarioDia {
  dia_semana Int       @id @db.SmallInt
  abre       DateTime? @db.Time
  cierra     DateTime? @db.Time
  cerrado    Boolean   @default(false)

  @@map("horario_dia")
}

model FechaEspecial {
  fecha   DateTime  @id @db.Date
  cerrado Boolean
  abre    DateTime? @db.Time
  cierra  DateTime? @db.Time
  motivo  String?

  @@map("fecha_especial")
}

model Archivo {
  id         BigInt     @id @default(autoincrement())
  ruta       String     @unique
  tipo_mime  String
  bytes      Int
  privado    Boolean            @default(false)
  foto_local FotoLocal?
  productos  Producto[]
  incidentes IncidenteEntrega[]

  @@map("archivo")
}

model FotoLocal {
  archivo_id BigInt  @id
  orden      Int     @default(0)
  activo     Boolean @default(true)
  archivo    Archivo @relation(fields: [archivo_id], references: [id])

  @@map("foto_local")
}

model AreaCocina {
  id         BigInt      @id @default(autoincrement())
  nombre     String      @unique
  propia     Boolean     @default(false)
  impresora  String?
  etiquetera String?
  activo       Boolean       @default(true)
  categorias   Categoria[]
  pedidoLineas PedidoLinea[]
  comandas     ComandaArea[]
  altasDemanda AltaDemanda[]
  lugaresStock LugarStock[]

  @@map("area_cocina")
}

model Categoria {
  id             BigInt     @id @default(autoincrement())
  nombre         String     @unique
  lleva_opciones Boolean    @default(true)
  area_id        BigInt
  orden          Int        @default(0)
  oculta         Boolean    @default(false)
  area           AreaCocina @relation(fields: [area_id], references: [id])
  productos      Producto[]

  @@map("categoria")
}

model Producto {
  id                 BigInt           @id @default(autoincrement())
  categoria_id       BigInt
  nombre             String           @unique
  descripcion        String?
  foto_archivo_id    BigInt?
  precio             Decimal          @db.Decimal(12, 2)
  por_lote           Boolean          @default(false)
  vida_util_horas    Int?
  orden              Int              @default(0)
  oculto             Boolean          @default(false)
  agotado_hasta      DateTime?        @db.Timestamptz
  no_suma_beneficios Boolean          @default(false)
  categoria          Categoria        @relation(fields: [categoria_id], references: [id])
  foto_archivo       Archivo?         @relation(fields: [foto_archivo_id], references: [id])
  tamanos            ProductoTamano[]
  grupos             ProductoGrupo[]
  sabores            Sabor[]
  pedidoLineas       PedidoLinea[]
  agotados           Agotado[]
  stocks             Stock[]
  movimientosStock   MovimientoStock[]
  recetas            Receta[]

  @@map("producto")
}

model ProductoTamano {
  id              BigInt        @id @default(autoincrement())
  producto_id     BigInt
  tamano_valor_id BigInt
  precio          Decimal       @db.Decimal(12, 2)
  activo          Boolean       @default(true)
  producto        Producto      @relation(fields: [producto_id], references: [id])
  tamano_valor    ListaValor    @relation(fields: [tamano_valor_id], references: [id])
  recetaLineas    RecetaLinea[]

  @@unique([producto_id, tamano_valor_id])
  @@map("producto_tamano")
}

model GrupoOpciones {
  id          BigInt          @id @default(autoincrement())
  nombre      String          @unique
  lista_id    BigInt?
  obligatorio Boolean         @default(false)
  minimo      Int             @default(0)
  maximo      Int             @default(1)
  activo      Boolean         @default(true)
  lista       Lista?          @relation(fields: [lista_id], references: [id])
  opciones    Opcion[]
  productos   ProductoGrupo[]

  @@map("grupo_opciones")
}

model Opcion {
  id            BigInt        @id @default(autoincrement())
  grupo_id      BigInt
  valor_id      BigInt
  precio_extra  Decimal       @default(0) @db.Decimal(12, 2)
  activo              Boolean              @default(true)
  agotado_hasta       DateTime?            @db.Timestamptz
  grupo               GrupoOpciones        @relation(fields: [grupo_id], references: [id])
  valor               ListaValor           @relation(fields: [valor_id], references: [id])
  pedidoLineaOpciones PedidoLineaOpcion[]
  agotados            Agotado[]
  ajustes             AjusteOpcion[]

  @@unique([grupo_id, valor_id])
  @@map("opcion")
}

model ProductoGrupo {
  id          BigInt        @id @default(autoincrement())
  producto_id BigInt
  grupo_id    BigInt
  orden       Int           @default(0)
  producto    Producto      @relation(fields: [producto_id], references: [id])
  grupo       GrupoOpciones @relation(fields: [grupo_id], references: [id])

  @@unique([producto_id, grupo_id])
  @@map("producto_grupo")
}

model Sabor {
  id            BigInt    @id @default(autoincrement())
  producto_id   BigInt
  nombre        String
  activo        Boolean   @default(true)
  agotado_hasta DateTime? @db.Timestamptz
  producto      Producto  @relation(fields: [producto_id], references: [id])
  agotados      Agotado[]

  @@unique([producto_id, nombre])
  @@map("sabor")
}

// ---------- Ola 3: zonas de reparto y pedidos de la carta (FT-DEL-01, FT-PED-01..03, DT-57) ----------

model ZonaReparto {
  id       BigInt   @id @default(autoincrement())
  codigo   String   @unique
  poligono Json
  tarifa   Decimal  @db.Decimal(12, 2)
  activa   Boolean  @default(true)
  pedidos  Pedido[]

  @@map("zona_reparto")
}

model Pedido {
  id                     BigInt                  @id @default(autoincrement())
  codigo                 String                  @unique
  canal                  String                  @default("CARTA")
  modalidad              String
  estado                 String                  @default("COLA")
  party_id               BigInt?
  es_personal            Boolean                 @default(false)
  cliente_nombre         String?
  cliente_telefono       String?
  entrega_direccion      String?
  entrega_referencia     String?
  entrega_lat            Decimal?                @db.Decimal(9, 6)
  entrega_lng            Decimal?                @db.Decimal(9, 6)
  entrega_origen         String?
  zona_id                BigInt?
  pago_metodo            String?
  pago_estado            String?                 @default("PENDIENTE")
  pago_preferido         String?
  paga_con               Decimal?                @db.Decimal(12, 2)
  subtotal               Decimal                 @db.Decimal(12, 2)
  descuento              Decimal                 @default(0) @db.Decimal(12, 2)
  envio                  Decimal?                @db.Decimal(12, 2)
  total                  Decimal                 @db.Decimal(12, 2)
  comprobante_tipo       String                  @default("BOLETA")
  comprobante_doc        String?
  comprobante_razon      String?
  nota                   String?
  clave_idempotencia     String?                 @unique
  pago_coordinado_en     DateTime?               @db.Timestamptz
  pago_coordinado_por    BigInt?
  despachado_en          DateTime?               @db.Timestamptz
  despachado_por         BigInt?
  confirmado_en          DateTime?               @db.Timestamptz
  confirmado_por         BigInt?
  pasa_cocina_en         DateTime?               @db.Timestamptz
  listo_en               DateTime?               @db.Timestamptz
  entregado_en           DateTime?               @db.Timestamptz
  anulado_en             DateTime?               @db.Timestamptz
  anulado_por            BigInt?
  motivo_anulacion       String?
  anulacion_aprobada_por BigInt?
  creado_en              DateTime                @default(now()) @db.Timestamptz
  // Reparto (Ola 4)
  repartidor_party_id    BigInt?
  tomado_en              DateTime?               @db.Timestamptz
  salio_en               DateTime?               @db.Timestamptz
  llego_en               DateTime?               @db.Timestamptz
  motivo_falla           String?
  // Salón (Ola 6)
  mesa_nombre            String?
  entregado_mesa_en      DateTime?               @db.Timestamptz

  party                  Party?                  @relation("ClientePedido", fields: [party_id], references: [id])
  repartidor             Party?                  @relation("RepartidorPedido", fields: [repartidor_party_id], references: [id])
  zona                   ZonaReparto?            @relation(fields: [zona_id], references: [id])
  lineas                 PedidoLinea[]
  historial              PedidoEstadoHistorial[]
  cobro                  Cobro?
  incidentes             IncidenteEntrega[]
  mensajesReparto        MensajeReparto[]
  comandas               ComandaArea[]
  movimientosStock       MovimientoStock[]
  mesas                  PedidoMesa[]
  reservas               Reserva[]
  comprobante            Comprobante?
  reclamos               Reclamo[]

  @@map("pedido")
}

model PedidoLinea {
  id               BigInt              @id @default(autoincrement())
  pedido_id        BigInt
  producto_id      BigInt?
  nombre           String
  tamano           String?
  opciones         Json                @default("[]")
  sabor            String?
  nota             String?
  cantidad         Int
  precio_unit      Decimal             @db.Decimal(12, 2)
  subtotal         Decimal?            @db.Decimal(12, 2)
  area_id          BigInt?
  adicional        Boolean             @default(false)
  nombres_persona  String[]
  pedido           Pedido              @relation(fields: [pedido_id], references: [id])
  producto         Producto?           @relation(fields: [producto_id], references: [id])
  area             AreaCocina?         @relation(fields: [area_id], references: [id])
  opcionesElegidas PedidoLineaOpcion[]

  @@map("pedido_linea")
}

model PedidoLineaOpcion {
  id              BigInt      @id @default(autoincrement())
  pedido_linea_id BigInt
  opcion_id       BigInt?
  grupo_nombre    String
  opcion_nombre   String
  precio_unit     Decimal     @default(0) @db.Decimal(12, 2)
  precio_extra    Decimal     @default(0) @db.Decimal(12, 2)
  nombre_persona  String?
  pedido_linea    PedidoLinea @relation(fields: [pedido_linea_id], references: [id])
  opcion          Opcion?     @relation(fields: [opcion_id], references: [id])

  @@map("pedido_linea_opcion")
}

model PedidoEstadoHistorial {
  id              BigInt   @id @default(autoincrement())
  pedido_id       BigInt
  estado_anterior String?
  estado_nuevo    String
  motivo          String?
  por_party_id    BigInt?
  en              DateTime @default(now()) @db.Timestamptz
  pedido          Pedido   @relation(fields: [pedido_id], references: [id])

  @@map("pedido_estado_historial")
}

model SecuenciaPedido {
  nombre String @id
  ultimo Int    @default(0)

  @@map("secuencia_pedido")
}

// ---------- Ola 4: caja, cobros, cierres y reparto ----------

model Caja {
  id          BigInt      @id @default(autoincrement())
  fecha       DateTime    @unique @db.Date
  apertura    Decimal     @default(0) @db.Decimal(12, 2)
  estado      String      @default("ABIERTA")
  abierta_por BigInt
  cerrada_por BigInt?
  cerrada_en  DateTime?   @db.Timestamptz

  cobros        Cobro[]
  movimientos   MovimientoCaja[]
  liquidaciones Liquidacion[]
  cierre        CierreCaja?
  conteos       ConteoCierre[]

  @@map("caja")
}

model Cobro {
  id               BigInt      @id @default(autoincrement())
  pedido_id        BigInt      @unique
  caja_id          BigInt
  total            Decimal     @db.Decimal(12, 2)
  credito_personal Boolean     @default(false)
  cobrado_por      BigInt
  en               DateTime    @default(now()) @db.Timestamptz
  anulado_en       DateTime?   @db.Timestamptz
  anulado_por      BigInt?
  motivo_anulacion String?

  pedido           Pedido      @relation(fields: [pedido_id], references: [id])
  caja             Caja        @relation(fields: [caja_id], references: [id])
  pagos            CobroPago[]

  @@map("cobro")
}

model CobroPago {
  id       BigInt   @id @default(autoincrement())
  cobro_id BigInt
  medio    String
  monto    Decimal  @db.Decimal(12, 2)
  recibido Decimal? @db.Decimal(12, 2)
  vuelto   Decimal? @db.Decimal(12, 2)

  cobro    Cobro    @relation(fields: [cobro_id], references: [id])

  @@map("cobro_pago")
}

model MovimientoCaja {
  id               BigInt    @id @default(autoincrement())
  caja_id          BigInt
  tipo             String
  monto            Decimal   @db.Decimal(12, 2)
  motivo           String
  anulado_en       DateTime? @db.Timestamptz
  motivo_anulacion String?

  caja             Caja      @relation(fields: [caja_id], references: [id])

  @@map("movimiento_caja")
}

model Liquidacion {
  id                  BigInt   @id @default(autoincrement())
  caja_id             BigInt
  repartidor_party_id BigInt
  esperado            Decimal  @db.Decimal(12, 2)
  entregado           Decimal  @db.Decimal(12, 2)
  en                  DateTime @default(now()) @db.Timestamptz

  caja                Caja     @relation(fields: [caja_id], references: [id])
  repartidor          Party    @relation("LiquidacionesRepartidor", fields: [repartidor_party_id], references: [id])

  @@map("liquidacion")
}

model CierreCaja {
  caja_id      BigInt        @id
  conteo       Json
  resultado    String
  aprobado_por BigInt?
  nota         String?

  caja         Caja          @relation(fields: [caja_id], references: [id])
  medios       CierreMedio[]

  @@map("cierre_caja")
}

model ConteoCierre {
  caja_id   BigInt
  intento   Int      @db.SmallInt
  conteo    Json
  medios    Json
  resultado String
  por       BigInt
  en        DateTime @default(now()) @db.Timestamptz

  caja      Caja     @relation(fields: [caja_id], references: [id])

  @@id([caja_id, intento])
  @@map("conteo_cierre")
}

model CierreMedio {
  caja_id    BigInt
  medio      String
  sistema    Decimal    @db.Decimal(12, 2)
  visto      Decimal    @db.Decimal(12, 2)
  diferencia Decimal?   @default(dbgenerated("(visto - sistema)")) @db.Decimal(12, 2)

  cierre     CierreCaja @relation(fields: [caja_id], references: [caja_id])

  @@id([caja_id, medio])
  @@map("cierre_medio")
}

model IncidenteEntrega {
  id              BigInt    @id @default(autoincrement())
  pedido_id       BigInt
  motivo          String
  intento         Int
  en              DateTime  @default(now()) @db.Timestamptz
  cierre          String?
  recargo         Decimal?  @db.Decimal(12, 2)
  cerrado_por     BigInt?
  contactos       Json      @default("[]")
  foto_archivo_id BigInt?

  pedido          Pedido    @relation(fields: [pedido_id], references: [id])
  foto_archivo    Archivo?  @relation(fields: [foto_archivo_id], references: [id])

  @@map("incidente_entrega")
}

model MensajeReparto {
  pedido_id     BigInt
  numero        Int       @db.SmallInt
  enviado_en    DateTime  @default(now()) @db.Timestamptz
  respondido_en DateTime? @db.Timestamptz
  estado        String    @default("ENVIADO")

  pedido        Pedido    @relation(fields: [pedido_id], references: [id])

  @@id([pedido_id, numero])
  @@map("mensaje_reparto")
}

// ---------- Ola 5: cocina por áreas, stock y recetas (FT-COC-01..03, FT-STK-01..03) ----------

model ComandaArea {
  pedido_id     BigInt
  area_id       BigInt
  estado        String    @default("EN_COCINA") // EN_COCINA | DESPEJADA
  llego_en      DateTime  @default(now()) @db.Timestamptz
  despejada_en  DateTime? @db.Timestamptz
  despejada_por BigInt?
  devuelta_en   DateTime? @db.Timestamptz
  devuelta_por  BigInt?

  pedido Pedido     @relation(fields: [pedido_id], references: [id])
  area   AreaCocina @relation(fields: [area_id], references: [id])

  @@id([pedido_id, area_id])
  @@map("comanda_area")
}

model Agotado {
  id            BigInt    @id @default(autoincrement())
  producto_id   BigInt?
  opcion_id     BigInt?
  sabor_id      BigInt?
  tipo          String?   // PRODUCTO | SABOR | OPCION
  alcance       String    // HOY | HASTA_REACTIVAR | INDEFINIDO
  desde         DateTime  @default(now()) @db.Timestamptz
  hasta         DateTime? @db.Timestamptz
  reactivado_en DateTime? @db.Timestamptz
  por           BigInt

  producto Producto? @relation(fields: [producto_id], references: [id])
  opcion   Opcion?   @relation(fields: [opcion_id], references: [id])
  sabor    Sabor?    @relation(fields: [sabor_id], references: [id])

  @@map("agotado")
}

model AltaDemanda {
  id      BigInt      @id @default(autoincrement())
  minutos Int
  pausa   Boolean     @default(false)
  desde   DateTime    @default(now()) @db.Timestamptz
  hasta   DateTime?   @db.Timestamptz
  por     BigInt
  area_id BigInt?

  area AreaCocina? @relation(fields: [area_id], references: [id])

  @@map("alta_demanda")
}

model LugarStock {
  id             BigInt            @id @default(autoincrement())
  nombre         String            @unique
  tipo           String            // ALMACEN | AREA
  area_id        BigInt?
  area           AreaCocina?       @relation(fields: [area_id], references: [id])
  insumosConsumo Insumo[]          @relation("InsumoLugarConsumo")
  stocks         Stock[]
  movimientos    MovimientoStock[]

  @@map("lugar_stock")
}

model Insumo {
  id               BigInt            @id @default(autoincrement())
  nombre           String            @unique
  unidad_compra    String
  unidad_almacen   String
  unidad_receta    String
  factor_compra    Decimal           @db.Decimal(14, 3)
  factor_receta    Decimal           @db.Decimal(14, 6)
  minimo           Decimal           @db.Decimal(14, 3)
  intermedio       Decimal?          @db.Decimal(14, 3)
  maximo           Decimal           @db.Decimal(14, 3)
  lugar_consumo_id BigInt?
  costo_unit       Decimal?          @db.Decimal(12, 4)
  proveedor_a      BigInt?
  proveedor_b      BigInt?
  proveedor_c      BigInt?
  activo           Boolean           @default(true)

  lugarConsumo     LugarStock?       @relation("InsumoLugarConsumo", fields: [lugar_consumo_id], references: [id])
  stocks           Stock[]
  movimientos      MovimientoStock[]
  recetaLineas     RecetaLinea[]
  ajustesOpcion    AjusteOpcion[]    @relation("AjusteInsumo")
  ajustesReemplaza AjusteOpcion[]    @relation("AjusteReemplazaInsumo")

  @@map("insumo")
}

model Stock {
  id          BigInt      @id @default(autoincrement())
  insumo_id   BigInt?
  producto_id BigInt?
  lugar_id    BigInt
  cantidad    Decimal     @db.Decimal(14, 3)

  insumo      Insumo?     @relation(fields: [insumo_id], references: [id])
  producto    Producto?   @relation(fields: [producto_id], references: [id])
  lugar       LugarStock  @relation(fields: [lugar_id], references: [id])

  @@map("stock")
}

model MovimientoStock {
  id                    BigInt            @id @default(autoincrement())
  tipo                  String            // ENTRADA | SALIDA | AJUSTE | MERMA | DEVOLUCION | VENTA | PRODUCCION_CONSUMO | PRODUCCION_ALTA | TRASLADO_SALIDA | TRASLADO_ENTRADA | DIFERENCIA_CONTEO | ANULACION
  insumo_id             BigInt?
  producto_id           BigInt?
  lugar_id              BigInt
  cantidad              Decimal           @db.Decimal(14, 3)
  origen_valor_id       BigInt?
  destino_valor_id      BigInt?
  pedido_id             BigInt?
  produccion_id         BigInt?
  traslado_id           BigInt?
  compra_id             BigInt?
  nota                  String?
  movimiento_anulado_id BigInt?
  por                   BigInt
  en                    DateTime          @default(now()) @db.Timestamptz

  insumo                Insumo?           @relation(fields: [insumo_id], references: [id])
  producto              Producto?         @relation(fields: [producto_id], references: [id])
  lugar                 LugarStock        @relation(fields: [lugar_id], references: [id])
  origen_valor          ListaValor?       @relation("MovimientoStockOrigen", fields: [origen_valor_id], references: [id])
  destino_valor         ListaValor?       @relation("MovimientoStockDestino", fields: [destino_valor_id], references: [id])
  pedido                Pedido?           @relation(fields: [pedido_id], references: [id])
  movimientoAnulado     MovimientoStock?  @relation("MovimientosAnulados", fields: [movimiento_anulado_id], references: [id])
  movimientosRevertidos MovimientoStock[] @relation("MovimientosAnulados")

  @@map("movimiento_stock")
}

model Receta {
  id              BigInt        @id @default(autoincrement())
  producto_id     BigInt
  tamano_valor_id BigInt?
  es_produccion   Boolean       @default(false)
  rinde           Decimal?      @db.Decimal(14, 3)

  producto        Producto      @relation(fields: [producto_id], references: [id])
  tamano_valor    ListaValor?   @relation(fields: [tamano_valor_id], references: [id])
  lineas          RecetaLinea[]

  @@unique([producto_id, tamano_valor_id, es_produccion])
  @@map("receta")
}

model RecetaLinea {
  receta_id          BigInt
  insumo_id          BigInt
  cantidad           Decimal         @db.Decimal(14, 3)
  producto_tamano_id BigInt?

  receta             Receta          @relation(fields: [receta_id], references: [id])
  insumo             Insumo          @relation(fields: [insumo_id], references: [id])
  productoTamano     ProductoTamano? @relation(fields: [producto_tamano_id], references: [id])

  @@id([receta_id, insumo_id])
  @@map("receta_linea")
}

model AjusteOpcion {
  opcion_id           BigInt
  insumo_id           BigInt
  efecto              String          // SUMA | QUITA | REEMPLAZA
  reemplaza_insumo_id BigInt?
  cantidad            Decimal?        @db.Decimal(14, 3)

  opcion              Opcion          @relation(fields: [opcion_id], references: [id])
  insumo              Insumo          @relation("AjusteInsumo", fields: [insumo_id], references: [id])
  reemplazaInsumo     Insumo?         @relation("AjusteReemplazaInsumo", fields: [reemplaza_insumo_id], references: [id])

  @@id([opcion_id, insumo_id])
  @@map("ajuste_opcion")
}

// ---------- Ola 6: salón, plano, mesas y reservas (FT-SAL-01..03) ----------

model Piso {
  id               BigInt          @id @default(autoincrement())
  nombre           String
  activo           Boolean         @default(true)
  cuadricula_ancho Int
  cuadricula_alto  Int
  elementos        ElementoPlano[]

  @@map("piso")
}

model ElementoPlano {
  id           BigInt        @id @default(autoincrement())
  piso_id      BigInt
  tipo         String
  nombre       String?
  x            Int
  y            Int
  ancho        Int
  alto         Int
  numero       Int?
  asientos     Int?
  activo       Boolean       @default(true)

  piso         Piso          @relation(fields: [piso_id], references: [id])
  pedidosMesa  PedidoMesa[]
  reservasMesa ReservaMesa[]

  @@map("elemento_plano")
}

model Reserva {
  id                 BigInt        @id @default(autoincrement())
  nombre             String
  telefono           String
  personas           Int
  hora               DateTime      @db.Timestamptz
  tolerancia_min     Int
  estado             String        @default("ACTIVA")
  motivo_cancelacion String?
  pedido_id          BigInt?

  pedido             Pedido?       @relation(fields: [pedido_id], references: [id])
  mesas              ReservaMesa[]

  @@map("reserva")
}

model ReservaMesa {
  id         BigInt         @id @default(autoincrement())
  reserva_id BigInt
  mesa_id    BigInt?

  reserva    Reserva        @relation(fields: [reserva_id], references: [id], onDelete: Cascade)
  mesa       ElementoPlano? @relation(fields: [mesa_id], references: [id], onDelete: SetNull)

  @@map("reserva_mesa")
}

model PedidoMesa {
  id          BigInt         @id @default(autoincrement())
  pedido_id   BigInt
  mesa_id     BigInt?
  mesa_nombre String?
  abierta     Boolean        @default(true)

  pedido      Pedido         @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  mesa        ElementoPlano? @relation(fields: [mesa_id], references: [id], onDelete: SetNull)

  @@map("pedido_mesa")
}

// ---------- Ola 7: comprobantes y obligaciones legales (FT-LEG-01, FT-LEG-02) ----------

model Comprobante {
  id                 BigInt    @id @default(autoincrement())
  pedido_id          BigInt    @unique
  tipo               String    // NOTA_VENTA | BOLETA | FACTURA
  serie              String
  numero             Int
  numero_texto       String    @unique
  documento          String?
  razon_social       String?
  emision            String    @default("POR_EMITIR") // INTERNA | POR_EMITIR | EMITIDO
  emitido_en         DateTime? @db.Timestamptz
  emitido_por        BigInt?
  referencia_externa String?
  copias_impresas    Int       @default(0)
  creado_en          DateTime  @default(now()) @db.Timestamptz

  pedido             Pedido    @relation(fields: [pedido_id], references: [id])
  emitidoPor         Party?    @relation("ComprobantesEmitidos", fields: [emitido_por], references: [id])

  @@unique([serie, numero])
  @@map("comprobante")
}

model SecuenciaComprobante {
  serie         String @id
  ultimo_numero Int    @default(0)

  @@map("secuencia_comprobante")
}

model Reclamo {
  id                    BigInt    @id @default(autoincrement())
  numero                String    @unique
  tipo                  String    // RECLAMO | QUEJA
  nombre                String
  documento             String
  domicilio             String
  telefono              String
  correo                String?
  pedido_id             BigInt?
  detalle               String
  monto_reclamado       Decimal?  @db.Decimal(12, 2)
  estado                String    @default("RECIBIDO") // RECIBIDO | EN_REVISION | RESPONDIDO
  respuesta             String?
  respondido_por        BigInt?
  respondido_en         DateTime? @db.Timestamptz
  fecha_limite          DateTime  @db.Date
  aceptacion_privacidad Boolean   @default(true)
  aceptado_en           DateTime  @default(now()) @db.Timestamptz
  creado_en             DateTime  @default(now()) @db.Timestamptz

  pedido                Pedido?   @relation(fields: [pedido_id], references: [id])
  respondidoPor         Party?    @relation("ReclamosRespondidos", fields: [respondido_por], references: [id])

  @@map("reclamo")
}






