model VoucherPago {
  id              BigInt        @id @default(autoincrement())
  pedido_id       BigInt?
  conversacion_id BigInt?
  mensaje_id      BigInt?
  archivo_id      BigInt
  origen          String        // MOZO | WHATSAPP | CAJA
  medio           String?       // YAPE | PLIN
  subido_por      BigInt?
  hash_imagen     String?
  operacion       String?
  extraido        Json?
  semaforo        String        // CONFIABLE | OBSERVADO | RARO | ILEGIBLE | SIN_LECTURA
  motivos         String[]
  revisado_en     DateTime?     @db.Timestamptz
  revisado_por    BigInt?
  creado_en       DateTime      @default(now()) @db.Timestamptz
  // Reemplazo sin borrar: reemplazado_en NULL = vigente. reemplaza_a apunta al voucher que sustituye.
  reemplazado_en  DateTime?     @db.Timestamptz
  reemplazado_por BigInt?
  motivo_cambio   String?
  reemplaza_a     BigInt?
  // Retirado: quitado por el mozo o Caja (reemplazado_en también queda marcado, así no es vigente)
  retirado        Boolean       @default(false)

  pedido          Pedido?       @relation(fields: [pedido_id], references: [id], onDelete: SetNull)
  archivo         Archivo       @relation(fields: [archivo_id], references: [id])
  conversacion    Conversacion? @relation(fields: [conversacion_id], references: [id], onDelete: SetNull)
  reemplazadoPor  Party?        @relation("VoucherReemplazadoPor", fields: [reemplazado_por], references: [id], onDelete: SetNull)
  reemplazaA      VoucherPago?  @relation("VoucherReemplazo", fields: [reemplaza_a], references: [id], onDelete: SetNull)
  reemplazos      VoucherPago[] @relation("VoucherReemplazo")

  @@index([pedido_id])
  @@index([conversacion_id])
  @@index([operacion])
  @@index([creado_en])
  @@index([hash_imagen])
  @@index([reemplazado_en])
  @@map("voucher_pago")
}

