  telefono_hash        String
  tipo                 String        // TEXTO | BOTON | PLANTILLA | IMAGEN | INTERACTIVO | SISTEMA
  plantilla            String?
  estado               String        @default("ENCOLADO") // ENCOLADO | ENVIADO | ENTREGADO | LEIDO | FALLIDO | SIMULADO
  error_codigo         String?
  error_detalle        String?
  pedido_id            BigInt?
  conversacion_id      BigInt?
  creado_en            DateTime      @default(now()) @db.Timestamptz
  actualizado_en       DateTime      @updatedAt @db.Timestamptz

  pedido               Pedido?       @relation(fields: [pedido_id], references: [id])
  conversacion         Conversacion? @relation(fields: [conversacion_id], references: [id])
  mensajesChat         MensajeChat[]

  @@index([telefono_hash])
  @@index([creado_en])
  @@index([pedido_id])
  @@map("whatsapp_mensaje")
}

model ClienteWhatsappConsentimiento {
  id            BigInt   @id @default(autoincrement())
  telefono_hash String   @unique
  acepta        Boolean  @default(true)
  origen        String   @default("WEBHOOK_BAJA") // WEBHOOK_BAJA | WEBHOOK_ALTA | MANUAL
  en            DateTime @default(now()) @db.Timestamptz

  @@map("cliente_whatsapp_consentimiento")
}

model EncuestaPosventa {
  id            BigInt    @id @default(autoincrement())
  pedido_id     BigInt    @unique
  enviada_en    DateTime  @default(now()) @db.Timestamptz
  respondida_en DateTime? @db.Timestamptz
  puntaje       Int?      @db.SmallInt
  comentario    String?
  estado        String    @default("ENVIADA") // ENVIADA | RESPONDIDA | EXPIRADA | SIMULADA
  creado_en     DateTime  @default(now()) @db.Timestamptz
  actualizado_en DateTime @updatedAt @db.Timestamptz

  pedido        Pedido    @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@map("encuesta_posventa")
}

model QuejaWhatsapp {
  id            BigInt    @id @default(autoincrement())
  origen        String    @default("ENCUESTA") // ENCUESTA | CHAT
  pedido_id     BigInt?
  cliente       String
  telefono_hash String?
  puntaje       Int?      @db.SmallInt
  texto         String
  estado        String    @default("NUEVA") // NUEVA | EN_REVISION | RESUELTA
  atendida_por  String?
  resolucion    String?
  creada_en     DateTime  @default(now()) @db.Timestamptz
  actualizada_en DateTime @updatedAt @db.Timestamptz

  pedido        Pedido?   @relation(fields: [pedido_id], references: [id])

  @@index([estado])
  @@index([pedido_id])
  @@map("queja_whatsapp")
}

model IaConsumo {
  id                  BigInt        @id @default(autoincrement())
  fecha               DateTime      @default(now()) @db.Timestamptz
  conversacion_id     BigInt?
  modelo              String        @db.VarChar(100)
  tokens_entrada      Int           @default(0)
  tokens_salida       Int           @default(0)
  costo_usd_estimado  Decimal       @default(0) @db.Decimal(10, 6)
  herramientas_usadas Json?
  resultado           String        @db.VarChar(50)
  origen              String        @default("CHATBOT") @db.VarChar(50)

  conversacion        Conversacion? @relation(fields: [conversacion_id], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([conversacion_id])
  @@index([origen])
  @@map("ia_consumo")
}

model VoucherPago {
  id              BigInt        @id @default(autoincrement())
  pedido_id       BigInt?
  conversacion_id BigInt?
  mensaje_id      BigInt?
  archivo_id      BigInt
  origen          String        // MOZO | WHATSAPP | CAJA
  medio           String?       // YAPE | PLIN
  subido_por      BigInt?
  hash_imagen     String?
  operacion       String?
  extraido        Json?
  semaforo        String        // CONFIABLE | OBSERVADO | RARO | ILEGIBLE | SIN_LECTURA
  motivos         String[]
  revisado_en     DateTime?     @db.Timestamptz
  revisado_por    BigInt?
  creado_en       DateTime      @default(now()) @db.Timestamptz
  // Reemplazo sin borrar: reemplazado_en NULL = vigente. reemplaza_a apunta al voucher que sustituye.
  reemplazado_en  DateTime?     @db.Timestamptz
  reemplazado_por BigInt?
  motivo_cambio   String?
  reemplaza_a     BigInt?
  // Retirado: quitado por el mozo o Caja (reemplazado_en también queda marcado, así no es vigente)
  retirado        Boolean       @default(false)

  pedido          Pedido?       @relation(fields: [pedido_id], references: [id], onDelete: SetNull)
  archivo         Archivo       @relation(fields: [archivo_id], references: [id])
  conversacion    Conversacion? @relation(fields: [conversacion_id], references: [id], onDelete: SetNull)
  reemplazadoPor  Party?        @relation("VoucherReemplazadoPor", fields: [reemplazado_por], references: [id], onDelete: SetNull)
  reemplazaA      VoucherPago?  @relation("VoucherReemplazo", fields: [reemplaza_a], references: [id], onDelete: SetNull)
  reemplazos      VoucherPago[] @relation("VoucherReemplazo")

  @@index([pedido_id])
  @@index([conversacion_id])
  @@index([operacion])
  @@index([creado_en])
  @@index([hash_imagen])
  @@index([reemplazado_en])
  @@map("voucher_pago")
}

/// Plan de pago declarado al hacer el pedido (pago dividido). Un renglon por medio.
/// La suma de montos debe ser igual al total del pedido (lo valida el servicio).
model PedidoPagoPlan {
  id        BigInt  @id @default(autoincrement())
  pedido_id BigInt
  medio     String  // EFECTIVO | YAPE | PLIN | TARJETA | TRANSFERENCIA (CHECK en la BD)
  monto     Decimal @db.Decimal(12, 2)
  orden     Int     @default(0)

  pedido    Pedido  @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@index([pedido_id])
  @@map("pedido_pago_plan")
}

// Reseñas de Google Maps que se muestran en la carta (las trae el servicio de reseñas; visible lo decide el admin)
model ResenaGoogle {
  id               BigInt    @id @default(autoincrement())
  google_review_id String    @unique
  autor_nombre     String
  autor_foto_url   String?
  autor_enlace     String?
  calificacion     Int
  texto            String
  idioma           String?
  publicada_en     DateTime? @db.Timestamptz
  enlace_resena    String?
  visible          Boolean   @default(true)
  creado_en        DateTime  @default(now()) @db.Timestamptz
  actualizado_en   DateTime  @updatedAt

  @@map("resena_google")
}
