/// Cortesía: venta con costo 0 (no es merma). Dentro de un pedido (pedido_id + pedido_linea_id) o por separado
/// (pedido_id null; pedido_referencia_id = pedido al que corresponde).
model Cortesia {
  id                    BigInt    @id @default(autoincrement())
  producto_id           BigInt
  sabor_id              BigInt?
  cantidad              Int
  valor_lista           Decimal   @db.Decimal(12, 2)
  motivo                String
  nota                  String?
  pedido_id             BigInt?
  pedido_linea_id       BigInt?   @unique
  pedido_referencia_id  BigInt?
  dada_por_party_id     BigInt
  autorizada_por_party_id BigInt?
  creado_en             DateTime  @default(now()) @db.Timestamptz
  producto              Producto  @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  sabor                 Sabor?    @relation(fields: [sabor_id], references: [id], onDelete: Restrict)
  pedido                Pedido?   @relation("CortesiaPedido", fields: [pedido_id], references: [id], onDelete: Restrict)
  pedidoReferencia      Pedido?   @relation("CortesiaReferencia", fields: [pedido_referencia_id], references: [id], onDelete: Restrict)
  pedidoLinea           PedidoLinea? @relation(fields: [pedido_linea_id], references: [id], onDelete: Restrict)
  dadaPor               Party     @relation("CortesiaDadaPor", fields: [dada_por_party_id], references: [id], onDelete: Restrict)
  autorizadaPor         Party?    @relation("CortesiaAutorizadaPor", fields: [autorizada_por_party_id], references: [id], onDelete: Restrict)

  @@index([creado_en])
  @@index([producto_id])
  @@index([pedido_id])
  @@index([pedido_referencia_id])
  @@map("cortesia")
}

// ---------------------------------------------------------------------------
// Control de asistencia del personal (QR en pantalla del local + GPS + selfie).
// Las marcas son append-only: las correcciones son filas nuevas (origen = CORRECCION).
// Unicidad en BD (migración 20261231200000_asistencia): una marca CELULAR por persona,
// jornada y tipo (índice único parcial, no expresable aquí).
model AsistenciaMarca {
  id               BigInt    @id @default(autoincrement())
  party_id         BigInt
  jornada          DateTime  @db.Date // día laboral (Lima; antes de las 04:00 cuenta como el día anterior)
  tipo             String    @db.VarChar(20) // ENTRADA | SALIDA_ALMUERZO | ENTRADA_ALMUERZO | SALIDA
  origen           String    @default("CELULAR") @db.VarChar(12) // CELULAR | CORRECCION
  momento          DateTime  @db.Timestamptz // hora del servidor
  estado           String    @default("VALIDA") @db.VarChar(12) // VALIDA | A_REVISAR
  motivos_revision String?
  lat              Decimal?  @db.Decimal(9, 6)
  lng              Decimal?  @db.Decimal(9, 6)
  precision_m     Decimal?  @db.Decimal(8, 2)
  distancia_m     Decimal?  @db.Decimal(8, 2)
  qr_slot          BigInt?
  dispositivo_hash String?   @db.VarChar(64)
  motivo           String?   // solo correcciones: motivo obligatorio
  por_party_id     BigInt?   // solo correcciones: quién la hizo
  creado_en        DateTime  @default(now()) @db.Timestamptz

  party            Party                @relation("AsistenciaMarcaParty", fields: [party_id], references: [id])
  corregidaPor    Party?               @relation("AsistenciaMarcaCorrigio", fields: [por_party_id], references: [id])
  selfie           AsistenciaSelfie?

  @@unique([party_id, qr_slot])
  @@index([party_id, jornada])
  @@map("asistencia_marca")
}

model AsistenciaSelfie {
  marca_id   BigInt   @id
  contenido  Bytes    @db.ByteA
  mime       String   @db.VarChar(30)
  creado_en  DateTime @default(now()) @db.Timestamptz

  marca      AsistenciaMarca @relation(fields: [marca_id], references: [id])

  @@map("asistencia_selfie")
}

model AsistenciaDispositivo {
  party_id      BigInt    @id
  huella_hash   String    @db.VarChar(64)
  vinculado_en  DateTime  @default(now()) @db.Timestamptz
  ultimo_uso_en DateTime? @db.Timestamptz

  party         Party     @relation(fields: [party_id], references: [id])

  @@map("asistencia_dispositivo")
}

model AsistenciaConsentimiento {
  party_id    BigInt   @id
  version     String   @db.VarChar(20)
  aceptado_en DateTime @db.Timestamptz

  party       Party    @relation(fields: [party_id], references: [id])

  @@map("asistencia_consentimiento")
}

// ---------------------------------------------------------------------------
// Reparto mensual de propinas por horas trabajadas (migración 20261231600000_reparto_propinas).
// Un reparto VIGENTE (no anulado) por mes: índice único parcial en la migración. BORRADOR se recalcula;
// APROBADO congela las cifras; PAGADO cuando todas las personas tienen fecha de pago; ANULADO con motivo.
model PropinaReparto {
  id               BigInt    @id @default(autoincrement())
  anio             Int       @db.SmallInt
  mes              Int       @db.SmallInt
  estado           String    @default("BORRADOR") @db.VarChar(12) // BORRADOR | APROBADO | PAGADO | ANULADO
  total_propinas   Decimal   @db.Decimal(12, 2)
  total_horas      Decimal   @db.Decimal(10, 2)
  calculado_en     DateTime  @db.Timestamptz
  calculado_por    BigInt
  aprobado_en      DateTime? @db.Timestamptz
  aprobado_por     BigInt?
  pagado_en        DateTime? @db.Timestamptz
  pagado_por       BigInt?
  anulado_en       DateTime? @db.Timestamptz
  anulado_por      BigInt?
  motivo_anulacion String?
  nota             String?

  calculadoPor Party                   @relation("PropinaRepartoCalculo", fields: [calculado_por], references: [id])
  aprobadoPor  Party?                  @relation("PropinaRepartoAprobo", fields: [aprobado_por], references: [id])
  pagadoPor    Party?                  @relation("PropinaRepartoPago", fields: [pagado_por], references: [id])
  anuladoPor   Party?                  @relation("PropinaRepartoAnulo", fields: [anulado_por], references: [id])
  detalle      PropinaRepartoDetalle[]

  @@index([anio, mes])
  @@map("propina_reparto")
}

/// Parte de cada persona en un reparto. Solo personas con horas > 0. monto en soles (2 decimales).
model PropinaRepartoDetalle {
  reparto_id      BigInt
  party_id        BigInt
  horas           Decimal   @db.Decimal(10, 2)
  porcentaje      Decimal   @db.Decimal(9, 4)
  monto           Decimal   @db.Decimal(12, 2)
  ajuste_centimos Int?      // reservado: ajuste manual futuro; sin uso en esta fase
  pagado_en       DateTime? @db.Timestamptz
  pagado_medio    String?   @db.VarChar(20)
  nota            String?

  reparto PropinaReparto @relation(fields: [reparto_id], references: [id])
  party   Party          @relation("PropinaRepartoDetalleParty", fields: [party_id], references: [id])

  @@id([reparto_id, party_id])
  @@map("propina_reparto_detalle")
}
