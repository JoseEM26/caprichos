  total_nuevo             Decimal?        @db.Decimal(12, 2)
  diferencia_envio        Decimal?        @db.Decimal(12, 2)
  ajuste_tipo             String?
  ajuste_monto            Decimal?        @db.Decimal(12, 2)
  ajuste_estado           String?
  ajuste_medio            String?
  ajuste_codigo_operacion String?
  ajuste_por_party_id     BigInt?
  ajuste_en               DateTime?       @db.Timestamptz
  ajuste_movimiento_caja_id BigInt?
