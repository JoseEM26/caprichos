/// Solicitud de cambio de forma de pago en la puerta (el delivery solicita, Caja valida). Historial inmutable:
/// solo una PENDIENTE por pedido (índice único parcial) y una fila resuelta no se edita ni se borra (trigger).
/// Ver migración 20270104100000_cambio_cobro_delivery.
model SolicitudCambioCobro {
  id                      BigInt    @id @default(autoincrement())
  pedido_id               BigInt
  solicitado_por_party_id BigInt
  solicitado_en           DateTime  @default(now()) @db.Timestamptz
  /// PENDIENTE | APROBADA | RECHAZADA | AUTORIZADA_SIN_VALIDAR (CHECK en la BD)
  estado                  String    @default("PENDIENTE")
  /// [{medio, monto}] que tenía el pedido al solicitar
  plan_original           Json
  /// [{medio, monto}] que pide el repartidor (suma = total cobrable)
  plan_solicitado         Json
  /// Efectivo con el que pagará el cliente (para el vuelto); null si no hay efectivo
  paga_con                Decimal?  @db.Decimal(12, 2)
  /// Capturas (voucher_pago.id) subidas con la solicitud
  voucher_ids             BigInt[]
  /// Motivo de Caja (obligatorio al autorizar sin validar; opcional al rechazar)
  motivo                  String?
  resuelto_por_party_id   BigInt?
  resuelto_en             DateTime? @db.Timestamptz

  pedido        Pedido @relation(fields: [pedido_id], references: [id], onDelete: Restrict)
  solicitadoPor Party  @relation("CambioCobroSolicitado", fields: [solicitado_por_party_id], references: [id])
  resueltoPor   Party? @relation("CambioCobroResuelto", fields: [resuelto_por_party_id], references: [id], onDelete: SetNull)

  @@index([pedido_id])
  @@index([estado])
  @@map("solicitud_cambio_cobro")
}

