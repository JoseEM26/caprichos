datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Schema mínimo para inicializar el cliente de Prisma sin tablas de negocio (HU-CAP-178)
model ControlSistema {
  id             String   @id @default(uuid())
  clave          String   @unique
  valor          String
  actualizado_en DateTime @updatedAt

  @@map("sys_control")
}

// ---------- Ola 1: personas, acceso, auditoría y configuración (ADR-004, ADR-008, ADR-014) ----------

model Party {
  cortesiasDadas       Cortesia[] @relation("CortesiaDadaPor")
  cortesiasAutorizadas Cortesia[] @relation("CortesiaAutorizadaPor")
  id                       BigInt                 @id @default(autoincrement())
  tipo                     String // PERSONA | ORGANIZACION
  estado                   String                 @default("ACTIVO")
  creado_en                DateTime               @default(now()) @db.Timestamptz
  persona                  Person?
  documentos               PartyIdentifier[]
  usuario                  UserAccount?
  sesiones                 Sesion[]
  preferencias             PreferenciaUsuario[]
  vouchersReemplazadosPor  VoucherPago[]          @relation("VoucherReemplazadoPor")
  pedidos                  Pedido[]               @relation("ClientePedido")
  pedidosRepartidos        Pedido[]               @relation("RepartidorPedido")
  rutasReparto             RutaReparto[]          @relation("RepartidorRuta")
  liquidaciones            Liquidacion[]          @relation("LiquidacionesRepartidor")
  comprobantesEmitidos     Comprobante[]          @relation("ComprobantesEmitidos")
  reclamosRespondidos      Reclamo[]              @relation("ReclamosRespondidos")
  cuentaCliente            CustomerAccount?
  roles                    PartyRole[]
  consentimientos          Consent[]
  contactos                ContactMechanism[]
  movimientosPuntos        MovimientoPuntos[]
  canjesCuponesCompartidos CuponCanjeCompartido[]
  organizacion             Organization?
  horariosTrabajo          HorarioTrabajo[]
  coberturasCubre          CoberturaTurno[]       @relation("CoberturasCubre")
  coberturasReemplaza      CoberturaTurno[]       @relation("CoberturasReemplaza")
  reemplazosDia            ReemplazoDia[]         @relation("ReemplazoDiaTitular")
  reemplazaDias            ReemplazoDia[]         @relation("ReemplazoDiaSuplente")
  asistenciaMarcas         AsistenciaMarca[]     @relation("AsistenciaMarcaParty")
  asistenciaCorregidas     AsistenciaMarca[]     @relation("AsistenciaMarcaCorrigio")
  asistenciaDispositivo    AsistenciaDispositivo?
  asistenciaConsentimiento AsistenciaConsentimiento?
  pedidosProveedor         PedidoProveedor[]
  comprasProveedor         Compra[]
  pedidosInternosAvisados  PedidoInterno[]
  consumosPersonal         ConsumoPersonal[]
  conversaciones           Conversacion[]
  notificaciones           Notificacion[]
  dataRequests             DataRequest[]
  pedidosComoCliente       Pedido[]              @relation("ClienteIdentificadoPedido")
  direccionesCliente       ClienteDireccion[]
  ajustesMedioPor          CierreAjusteMedio[]   @relation("AjusteMedioPor")
  ajustesMedioAutorizados  CierreAjusteMedio[]   @relation("AjusteMedioAutorizado")
  devolucionesPor          DevolucionPedido[]    @relation("DevolucionPor")
  devolucionesAutorizadas  DevolucionPedido[]    @relation("DevolucionAutorizada")
  cambiosUbicacionPropuestos PedidoCambioUbicacion[] @relation("CambioUbicacionPropuesto")
  cambiosUbicacionResueltos  PedidoCambioUbicacion[] @relation("CambioUbicacionResuelto")
  cambiosUbicacionAjustes    PedidoCambioUbicacion[] @relation("CambioUbicacionAjuste")
  cambiosCobroSolicitados    SolicitudCambioCobro[]  @relation("CambioCobroSolicitado")
  cambiosCobroResueltos      SolicitudCambioCobro[]  @relation("CambioCobroResuelto")
  propinaRepartosCalculados  PropinaReparto[]       @relation("PropinaRepartoCalculo")
  propinaRepartosAprobados   PropinaReparto[]       @relation("PropinaRepartoAprobo")
  propinaRepartosPagados     PropinaReparto[]       @relation("PropinaRepartoPago")
  propinaRepartosAnulados    PropinaReparto[]       @relation("PropinaRepartoAnulo")
  propinaRepartoDetalles     PropinaRepartoDetalle[] @relation("PropinaRepartoDetalleParty")

  @@map("party")
}

model Person {
  party_id        BigInt    @id
  nombres         String
  apellidos       String?
  cumple_dia      Int?      @db.SmallInt
  cumple_mes      Int?      @db.SmallInt
  correo          String?
  foto_archivo_id BigInt?
  pais_nacimiento String?
  /// Disponible 24/7: recibe los avisos por correo si nadie con casilla está de turno.
  horario_24_7    Boolean   @default(false)
  /// Reparto de propinas: NULL = según rol (ADMIN no participa, el resto sí); true/false = excepción fijada por el ADMIN.
  participa_propinas Boolean?
  party           Party     @relation(fields: [party_id], references: [id])

  @@map("person")
}

model PartyIdentifier {
  id       BigInt @id @default(autoincrement())
  party_id BigInt
  tipo     String // DNI | RUC | CE | CEDULA | PASAPORTE
  numero   String
  party    Party  @relation(fields: [party_id], references: [id])

  @@unique([tipo, numero])
  @@map("party_identifier")
}

model Rol {
  codigo         String         @id
  nombre         String
  permisos       RolPermiso[]
  usuarios       UserAccount[]
  usuariosExtra  UserAccountRol[]
  historialRolesExtra UserAccountRolHistorial[]
  notificaciones Notificacion[]

  @@map("rol")
}

/// Roles adicionales de una cuenta. El rol principal sigue en user_account.rol.
model UserAccountRol {
  user_account_id BigInt
  rol             String
  /// Quién lo otorgó (party del ADMIN).
  otorgado_por    BigInt?
  otorgado_en     DateTime    @default(now()) @db.Timestamptz
  /// Hasta cuándo vale el rol. NULL = permanente (hasta que el ADMIN lo quite).
  vence_en        DateTime?   @db.Timestamptz
  motivo          String?
  cuenta          UserAccount @relation(fields: [user_account_id], references: [id])
  r               Rol         @relation(fields: [rol], references: [codigo])

  @@id([user_account_id, rol])
  @@index([vence_en], map: "ix_user_account_rol_vence")
  @@map("user_account_rol")
}

/// Historial permanente e inmutable de los roles extra: otorgado, retirado o vencido.
model UserAccountRolHistorial {
  id              BigInt      @id @default(autoincrement())
  user_account_id BigInt
  rol             String
  accion          String      // OTORGADO | RETIRADO | VENCIDO
  quien_party_id  BigInt?
  desde           DateTime?   @db.Timestamptz
  hasta           DateTime?   @db.Timestamptz
  motivo          String?
  en              DateTime    @default(now()) @db.Timestamptz
  cuenta          UserAccount @relation(fields: [user_account_id], references: [id])
  r               Rol         @relation(fields: [rol], references: [codigo])

  @@index([user_account_id, en], map: "ix_user_account_rol_historial_cuenta")
  @@map("user_account_rol_historial")
}

/// Áreas de cocina que atiende un usuario con rol COCINA. Sin filas = ve todas las áreas.
model UserAccountArea {
  user_account_id BigInt
  area_id         BigInt
  creado_en       DateTime   @default(now()) @db.Timestamptz
  cuenta          UserAccount @relation(fields: [user_account_id], references: [id])
  area            AreaCocina @relation(fields: [area_id], references: [id])

  @@id([user_account_id, area_id])
  @@index([area_id])
  @@map("user_account_area")
}

model Permiso {
  id     BigInt       @id @default(autoincrement())
  modulo String
  accion String
  roles  RolPermiso[]

  @@unique([modulo, accion])
  @@map("permiso")
}

model RolPermiso {
  rol        String
  permiso_id BigInt
  r          Rol     @relation(fields: [rol], references: [codigo])
  permiso    Permiso @relation(fields: [permiso_id], references: [id])

  @@id([rol, permiso_id])
  @@map("rol_permiso")
}

model UserAccount {
  id                    BigInt                 @id @default(autoincrement())
  party_id              BigInt                 @unique
  rol                   String
  hash                  String
  debe_cambiar          Boolean                @default(true)
  pin_hash              String?                // OBSOLETO: El PIN fijo se retiró en favor del código rotativo general (supervisor_secreto). Se mantiene por compatibilidad histórica sin uso.
  activo                Boolean                @default(true)
  alta_en               DateTime               @default(now()) @db.Date
  alertas_whatsapp              Boolean                @default(false)
  alertas_whatsapp_confirmado_en DateTime?              @db.Timestamptz
  /// Recibe los avisos del sistema al equipo por correo (dentro de su horario).
  avisos_correo         Boolean                @default(false)
  party                 Party                  @relation(fields: [party_id], references: [id])
  r                     Rol                    @relation(fields: [rol], references: [codigo])
  rolesExtra            UserAccountRol[]
  rolesHistorial        UserAccountRolHistorial[]
  areasCocina           UserAccountArea[]
  iniciativasCreadas    Iniciativa[]           @relation("IniciativasCreadas")
  iniciativasCambiadas  Iniciativa[]           @relation("IniciativasCambiadas")
  iniciativaComentarios IniciativaComentario[]
  conversacionesTomadas Conversacion[]

  @@map("user_account")
}

model Sesion {
  id           BigInt    @id @default(autoincrement())
  audiencia    String // ADMIN | CARTA
  party_id     BigInt
  refresh_hash String    @unique
  dispositivo  String?
  expira_en    DateTime  @db.Timestamptz
  revocada_en  DateTime? @db.Timestamptz
  party        Party     @relation(fields: [party_id], references: [id])

  @@map("sesion")
}

/// Preferencias personales de un usuario (una fila por party y clave). Solo para quien la fijó.
model PreferenciaUsuario {
  party_id       BigInt
  clave          String
  valor          Json
  actualizado_en DateTime @default(now()) @db.Timestamptz
  party          Party    @relation(fields: [party_id], references: [id])

  @@id([party_id, clave])
  @@map("preferencia_usuario")
}

model Parametro {
  clave String @id
  valor Json

  @@map("parametro")
}

/// Registro de correos de avisos al equipo. Una fila por caso y destinatario (clave única).
model CorreoEnvio {
  id           BigInt   @id @default(autoincrement())
  clave        String   @db.VarChar(160)
  destinatario String   @db.VarChar(160)
  origen       String   @db.VarChar(40)
  asunto       String   @db.VarChar(200)
  estado       String   @db.VarChar(20)
  proveedor_id String?  @db.VarChar(80)
  error        String?  @db.VarChar(200)
  creado_en    DateTime @default(now()) @db.Timestamptz

  @@unique([clave, destinatario])
  @@index([creado_en])
  @@map("correo_envio")
}

// Solo se inserta: los triggers de la migración encadenan el hash y bloquean update y delete.
model Auditoria {
  id            BigInt   @id @default(autoincrement())
  categoria     String // CAMBIO | ACCESO | LECTURA_SENSIBLE
  modulo        String
  accion        String
  resultado     String   @default("OK")
  entidad       String?
  entidad_id    BigInt?
  antes         Json?
  despues       Json?
  motivo        String?
  party_id      BigInt?
  con_pin_admin Boolean  @default(false)
  ip            String?  @db.Inet
  dispositivo   String?
  request_id    String?
  en            DateTime @default(now()) @db.Timestamptz
  hash_anterior Bytes?
  hash          Bytes    @default(dbgenerated("'\\x'::bytea"))

  @@index([en(sort: Desc), modulo, party_id], map: "ix_auditoria_busqueda")
  @@index([entidad, entidad_id], map: "ix_auditoria_entidad")
  @@map("auditoria")
}

// ---------- Ola 2: catálogo, local y archivos (FT-CAR-01, FT-CFG-01/02, ADR-012) ----------

model Lista {
  id      BigInt          @id @default(autoincrement())
  codigo  String          @unique
  nombre  String
  valores ListaValor[]
  grupos  GrupoOpciones[]

  @@map("lista")
}

model ListaValor {
  id              BigInt           @id @default(autoincrement())
  lista_id        BigInt
  nombre          String
  orden           Int              @default(0)
  activo          Boolean          @default(true)
  lista           Lista            @relation(fields: [lista_id], references: [id])
  productoTamanos ProductoTamano[]
  opciones        Opcion[]
  movimientosOrigen  MovimientoStock[] @relation("MovimientoStockOrigen")
  movimientosDestino MovimientoStock[] @relation("MovimientoStockDestino")
  recetas            Receta[]
  combosPrecio       ComboPrecio[]

  @@unique([lista_id, nombre])
  @@map("lista_valor")
}

model HorarioDia {
  dia_semana Int       @id @db.SmallInt
  abre       DateTime? @db.Time
  cierra     DateTime? @db.Time
  cerrado    Boolean   @default(false)

  @@map("horario_dia")
}

model FechaEspecial {
  fecha   DateTime  @id @db.Date
  cerrado Boolean
  abre    DateTime? @db.Time
  cierra  DateTime? @db.Time
  motivo  String?

  @@map("fecha_especial")
}

model Archivo {
  id                 BigInt             @id @default(autoincrement())
  ruta               String             @unique
  tipo_mime          String
  bytes              Int
  privado            Boolean            @default(false)
  foto_local         FotoLocal?
  productos          Producto[]
  incidentes         IncidenteEntrega[]
  incidenteFotos     IncidenteEntregaFoto[]
  compras            Compra[]
  iniciativas        Iniciativa[]
  novedadesFotos     NovedadFoto[]
  destacadasPortadas Destacada[]
  ofertasImagen      Oferta[]
  destacadasFotos    DestacadaFoto[]
  vouchers           VoucherPago[]

  @@map("archivo")
}

model FotoLocal {
  archivo_id BigInt  @id
  slot       String? @unique
  orden      Int     @default(0)
  activo     Boolean @default(true)
  archivo    Archivo @relation(fields: [archivo_id], references: [id])

  @@map("foto_local")
}

model AreaCocina {
  id              BigInt          @id @default(autoincrement())
  nombre          String          @unique
  propia          Boolean         @default(false)
  impresora       String?
  etiquetera      String?
  activo          Boolean         @default(true)
  categorias      Categoria[]
  pedidoLineas    PedidoLinea[]
  comandas        ComandaArea[]
  altasDemanda    AltaDemanda[]
  lugaresStock    LugarStock[]
  pedidosInternos PedidoInterno[]
  deviceKeys      DeviceKey[]
  printJobs       PrintJob[]
  printJobsDestino PrintJob[] @relation("DestinoImpresion")
  usuariosAreas   UserAccountArea[]

  @@map("area_cocina")
}

model Categoria {
  id             BigInt     @id @default(autoincrement())
  nombre         String     @unique
  lleva_opciones Boolean    @default(true)
  area_id        BigInt
  orden          Int        @default(0)
  oculta         Boolean    @default(false)
  area           AreaCocina @relation(fields: [area_id], references: [id])
  productos      Producto[]
  ofertasAlcance Oferta[]
  cuponesAlcance Cupon[]

  @@map("categoria")
}

model Producto {
  cortesias Cortesia[]
  id                 BigInt           @id @default(autoincrement())
  categoria_id       BigInt
  nombre             String           @unique
  descripcion        String?
  foto_archivo_id    BigInt?
  precio             Decimal          @db.Decimal(12, 2)
  por_lote           Boolean          @default(false)
  vida_util_horas    Int?
  orden              Int              @default(0)
  oculto             Boolean          @default(false)
  agotado_hasta      DateTime?        @db.Timestamptz
  /// MANUAL (se quita solo a mano) | AUTOMATICO (saldo 0; vuelve al reponer/abrir). NULL con agotado_hasta = MANUAL.
  agotado_origen     String?
  no_suma_beneficios Boolean          @default(false)
  // Cocina: resaltar la opción menos pedida (últimos 30 días) de cada grupo de este producto
  resaltar_opcion_menos_pedida Boolean @default(false)
  // Stock de producto terminado (donas, galletas): se controla aunque «Control de almacén» (insumos) esté apagado
  controla_stock     Boolean          @default(false)
  categoria          Categoria        @relation(fields: [categoria_id], references: [id])
  foto_archivo       Archivo?         @relation(fields: [foto_archivo_id], references: [id])
  tamanos            ProductoTamano[]
  grupos             ProductoGrupo[]
  sabores            Sabor[]
  pedidoLineas       PedidoLinea[]
  agotados           Agotado[]
  stocks             Stock[]
  movimientosStock   MovimientoStock[]
  conteosApertura    ConteoApertura[]
  recetas            Receta[]
  ofertasAlcance     Oferta[]
  comboReemplazos    ComboParteReemplazo[]
  opcionRequisitos   OpcionRequiere[]
  cuponesAlcance     Cupon[]
  rankingsMes        RankingMes[]

  @@map("producto")
}

model ProductoTamano {
  id              BigInt        @id @default(autoincrement())
  producto_id     BigInt
  tamano_valor_id BigInt
  precio          Decimal       @db.Decimal(12, 2)
  activo          Boolean       @default(true)
  /// Unidades (donas) que lleva el tamaño: Unidad=1, 1/2 docena=6, Docena=12. Con sabores, se reparten entre ellos.
  unidades        Int           @default(1)
  producto        Producto      @relation(fields: [producto_id], references: [id])
  tamano_valor    ListaValor    @relation(fields: [tamano_valor_id], references: [id])
  recetaLineas    RecetaLinea[]
  comboPartes     ComboParte[]

  @@unique([producto_id, tamano_valor_id])
  @@map("producto_tamano")
}

model GrupoOpciones {
  id          BigInt          @id @default(autoincrement())
  nombre      String          @unique
  lista_id    BigInt?
  obligatorio Boolean         @default(false)
  minimo      Int             @default(0)
  maximo      Int             @default(1)
  activo      Boolean         @default(true)
  lista       Lista?          @relation(fields: [lista_id], references: [id])
  opciones    Opcion[]
  productos   ProductoGrupo[]

  @@map("grupo_opciones")
}

model Opcion {
  id            BigInt        @id @default(autoincrement())
  grupo_id      BigInt
  valor_id      BigInt
  precio_extra  Decimal       @default(0) @db.Decimal(12, 2)
  activo              Boolean              @default(true)
  agotado_hasta       DateTime?            @db.Timestamptz
  grupo               GrupoOpciones        @relation(fields: [grupo_id], references: [id])
  valor               ListaValor           @relation(fields: [valor_id], references: [id])
  pedidoLineaOpciones PedidoLineaOpcion[]
  agotados            Agotado[]
  ajustes             AjusteOpcion[]
  requisitos          OpcionRequiere[]

  @@unique([grupo_id, valor_id])
  @@map("opcion")
}

model ProductoGrupo {
  id          BigInt        @id @default(autoincrement())
  producto_id BigInt
  grupo_id    BigInt
  orden       Int           @default(0)
  producto    Producto      @relation(fields: [producto_id], references: [id])
  grupo       GrupoOpciones @relation(fields: [grupo_id], references: [id])

  @@unique([producto_id, grupo_id])
  @@map("producto_grupo")
}

model Sabor {
  cortesias Cortesia[]
  id            BigInt    @id @default(autoincrement())
  producto_id   BigInt
  nombre        String
  activo        Boolean   @default(true)
  agotado_hasta DateTime? @db.Timestamptz
  /// MANUAL | AUTOMATICO (ver producto.agotado_origen)
  agotado_origen String?
  producto      Producto  @relation(fields: [producto_id], references: [id])
  agotados      Agotado[]
  stockSabor    StockSabor?
  movimientos   MovimientoStock[]
  conteosApertura ConteoApertura[]
  pedidoLineaSabores PedidoLineaSabor[]
  opcionRequisitos   OpcionRequiere[]

  @@unique([producto_id, nombre])
  @@map("sabor")
}

/// Stock que consume elegir una opción de grupo (p. ej. «2 Donas» = 2 de DONAS ARTESANALES; un sabor = 1 de ese sabor).
/// Sin filas, la opción solo mira agotado_hasta. Índice único sobre COALESCE(sabor_id, 0) (ver migración).
model OpcionRequiere {
  id          BigInt   @id @default(autoincrement())
  opcion_id   BigInt
  producto_id BigInt
  sabor_id    BigInt?
  cantidad    Int      @default(1)

  opcion      Opcion   @relation(fields: [opcion_id], references: [id], onDelete: Cascade)
  producto    Producto @relation(fields: [producto_id], references: [id])
  sabor       Sabor?   @relation(fields: [sabor_id], references: [id], onDelete: Cascade)

  @@index([producto_id])
  @@map("opcion_requiere")
}

/// Stock de producto terminado POR SABOR (donas, galletas con sabores). Una fila por sabor.
model StockSabor {
  id             BigInt   @id @default(autoincrement())
  sabor_id       BigInt   @unique
  cantidad       Decimal  @default(0) @db.Decimal(14, 3)
  actualizado_en DateTime @default(now()) @updatedAt @db.Timestamptz
  sabor          Sabor    @relation(fields: [sabor_id], references: [id])

  @@map("stock_sabor")
}

/// Sabores repartidos en una línea de pedido de un producto controlado por sabor (sigue al pedido).
model PedidoLineaSabor {
  id              BigInt      @id @default(autoincrement())
  pedido_linea_id BigInt
  sabor_id        BigInt?
  sabor_nombre    String
  cantidad        Int
  pedido_linea    PedidoLinea @relation(fields: [pedido_linea_id], references: [id], onDelete: Cascade)
  sabor           Sabor?      @relation(fields: [sabor_id], references: [id], onDelete: Restrict)

  @@map("pedido_linea_sabor")
}

// ---------- Ola 3: zonas de reparto y pedidos de la carta (FT-DEL-01, FT-PED-01..03, DT-57) ----------

model ZonaReparto {
  id        BigInt             @id @default(autoincrement())
  codigo    String             @unique
  poligono  Json
  tarifa    Decimal            @db.Decimal(12, 2)
  activa    Boolean            @default(true)
  minutos_min Int?
  minutos_max Int?
  pedidos   Pedido[]
  contactos ContactMechanism[]
  direcciones ClienteDireccion[]
  cambiosUbicacionAnterior PedidoCambioUbicacion[] @relation("CambioZonaAnterior")
  cambiosUbicacionNueva    PedidoCambioUbicacion[] @relation("CambioZonaNueva")

  @@map("zona_reparto")
}

model Pedido {
  cortesias          Cortesia[] @relation("CortesiaPedido")
  cortesiasReferencia Cortesia[] @relation("CortesiaReferencia")
  id                     BigInt                  @id @default(autoincrement())
  codigo                 String                  @unique
  canal                  String                  @default("CARTA")
  modalidad              String
  estado                 String                  @default("COLA")
  party_id               BigInt?
  es_personal            Boolean                 @default(false)
  cliente_nombre         String?
  cliente_telefono       String?
  entrega_direccion      String?
  entrega_referencia     String?
  entrega_lat            Decimal?                @db.Decimal(9, 6)
  entrega_lng            Decimal?                @db.Decimal(9, 6)
  entrega_origen         String?
  zona_id                BigInt?
  pago_metodo            String?
  pago_estado            String?                 @default("PENDIENTE")
  pago_preferido         String?
  paga_con               Decimal?                @db.Decimal(12, 2)
  subtotal               Decimal                 @db.Decimal(12, 2)
  descuento              Decimal                 @default(0) @db.Decimal(12, 2)
  envio                  Decimal?                @db.Decimal(12, 2)
  total                  Decimal                 @db.Decimal(12, 2)
  comprobante_tipo       String                  @default("SIMPLE") // SIMPLE (ticket interno, sin SUNAT) | BOLETA | FACTURA
  comprobante_doc        String?
  comprobante_razon      String?
  comprobante_direccion  String?
  nota                   String?
  clave_idempotencia     String?                 @unique
  oferta_id              BigInt?
  cupon_id               BigInt?
  cupon_emitido_id       BigInt?
  descuento_detalle      Json?
  puntos_ganados         Decimal                 @default(0) @db.Decimal(12, 2)
  puntos_canjeados       Decimal                 @default(0) @db.Decimal(12, 2)
  pago_coordinado_en     DateTime?               @db.Timestamptz
  pago_coordinado_por    BigInt?
  despachado_en          DateTime?               @db.Timestamptz
  despachado_por         BigInt?
  /// Pantalla Despacho de Cocina: el despachador marcó el pedido completo como atendido (no cambia su estado)
  atendido_despacho_en   DateTime?               @db.Timestamptz
  atendido_despacho_por  BigInt?
  confirmado_en          DateTime?               @db.Timestamptz
  confirmado_por         BigInt?
  pasa_cocina_en         DateTime?               @db.Timestamptz
  listo_en               DateTime?               @db.Timestamptz
  entregado_en           DateTime?               @db.Timestamptz
  anulado_en             DateTime?               @db.Timestamptz
  anulado_por            BigInt?
  motivo_anulacion       String?
  anulacion_aprobada_por BigInt?
  creado_en              DateTime                @default(now()) @db.Timestamptz
  eta_min                Int?
  eta_max                Int?
  // Cliente con cuenta identificado (carta, WhatsApp o DNI del mozo); null = invitado
  cliente_party_id       BigInt?
  // Reparto (Ola 4)
  repartidor_party_id    BigInt?
  tomado_en              DateTime?               @db.Timestamptz
  salio_en               DateTime?               @db.Timestamptz
  llego_en               DateTime?               @db.Timestamptz
  motivo_falla           String?
  // Posición en la ruta que eligió el repartidor al tomar (1 = primera parada); null si no eligió orden
  orden_ruta             Int?
  numero_ruta            Int?
  // Ruta de reparto (salida del repartidor) a la que pertenece; se conserva al entregar o fallar
  ruta_reparto_id        BigInt?
  // Salón (Ola 6)
  mesa_nombre            String?
  /// Lista de espera de mesa: desde cuándo espera un pedido de mesa sin mesa asignada (null = ya tiene mesa o no aplica)
  espera_mesa_desde      DateTime?               @db.Timestamptz
  espera_personas        Int?
  /// Mesa de la que lo sacaron para dar su lugar a otro de la lista (ej. «Mesa 4»); null = esperó desde el inicio
  espera_desplazado_de   String?
  entregado_mesa_en      DateTime?               @db.Timestamptz
  // Cobro por mozo (envío a Caja): cuándo, medio(s) con que lo cobró y el mozo; null si no se envió
  cobro_mozo_en          DateTime?               @db.Timestamp(3)
  cobro_mozo_medio       String?
  cobro_mozo_party_id    BigInt?
  // Efectivo que el mozo recibió (Pagó con S/); el vuelto se calcula contra el renglón de efectivo del plan
  cobro_mozo_recibido    Decimal?                @db.Decimal(12, 2)
  // Cambio de ubicación (RN cambio de punto): cuándo se aplicó el último cambio; null = dirección original
  ubicacion_editada_en   DateTime?               @db.Timestamptz
  // Número correlativo del día (referencial, solo cocina): se asigna al llegar a cocina (día Lima de esa hora)
  numero_dia             Int?
  fecha_dia              DateTime?               @db.Date
  // Propina opcional del cliente: va APARTE (no suma a subtotal/total, ni comprobante, ni puntos). Se cobra junto con el pedido
  propina                Decimal                @default(0) @db.Decimal(12, 2)
  // Control de versión optimista de «Editar pedido»: sube 1 con cada edición; guardar con una versión vieja da 409 PEDIDO_MODIFICADO
  version                Int                    @default(0)
  // «Pedido extra»: pedido nuevo enlazado al original (mismo cliente y modalidad, envío 0, pago y comprobante propios)
  pedido_origen_id       BigInt?

  pedidoOrigen           Pedido?                 @relation("PedidoExtra", fields: [pedido_origen_id], references: [id], onDelete: SetNull)
  extras                 Pedido[]                @relation("PedidoExtra")
  party                 Party?                  @relation("ClientePedido", fields: [party_id], references: [id])
  repartidor             Party?                  @relation("RepartidorPedido", fields: [repartidor_party_id], references: [id])
  rutaReparto            RutaReparto?            @relation(fields: [ruta_reparto_id], references: [id])
  zona                   ZonaReparto?            @relation(fields: [zona_id], references: [id])
  oferta                 Oferta?                 @relation(fields: [oferta_id], references: [id])
  cupon                  Cupon?                  @relation(fields: [cupon_id], references: [id])
  cuponEmitido           CuponEmitido?           @relation("PedidoCuponEmitido", fields: [cupon_emitido_id], references: [id])
  lineas                 PedidoLinea[]
  historial              PedidoEstadoHistorial[]
  cobros                 Cobro[]
  incidentes             IncidenteEntrega[]
  mensajesReparto        MensajeReparto[]
  comandas               ComandaArea[]
  movimientosStock       MovimientoStock[]
  mesas                  PedidoMesa[]
  reservas               Reserva[]
  comprobante            Comprobante[]
  reclamos               Reclamo[]
  cuponesEmitidosOrigen  CuponEmitido[]          @relation("CuponesEmitidosOrigen")
  cuponesEmitidosCanje   CuponEmitido[]          @relation("CuponesEmitidosCanje")
  cuponesCanjeCompartido CuponCanjeCompartido[]
  movimientosPuntos      MovimientoPuntos[]
  consumoPersonal        ConsumoPersonal?
  solicitudesCambio      SolicitudCambio[]
  encuesta               Encuesta?
  printJobs              PrintJob[]
  salientesWhatsapp      SalienteWhatsapp[]
  whatsappMensajes       WhatsappMensaje[]
  encuestaPosventa       EncuestaPosventa?
  quejasWhatsapp         QuejaWhatsapp[]
  vouchers               VoucherPago[]
  planPago               PedidoPagoPlan[]
  solicitudesCambioCobro SolicitudCambioCobro[]
  devolucion             DevolucionPedido?
  cambiosUbicacion       PedidoCambioUbicacion[]
  clienteIdentificado    Party?                 @relation("ClienteIdentificadoPedido", fields: [cliente_party_id], references: [id])

  @@index([cliente_party_id], map: "pedido_cliente_party_id_idx")
  @@index([ruta_reparto_id], map: "pedido_ruta_reparto_id_idx")
  @@index([pedido_origen_id], map: "pedido_pedido_origen_id_idx")
  @@unique([fecha_dia, numero_dia], map: "pedido_fecha_dia_numero_dia_key")
  @@map("pedido")
}

// Contador del número del día en cocina: una fila por fecha Lima; ultimo = último número entregado
model ContadorDiario {
  fecha  DateTime @id @db.Date
  ultimo Int      @default(0)

  @@map("contador_diario")
}

// Una salida del repartidor con sus pedidos: se cierra sola cuando todos llegan a un estado final
model RutaReparto {
  id                  BigInt    @id @default(autoincrement())
  repartidor_party_id BigInt
  iniciada_en         DateTime  @default(now()) @db.Timestamptz
  terminada_en        DateTime? @db.Timestamptz
  estado              String    @default("EN_CURSO") // EN_CURSO | TERMINADA
  origen              String // TOMAR_RUTA | SUGERIDA | INDIVIDUAL
  creada_en           DateTime  @default(now()) @db.Timestamptz

  repartidor          Party     @relation("RepartidorRuta", fields: [repartidor_party_id], references: [id])
  pedidos             Pedido[]

  @@index([repartidor_party_id, estado], map: "ruta_reparto_repartidor_estado_idx")
  @@map("ruta_reparto")
}

model ClienteDireccion {
  id            BigInt      @id @default(autoincrement())
  party_id      BigInt
  direccion     String
  referencia    String?
  lat           Decimal?    @db.Decimal(10, 7)
  lng           Decimal?    @db.Decimal(10, 7)
  zona_id       BigInt?
  origen        String // CARTA | MOZO | WHATSAPP | MAPA | ESCRITA
  alias         String?
  usos          Int         @default(1)
  ultimo_uso_en DateTime    @db.Timestamptz
  activo        Boolean     @default(true)
  creado_en     DateTime    @default(now()) @db.Timestamptz
  party         Party       @relation(fields: [party_id], references: [id])
  zona          ZonaReparto? @relation(fields: [zona_id], references: [id])

  @@index([party_id, activo, ultimo_uso_en(sort: Desc)], map: "cliente_direccion_party_activo_uso_idx")
  @@map("cliente_direccion")
}

model PedidoLinea {
  es_cortesia      Boolean            @default(false)
  id               BigInt              @id @default(autoincrement())
  pedido_id        BigInt
  producto_id      BigInt?
  oferta_id        BigInt?
  linea_combo_id   BigInt?
  nombre           String
  tamano           String?
  opciones         Json                @default("[]")
  sabor            String?
  nota             String?
  cantidad         Int
  precio_unit      Decimal             @db.Decimal(12, 2)
  subtotal         Decimal?            @db.Decimal(12, 2)
  area_id          BigInt?
  adicional        Boolean             @default(false)
  nombres_persona  String[]
  /// Unidades ya listas en cocina (0..cantidad). Se fija desde la cocina por producto.
  listas           Int                 @default(0)
  /// Cuando listas llega a cantidad.
  listo_en         DateTime?           @db.Timestamptz
  /// Unidades ya entregadas al cliente o al mozo (despacho). Siempre <= listas.
  despachadas      Int                 @default(0)
  despachado_en    DateTime?           @db.Timestamptz
  pedido           Pedido              @relation(fields: [pedido_id], references: [id])
  producto         Producto?           @relation(fields: [producto_id], references: [id])
  oferta           Oferta?             @relation(fields: [oferta_id], references: [id])
  area             AreaCocina?         @relation(fields: [area_id], references: [id])
  lineaComboPadre  PedidoLinea?        @relation("ComboPartes", fields: [linea_combo_id], references: [id])
  lineasComboHijas PedidoLinea[]       @relation("ComboPartes")
  opcionesElegidas PedidoLineaOpcion[]
  sabores          PedidoLineaSabor[]
  cortesia         Cortesia?

  @@map("pedido_linea")
}

model PedidoLineaOpcion {
  id              BigInt      @id @default(autoincrement())
  pedido_linea_id BigInt
  opcion_id       BigInt?
  grupo_nombre    String
  opcion_nombre   String
  precio_unit     Decimal     @default(0) @db.Decimal(12, 2)
  precio_extra    Decimal     @default(0) @db.Decimal(12, 2)
  nombre_persona  String?
  pedido_linea    PedidoLinea @relation(fields: [pedido_linea_id], references: [id])
  opcion          Opcion?     @relation(fields: [opcion_id], references: [id])

  @@map("pedido_linea_opcion")
}

model PedidoEstadoHistorial {
  id              BigInt   @id @default(autoincrement())
  pedido_id       BigInt
  estado_anterior String?
  estado_nuevo    String
  motivo          String?
  por_party_id    BigInt?
  en              DateTime @default(now()) @db.Timestamptz
  pedido          Pedido   @relation(fields: [pedido_id], references: [id])

  @@map("pedido_estado_historial")
}

model SecuenciaPedido {
  nombre String @id
  ultimo Int    @default(0)

  @@map("secuencia_pedido")
}

// ---------- Ola 4: caja, cobros, cierres y reparto ----------

model Caja {
  id          BigInt      @id @default(autoincrement())
  fecha       DateTime    @unique @db.Date
  apertura    Decimal     @default(0) @db.Decimal(12, 2)
  estado      String      @default("ABIERTA")
  abierta_por BigInt
  cerrada_por BigInt?
  cerrada_en  DateTime?   @db.Timestamptz

  cobros        Cobro[]
  movimientos   MovimientoCaja[]
  liquidaciones Liquidacion[]
  cierre        CierreCaja?
  conteos       ConteoCierre[]
  ajustesMedio  CierreAjusteMedio[]

  @@map("caja")
}

model Cobro {
  id               BigInt      @id @default(autoincrement())
  // Un pedido puede tener varios cobros, pero solo uno vigente (anulado_en IS NULL): índice único parcial
  // cobro_pedido_vigente_key, creado en la migración 20261024200000_cobro_anulado_conservado (Prisma no lo declara).
  pedido_id        BigInt
  caja_id          BigInt
  total            Decimal     @db.Decimal(12, 2)
  credito_personal Boolean     @default(false)
  cobrado_por      BigInt
  en               DateTime    @default(now()) @db.Timestamptz
  anulado_en       DateTime?   @db.Timestamptz
  anulado_por      BigInt?
  motivo_anulacion String?

  pedido           Pedido      @relation(fields: [pedido_id], references: [id])
  caja             Caja        @relation(fields: [caja_id], references: [id])
  pagos            CobroPago[]

  @@map("cobro")
}

model CobroPago {
  id       BigInt   @id @default(autoincrement())
  cobro_id BigInt
  medio    String
  monto    Decimal  @db.Decimal(12, 2)
  recibido Decimal? @db.Decimal(12, 2)
  vuelto   Decimal? @db.Decimal(12, 2)
  // Parte de este renglón que es propina (el monto es venta). Entregado = monto + propina.
  propina  Decimal  @default(0) @db.Decimal(12, 2)

  cobro    Cobro    @relation(fields: [cobro_id], references: [id])

  @@map("cobro_pago")
}

model MovimientoCaja {
  id               BigInt    @id @default(autoincrement())
  caja_id          BigInt
  tipo             String
  monto            Decimal   @db.Decimal(12, 2)
  motivo           String
  anulado_en       DateTime? @db.Timestamptz
  motivo_anulacion String?

  caja             Caja      @relation(fields: [caja_id], references: [id])
  devolucion       DevolucionPedido[]
  cambiosUbicacion PedidoCambioUbicacion[]

  @@map("movimiento_caja")
}

model Liquidacion {
  id                  BigInt   @id @default(autoincrement())
  caja_id             BigInt
  repartidor_party_id BigInt
  esperado            Decimal  @db.Decimal(12, 2)
  entregado           Decimal  @db.Decimal(12, 2)
  en                  DateTime @default(now()) @db.Timestamptz

  caja                Caja     @relation(fields: [caja_id], references: [id])
  repartidor          Party    @relation("LiquidacionesRepartidor", fields: [repartidor_party_id], references: [id])

  @@map("liquidacion")
}

model CierreCaja {
  caja_id      BigInt        @id
  conteo       Json
  resultado    String
  aprobado_por BigInt?
  nota         String?

  caja         Caja          @relation(fields: [caja_id], references: [id])
  medios       CierreMedio[]

  @@map("cierre_caja")
}

model ConteoCierre {
  caja_id   BigInt
  intento   Int      @db.SmallInt
  conteo    Json
  medios    Json
  resultado String
  por       BigInt
  en        DateTime @default(now()) @db.Timestamptz

  caja      Caja     @relation(fields: [caja_id], references: [id])

  @@id([caja_id, intento])
  @@map("conteo_cierre")
}

model CierreMedio {
  caja_id    BigInt
  medio      String
  sistema    Decimal    @db.Decimal(12, 2)
  visto      Decimal    @db.Decimal(12, 2)
  diferencia Decimal?   @default(dbgenerated("(visto - sistema)")) @db.Decimal(12, 2)

  cierre     CierreCaja @relation(fields: [caja_id], references: [caja_id])

  @@id([caja_id, medio])
  @@map("cierre_medio")
}

/// Corrección de un monto digital (Yape, Plin, transferencia o tarjeta) de una caja. Solo se inserta:
/// el trigger de la migración impide UPDATE y DELETE (historial append-only).
/// Devolución de un pedido cancelado por no recibir que ya estaba pagado. Manual, una por pedido. Solo se inserta.
model DevolucionPedido {
  id                      BigInt         @id @default(autoincrement())
  pedido_id               BigInt         @unique
  monto_pagado            Decimal        @db.Decimal(12, 2)
  monto_envio             Decimal        @db.Decimal(12, 2)
  monto_sugerido          Decimal        @db.Decimal(12, 2)
  monto_devuelto          Decimal        @db.Decimal(12, 2)
  medio                   String
  codigo_operacion        String?
  motivo                  String?
  por_party_id            BigInt
  autorizado_por_party_id BigInt
  // Resultado de la comunicación de baja de la boleta/factura (null si no tenía comprobante electrónico)
  comprobante_baja_estado String?
  movimiento_caja_id      BigInt?
  creado_en               DateTime       @default(now()) @db.Timestamptz

  pedido         Pedido          @relation(fields: [pedido_id], references: [id])
  por            Party           @relation("DevolucionPor", fields: [por_party_id], references: [id])
  autorizadoPor  Party           @relation("DevolucionAutorizada", fields: [autorizado_por_party_id], references: [id])
  movimientoCaja MovimientoCaja? @relation(fields: [movimiento_caja_id], references: [id])

  @@map("devolucion_pedido")
}

model CierreAjusteMedio {
  id                      BigInt   @id @default(autoincrement())
  caja_id                 BigInt
  medio                   String
  monto_sistema           Decimal  @db.Decimal(12, 2)
  monto_anterior          Decimal  @db.Decimal(12, 2)
  monto_nuevo             Decimal  @db.Decimal(12, 2)
  motivo                  String
  por_party_id            BigInt
  autorizado_por_party_id BigInt
  creado_en               DateTime @default(now()) @db.Timestamptz

  caja           Caja  @relation(fields: [caja_id], references: [id])
  por            Party @relation("AjusteMedioPor", fields: [por_party_id], references: [id])
  autorizado_por Party @relation("AjusteMedioAutorizado", fields: [autorizado_por_party_id], references: [id])

  @@index([caja_id])
  @@map("cierre_ajuste_medio")
}

model IncidenteEntrega {
  id              BigInt    @id @default(autoincrement())
  pedido_id       BigInt
  motivo          String
  intento         Int
  en              DateTime  @default(now()) @db.Timestamptz
  cierre          String?
  recargo         Decimal?  @db.Decimal(12, 2)
  cerrado_por     BigInt?
  contactos       Json      @default("[]")
  foto_archivo_id BigInt?
  /// Prueba de entrega fallida (cliente no salió): instante de llegada, minutos de espera exigidos y repartidor
  llego_en           DateTime? @db.Timestamptz
  espera_max_min    Int?
  repartidor_party_id BigInt?

  pedido          Pedido    @relation(fields: [pedido_id], references: [id])
  foto_archivo    Archivo?  @relation(fields: [foto_archivo_id], references: [id])
  fotos           IncidenteEntregaFoto[]

  @@map("incidente_entrega")
}

model IncidenteEntregaFoto {
  incidente_id BigInt
  archivo_id   BigInt
  creado_en    DateTime         @default(now()) @db.Timestamptz
  incidente    IncidenteEntrega @relation(fields: [incidente_id], references: [id])
  archivo      Archivo          @relation(fields: [archivo_id], references: [id])

  @@id([incidente_id, archivo_id])
  @@map("incidente_entrega_foto")
}

model MensajeReparto {
  pedido_id     BigInt
  numero        Int       @db.SmallInt
  enviado_en    DateTime  @default(now()) @db.Timestamptz
  respondido_en DateTime? @db.Timestamptz
  estado        String    @default("ENVIADO")

  pedido        Pedido    @relation(fields: [pedido_id], references: [id])

  @@id([pedido_id, numero])
  @@map("mensaje_reparto")
}

/// Aviso que se envía una sola vez por celular (bienvenida a los puntos). Solo se inserta.
model AvisoClienteUnico {
  telefono  String   @db.VarChar(9)
  aviso     String   @db.VarChar(40)
  creado_en DateTime @default(now()) @db.Timestamptz

  @@id([telefono, aviso])
  @@map("aviso_cliente_unico")
}

// ---------- Ola 5: cocina por áreas, stock y recetas (FT-COC-01..03, FT-STK-01..03) ----------

model ComandaArea {
  pedido_id     BigInt
  area_id       BigInt
  estado        String    @default("EN_COCINA") // EN_COCINA | DESPEJADA
  llego_en      DateTime  @default(now()) @db.Timestamptz
  despejada_en  DateTime? @db.Timestamptz
  despejada_por BigInt?
  devuelta_en   DateTime? @db.Timestamptz
  devuelta_por  BigInt?

  pedido Pedido     @relation(fields: [pedido_id], references: [id])
  area   AreaCocina @relation(fields: [area_id], references: [id])

  @@id([pedido_id, area_id])
  @@map("comanda_area")
}

model Agotado {
  id            BigInt    @id @default(autoincrement())
  producto_id   BigInt?
  opcion_id     BigInt?
  sabor_id      BigInt?
  tipo          String?   // PRODUCTO | SABOR | OPCION
  alcance       String    // HOY | HASTA_REACTIVAR | INDEFINIDO
  desde         DateTime  @default(now()) @db.Timestamptz
  hasta         DateTime? @db.Timestamptz
  reactivado_en DateTime? @db.Timestamptz
  por           BigInt
  /// MANUAL | AUTOMATICO; NULL = MANUAL
  origen        String?

  producto Producto? @relation(fields: [producto_id], references: [id])
  opcion   Opcion?   @relation(fields: [opcion_id], references: [id])
  sabor    Sabor?    @relation(fields: [sabor_id], references: [id])

  @@map("agotado")
}

model AltaDemanda {
  id      BigInt      @id @default(autoincrement())
  minutos Int
  pausa   Boolean     @default(false)
  desde   DateTime    @default(now()) @db.Timestamptz
  hasta   DateTime?   @db.Timestamptz
  por     BigInt
  area_id BigInt?

  area AreaCocina? @relation(fields: [area_id], references: [id])

  @@map("alta_demanda")
}

model LugarStock {
  id               BigInt            @id @default(autoincrement())
  nombre           String            @unique
  tipo             String            // ALMACEN | AREA
  area_id          BigInt?
  area             AreaCocina?       @relation(fields: [area_id], references: [id])
  insumosConsumo   Insumo[]          @relation("InsumoLugarConsumo")
  stocks           Stock[]
  movimientos      MovimientoStock[]
  trasladosDestino Traslado[]
  cierresDia       CierreDia[]
  conteosApertura  ConteoApertura[]

  @@map("lugar_stock")
}

model Insumo {
  id                    BigInt                 @id @default(autoincrement())
  nombre                String                 @unique
  unidad_compra         String
  unidad_almacen        String
  unidad_receta         String
  factor_compra         Decimal                @db.Decimal(14, 3)
  factor_receta         Decimal                @db.Decimal(14, 6)
  minimo                Decimal                @db.Decimal(14, 3)
  intermedio            Decimal?               @db.Decimal(14, 3)
  maximo                Decimal                @db.Decimal(14, 3)
  lugar_consumo_id      BigInt?
  costo_unit            Decimal?               @db.Decimal(12, 4)
  proveedor_a           BigInt?
  proveedor_b           BigInt?
  proveedor_c           BigInt?
  activo                Boolean                @default(true)

  lugarConsumo          LugarStock?            @relation("InsumoLugarConsumo", fields: [lugar_consumo_id], references: [id])
  stocks                Stock[]
  movimientos           MovimientoStock[]
  recetaLineas          RecetaLinea[]
  ajustesOpcion         AjusteOpcion[]         @relation("AjusteInsumo")
  ajustesReemplaza      AjusteOpcion[]         @relation("AjusteReemplazaInsumo")
  pedidoProveedorLineas PedidoProveedorLinea[]
  compraLineas          CompraLinea[]
  traslados             Traslado[]

  @@map("insumo")
}

model Stock {
  id          BigInt      @id @default(autoincrement())
  insumo_id   BigInt?
  producto_id BigInt?
  lugar_id    BigInt
  cantidad    Decimal     @db.Decimal(14, 3)

  insumo      Insumo?     @relation(fields: [insumo_id], references: [id])
  producto    Producto?   @relation(fields: [producto_id], references: [id])
  lugar       LugarStock  @relation(fields: [lugar_id], references: [id])

  @@map("stock")
}

model MovimientoStock {
  id                    BigInt            @id @default(autoincrement())
  tipo                  String            // ENTRADA | SALIDA | AJUSTE | MERMA | DEVOLUCION | VENTA | PRODUCCION_CONSUMO | PRODUCCION_ALTA | TRASLADO_SALIDA | TRASLADO_ENTRADA | DIFERENCIA_CONTEO | ANULACION | CORTESIA
  insumo_id             BigInt?
  producto_id           BigInt?
  lugar_id              BigInt
  cantidad              Decimal           @db.Decimal(14, 3)
  origen_valor_id       BigInt?
  destino_valor_id      BigInt?
  pedido_id             BigInt?
  produccion_id         BigInt?
  /// Sabor del producto por sabor (donas, galletas): el stock se lleva en stock_sabor
  sabor_id              BigInt?
  traslado_id           BigInt?
  compra_id             BigInt?
  nota                  String?
  movimiento_anulado_id BigInt?
  por                   BigInt
  en                    DateTime          @default(now()) @db.Timestamptz

  insumo                Insumo?           @relation(fields: [insumo_id], references: [id])
  producto              Producto?         @relation(fields: [producto_id], references: [id])
  lugar                 LugarStock        @relation(fields: [lugar_id], references: [id])
  origen_valor          ListaValor?       @relation("MovimientoStockOrigen", fields: [origen_valor_id], references: [id])
  destino_valor         ListaValor?       @relation("MovimientoStockDestino", fields: [destino_valor_id], references: [id])
  pedido                Pedido?           @relation(fields: [pedido_id], references: [id])
  sabor                 Sabor?            @relation(fields: [sabor_id], references: [id], onDelete: Restrict)
  movimientoAnulado     MovimientoStock?  @relation("MovimientosAnulados", fields: [movimiento_anulado_id], references: [id])
  movimientosRevertidos MovimientoStock[] @relation("MovimientosAnulados")

  @@map("movimiento_stock")
}

/// Conteo de apertura del día (fecha en hora de Lima) de un producto que controla stock. Una fila por día y producto.
/// Sin sabor_id: conteo del producto entero. Con sabor_id: conteo de ese sabor.
/// Unicidad por (fecha, producto_id, coalesce(sabor_id, 0)): índice con expresión en la migración
/// 20261222100000_stock_por_sabor (Prisma no la declara aquí).
model ConteoApertura {
  id          BigInt     @id @default(autoincrement())
  fecha       DateTime   @db.Date
  producto_id BigInt
  sabor_id    BigInt?
  lugar_id    BigInt
  cantidad    Decimal    @db.Decimal(14, 3)
  por         BigInt
  en          DateTime   @default(now()) @db.Timestamptz

  producto    Producto   @relation(fields: [producto_id], references: [id])
  sabor       Sabor?     @relation(fields: [sabor_id], references: [id], onDelete: Restrict)
  lugar       LugarStock @relation(fields: [lugar_id], references: [id])

  @@map("conteo_apertura")
}

model Receta {
  id              BigInt        @id @default(autoincrement())
  producto_id     BigInt
  tamano_valor_id BigInt?
  es_produccion   Boolean       @default(false)
  rinde           Decimal?      @db.Decimal(14, 3)

  producto        Producto      @relation(fields: [producto_id], references: [id])
  tamano_valor    ListaValor?   @relation(fields: [tamano_valor_id], references: [id])
  lineas          RecetaLinea[]
  producciones    Produccion[]

  @@unique([producto_id, tamano_valor_id, es_produccion])
  @@map("receta")
}

model RecetaLinea {
  receta_id          BigInt
  insumo_id          BigInt
  cantidad           Decimal         @db.Decimal(14, 3)
  producto_tamano_id BigInt?

  receta             Receta          @relation(fields: [receta_id], references: [id])
  insumo             Insumo          @relation(fields: [insumo_id], references: [id])
  productoTamano     ProductoTamano? @relation(fields: [producto_tamano_id], references: [id])

  @@id([receta_id, insumo_id])
  @@map("receta_linea")
}

model AjusteOpcion {
  opcion_id           BigInt
  insumo_id           BigInt
  efecto              String          // SUMA | QUITA | REEMPLAZA
  reemplaza_insumo_id BigInt?
  cantidad            Decimal?        @db.Decimal(14, 3)

  opcion              Opcion          @relation(fields: [opcion_id], references: [id])
  insumo              Insumo          @relation("AjusteInsumo", fields: [insumo_id], references: [id])
  reemplazaInsumo     Insumo?         @relation("AjusteReemplazaInsumo", fields: [reemplaza_insumo_id], references: [id])

  @@id([opcion_id, insumo_id])
  @@map("ajuste_opcion")
}

// ---------- Ola 6: salón, plano, mesas y reservas (FT-SAL-01..03) ----------

model Piso {
  id               BigInt          @id @default(autoincrement())
  nombre           String
  activo           Boolean         @default(true)
  cuadricula_ancho Int
  cuadricula_alto  Int
  elementos        ElementoPlano[]

  @@map("piso")
}

model ElementoPlano {
  id           BigInt        @id @default(autoincrement())
  piso_id      BigInt
  tipo         String
  nombre       String?
  x            Int
  y            Int
  ancho        Int
  alto         Int
  numero       Int?
  asientos     Int?
  activo       Boolean       @default(true)

  piso         Piso          @relation(fields: [piso_id], references: [id])
  pedidosMesa  PedidoMesa[]
  reservasMesa ReservaMesa[]

  @@map("elemento_plano")
}

model Reserva {
  id                 BigInt        @id @default(autoincrement())
  nombre             String
  telefono           String
  personas           Int
  hora               DateTime      @db.Timestamptz
  tolerancia_min     Int
  estado             String        @default("ACTIVA")
  motivo_cancelacion String?
  pedido_id          BigInt?
  recordatorio_enviado Boolean     @default(false)
  origen             String        @default("LOCAL")
  nota               String?

  pedido             Pedido?            @relation(fields: [pedido_id], references: [id])
  mesas              ReservaMesa[]
  solicitudesReserva SolicitudReserva[]

  @@map("reserva")
}

model ReservaMesa {
  id         BigInt         @id @default(autoincrement())
  reserva_id BigInt
  mesa_id    BigInt?

  reserva    Reserva        @relation(fields: [reserva_id], references: [id], onDelete: Cascade)
  mesa       ElementoPlano? @relation(fields: [mesa_id], references: [id], onDelete: SetNull)

  // Una mesa una sola vez por reserva (los nulos no chocan: la mesa se borró del plano)
  @@unique([reserva_id, mesa_id])
  @@map("reserva_mesa")
}

model PedidoMesa {
  id          BigInt         @id @default(autoincrement())
  pedido_id   BigInt
  mesa_id     BigInt?
  mesa_nombre String?
  abierta     Boolean        @default(true)
  /// Posición de la mesa en el pedido (1 = principal). Un pedido puede tener varias mesas abiertas.
  orden       Int            @default(1)
  /// Mesa que da nombre al pedido. Unicidad parcial (solo abiertas) en la migración 20261231400000.
  principal   Boolean        @default(false)

  pedido      Pedido         @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  mesa        ElementoPlano? @relation(fields: [mesa_id], references: [id], onDelete: SetNull)

  @@map("pedido_mesa")
}

// ---------- Ola 7: comprobantes y obligaciones legales (FT-LEG-01, FT-LEG-02) ----------

model Comprobante {
  id                 BigInt    @id @default(autoincrement())
  // Una sola vigente por pedido (índice parcial en la migración); la anulada se conserva
  pedido_id          BigInt
  tipo               String    // NOTA_VENTA | BOLETA | FACTURA
  serie              String
  numero             Int
  numero_texto       String    @unique
  documento          String?
  razon_social       String?
  emision            String    @default("POR_EMITIR") // INTERNA | POR_EMITIR | EMITIDO
  emitido_en         DateTime? @db.Timestamptz
  emitido_por        BigInt?
  referencia_externa String?
  copias_impresas    Int       @default(0)
  creado_en          DateTime  @default(now()) @db.Timestamptz
  anulado_en         DateTime? @db.Timestamp(3)
  anulado_motivo     String?
  // Facturación electrónica (SUNAT): BOLETA/FACTURA. facturacion_estado: EMITIDO_SUNAT | RECHAZADO | PENDIENTE_ENVIO
  facturacion_estado        String?
  facturacion_intentos      Int       @default(0)
  facturacion_enlace_pdf    String?
  facturacion_cadena_qr     String?
  facturacion_hash          String?
  facturacion_respuesta     String?
  simulado               Boolean   @default(false)
  // Comunicación de baja (anulación): SOLICITADA | ACEPTADA | RECHAZADA. Nada se borra.
  baja_estado            String?
  baja_motivo            String?
  baja_en                DateTime? @db.Timestamp(3)
  baja_respuesta         String?
  // SUNAT directo: proveedor que emitió (SIMULADO | SUNAT), resumen que lleva la emisión y la baja, totales para el RC
  emisor                 String?
  resumen_emision_id     BigInt?
  resumen_baja_id        BigInt?
  sunat_total_cents      Int?
  sunat_igv_cents        Int?
  // Resiliencia (outbox): próximo intento, lease de envío en curso, y motivo de la cola de fallos (REVISION_MANUAL)
  proximo_intento_en     DateTime? @db.Timestamptz
  enviando_hasta         DateTime? @db.Timestamptz
  revision_motivo        String?
  revision_en            DateTime? @db.Timestamptz

  pedido             Pedido    @relation(fields: [pedido_id], references: [id])
  emitidoPor         Party?    @relation("ComprobantesEmitidos", fields: [emitido_por], references: [id])
  archivos           ComprobanteArchivo[]

  @@unique([serie, numero])
  @@map("comprobante")
}

/// XML firmado, ZIP enviado y CDR de cada comprobante electrónico. Se conservan años: nada se borra.
model ComprobanteArchivo {
  id             BigInt      @id @default(autoincrement())
  comprobante_id BigInt
  tipo           String // XML | ZIP | CDR
  nombre         String
  contenido      Bytes
  sha256         String
  creado_en      DateTime    @default(now()) @db.Timestamptz
  comprobante    Comprobante @relation(fields: [comprobante_id], references: [id])

  @@index([comprobante_id, tipo])
  @@map("comprobante_archivo")
}

/// Resumen diario (RC) o comunicación de baja (RA) enviado a SUNAT con su ticket, ZIP y CDR.
model SunatResumen {
  id               BigInt   @id @default(autoincrement())
  tipo             String // RC | RA
  nombre           String   @unique
  fecha_referencia DateTime @db.Timestamptz
  ticket           String?
  estado           String // PENDIENTE_ENVIO | ENVIADO | ACEPTADO | RECHAZADO
  respuesta        String?
  xml              Bytes
  zip              Bytes
  cdr              Bytes?
  creado_en        DateTime @default(now()) @db.Timestamptz
  actualizado_en   DateTime @default(now()) @db.Timestamptz

  @@map("sunat_resumen")
}

model SecuenciaComprobante {
  serie         String @id
  ultimo_numero Int    @default(0)

  @@map("secuencia_comprobante")
}

model Reclamo {
  id                    BigInt    @id @default(autoincrement())
  numero                String    @unique
  tipo                  String    // RECLAMO | QUEJA
  nombre                String
  documento             String
  domicilio             String
  telefono              String
  correo                String?
  pedido_id             BigInt?
  detalle               String
  monto_reclamado       Decimal?  @db.Decimal(12, 2)
  estado                String    @default("RECIBIDO") // RECIBIDO | EN_REVISION | RESPONDIDO
  respuesta             String?
  respondido_por        BigInt?
  respondido_en         DateTime? @db.Timestamptz
  fecha_limite          DateTime  @db.Date
  aceptacion_privacidad Boolean   @default(true)
  aceptado_en           DateTime  @default(now()) @db.Timestamptz
  creado_en             DateTime  @default(now()) @db.Timestamptz

  pedido                Pedido?   @relation(fields: [pedido_id], references: [id])
  respondidoPor         Party?    @relation("ReclamosRespondidos", fields: [respondido_por], references: [id])

  @@map("reclamo")
}

// ---------- Fase Siguiente - Ola S1: Promociones, ofertas, cupones y cuenta del cliente ----------

model CustomerAccount {
  id        BigInt   @id @default(autoincrement())
  party_id  BigInt   @unique
  hash      String?
  activo    Boolean  @default(true)
  creado_en DateTime @default(now()) @db.Timestamptz
  /// Celular de 9 dígitos: identidad de la cuenta. Único entre cuentas activas (índice parcial en la migración).
  telefono          String?   @db.VarChar(9)
  /// Sesiones emitidas antes de esta fecha ya no valen.
  clave_cambiada_en DateTime? @db.Timestamptz

  party     Party    @relation(fields: [party_id], references: [id])

  @@map("customer_account")
}

model PartyRole {
  id              BigInt          @id @default(autoincrement())
  party_id        BigInt
  rol             String          // CLIENTE | TRABAJADOR | PROVEEDOR
  desde           DateTime        @default(now()) @db.Date
  hasta           DateTime?       @db.Date

  party           Party           @relation(fields: [party_id], references: [id])
  customer_detail CustomerDetail?
  employee_detail EmployeeDetail?
  supplier_detail SupplierDetail?

  @@map("party_role")
}

model CustomerDetail {
  party_role_id BigInt   @id
  puntos        Decimal  @default(0) @db.Decimal(12, 2)
  envio_tipo    String?  // FIJO | PORCENTAJE
  envio_valor   Decimal? @db.Decimal(12, 2)

  party_role    PartyRole @relation(fields: [party_role_id], references: [id])

  @@map("customer_detail")
}

model Consent {
  id            BigInt    @id @default(autoincrement())
  party_id      BigInt
  version_texto String
  canal         String    // CARTA | CAJA | BOT | ADMIN
  aceptado_en   DateTime  @default(now()) @db.Timestamptz
  revocado_en   DateTime? @db.Timestamptz

  party         Party     @relation(fields: [party_id], references: [id])

  @@map("consent")
}

model ContactMechanism {
  id         BigInt       @id @default(autoincrement())
  party_id   BigInt
  tipo       String       // TELEFONO | WHATSAPP | CORREO | DIRECCION
  valor      String
  lat        Decimal?     @db.Decimal(9, 6)
  lng        Decimal?     @db.Decimal(9, 6)
  referencia String?
  zona_id    BigInt?
  principal  Boolean      @default(false)
  activo     Boolean      @default(true)

  party      Party        @relation(fields: [party_id], references: [id])
  zona       ZonaReparto? @relation(fields: [zona_id], references: [id])

  @@index([tipo, valor], map: "ix_contacto_valor")
  @@map("contact_mechanism")
}

model Oferta {
  id                   BigInt         @id @default(autoincrement())
  tipo                 String         // COMBO | LLEVA_PAGA | DESCUENTO | ENVIO_GRATIS
  nombre               String         @unique
  descripcion          String?
  lleva                Int?
  paga                 Int?
  alcance_categoria_id BigInt?
  // Varias categorías (descuento solo en ellas). alcance_categoria_id queda con la primera por compatibilidad
  alcance_categoria_ids BigInt[]      @default([])
  alcance_producto_id  BigInt?
  descuento_tipo       String?        // PORCENTAJE | MONTO
  descuento_valor      Decimal?       @db.Decimal(12, 2)
  compra_minima        Decimal?       @db.Decimal(12, 2)
  dias                 Int[]
  hora_desde           DateTime?      @db.Time
  hora_hasta           DateTime?      @db.Time
  fecha_desde          DateTime?      @db.Date
  fecha_hasta          DateTime?      @db.Date
  canales              String[]       @default(["CARTA", "ADMIN", "BOT"])
  limite_usos          Int?
  usos_actuales        Int            @default(0)
  no_suma_beneficios   Boolean        @default(false)
  orden                Int            @default(0)
  activo               Boolean        @default(false)
  creado_en            DateTime       @default(now()) @db.Timestamptz
  imagen_archivo_id    BigInt?
  // Se muestra en el saludo del chat de WhatsApp (solo una, la de menor orden, vigente hoy)
  mostrar_en_saludo_bot Boolean       @default(false)
  // Solo clientes con sesión iniciada en la carta cuyo celular nunca tuvo un pedido válido (no anulado)
  solo_primera_compra  Boolean        @default(false)
  // Se muestra en la carta virtual (no apaga el descuento: solo la vista de la promoción)
  visible_carta        Boolean        @default(true)

  categoria            Categoria?     @relation(fields: [alcance_categoria_id], references: [id])
  producto             Producto?      @relation(fields: [alcance_producto_id], references: [id])
  imagen_archivo       Archivo?       @relation(fields: [imagen_archivo_id], references: [id])
  combosPrecio         ComboPrecio[]
  combosParte          ComboParte[]
  pedidos              Pedido[]
  pedidoLineas         PedidoLinea[]

  @@map("oferta")
}

model ComboPrecio {
  oferta_id       BigInt
  tamano_valor_id BigInt
  precio          Decimal    @db.Decimal(12, 2)

  oferta          Oferta     @relation(fields: [oferta_id], references: [id], onDelete: Cascade)
  tamano_valor    ListaValor @relation(fields: [tamano_valor_id], references: [id])

  @@id([oferta_id, tamano_valor_id])
  @@map("combo_precio")
}

model ComboParte {
  id         BigInt   @id @default(autoincrement())
  oferta_id  BigInt
  tipo       String   // A_ELECCION | UNA_DE | FIJO
  cantidad   Int      @default(1)
  categorias BigInt[]
  productos  BigInt[]
  /// Tamaño de la parte FIJO de un solo producto (producto_tamano del producto); sin tamaño, null
  tamano_id  BigInt?
  /// Alternativas excluyentes («elige UNO de estos paquetes»): las partes con el mismo paquete_grupo (p. ej. «Complemento») se
  /// reparten en paquetes por paquete_nombre («2 donas», «1 carrot cake»...); el cliente elige un paquete. Ambas null = parte normal.
  paquete_grupo  String?
  paquete_nombre String?
  /// Sabores permitidos (sabor.id) en la parte; vacío = todos. Solo cuenta para productos por sabor.
  sabores_ids    BigInt[] @default([])
  /// Productos que NO entran en la parte aunque su categoría sí; vacío = ninguno.
  productos_excluidos_ids BigInt[] @default([])

  oferta     Oferta   @relation(fields: [oferta_id], references: [id], onDelete: Cascade)
  tamano     ProductoTamano? @relation(fields: [tamano_id], references: [id], onDelete: SetNull)
  reemplazos ComboParteReemplazo[]

  @@map("combo_parte")
}

/// Alternativas de una parte (plan B, C... o «si no hay stock, elige»): producto y cantidad que sustituyen la parte cuando no alcanza (mismo precio del combo)
model ComboParteReemplazo {
  id             BigInt @id @default(autoincrement())
  combo_parte_id BigInt
  producto_id    BigInt
  orden          Int    @default(0)
  cantidad       Int    @default(1)

  parte    ComboParte @relation(fields: [combo_parte_id], references: [id], onDelete: Cascade)
  producto Producto   @relation(fields: [producto_id], references: [id])

  @@unique([combo_parte_id, producto_id])
  @@index([combo_parte_id, orden])
  @@map("combo_parte_reemplazo")
}

model ReglaAcumulacion {
  id                      Int     @id @default(1)
  cupon_con_descuento     Boolean @default(false)
  promo_con_descuento     Boolean @default(false)
  cupones_por_comprobante Int     @default(2)
  texto_pie               String?

  @@map("regla_acumulacion")
}

model Cupon {
  id                 BigInt                  @id @default(autoincrement())
  modo               String                  // UNICO_COMPROBANTE | COMPARTIDO
  codigo_base        String                  @unique
  descripcion        String?
  descuento_tipo     String                  // PORCENTAJE | MONTO | ENVIO_GRATIS
  descuento_valor    Decimal                 @db.Decimal(12, 2)
  compra_minima      Decimal?                @db.Decimal(12, 2)
  categoria_id       BigInt?
  producto_id        BigInt?
  canales            String[]                @default(["CARTA", "CAJA", "BOT"])
  // Horario opcional (vacío = todo el tiempo): días 1..7, hora desde inclusiva y hasta exclusiva, fechas inclusivas
  dias               Int[]                   @default([])
  hora_desde         DateTime?               @db.Time
  hora_hasta         DateTime?               @db.Time
  fecha_desde        DateTime?               @db.Date
  fecha_hasta        DateTime?               @db.Date
  requiere_cuenta    Boolean                 @default(false)
  dias_validez       Int?                    @default(15)
  tope_usos          Int?
  usos_actuales      Int                     @default(0)
  max_por_cliente    Int?
  orden              Int                     @default(0)
  activo             Boolean                 @default(true)
  creado_en          DateTime                @default(now()) @db.Timestamptz

  categoria          Categoria?              @relation(fields: [categoria_id], references: [id])
  producto           Producto?               @relation(fields: [producto_id], references: [id])
  cuponesEmitidos    CuponEmitido[]
  canjesCompartidos  CuponCanjeCompartido[]
  pedidos            Pedido[]

  @@map("cupon")
}

model CuponEmitido {
  id                 BigInt    @id @default(autoincrement())
  cupon_id           BigInt
  codigo             String    @unique
  pedido_origen_id   BigInt?
  vence_en           DateTime? @db.Timestamptz
  estado             String    @default("VIGENTE") // VIGENTE | CANJEADO | VENCIDO | ANULADO
  canjeado_en        DateTime? @db.Timestamptz
  pedido_canje_id    BigInt?
  motivo_anulacion   String?
  anulado_en         DateTime? @db.Timestamptz
  anulado_por        BigInt?
  creado_en          DateTime  @default(now()) @db.Timestamptz

  cupon              Cupon     @relation(fields: [cupon_id], references: [id])
  pedidoOrigen       Pedido?   @relation("CuponesEmitidosOrigen", fields: [pedido_origen_id], references: [id])
  pedidoCanje        Pedido?   @relation("CuponesEmitidosCanje", fields: [pedido_canje_id], references: [id])
  pedidosQueUsaron   Pedido[]  @relation("PedidoCuponEmitido")

  @@map("cupon_emitido")
}

model CuponCanjeCompartido {
  cupon_id  BigInt
  pedido_id BigInt
  party_id  BigInt?
  en        DateTime @default(now()) @db.Timestamptz

  cupon     Cupon    @relation(fields: [cupon_id], references: [id])
  pedido    Pedido   @relation(fields: [pedido_id], references: [id])
  party     Party?   @relation(fields: [party_id], references: [id])

  @@id([cupon_id, pedido_id])
  @@map("cupon_canje_compartido")
}

model MovimientoPuntos {
  id        BigInt   @id @default(autoincrement())
  party_id  BigInt
  pedido_id BigInt?
  puntos    Decimal  @db.Decimal(12, 2)
  tipo      String   // SUMA | REVERSA | CANJE | DEVOLUCION_CANJE
  motivo    String?
  en        DateTime @default(now()) @db.Timestamptz

  party     Party    @relation(fields: [party_id], references: [id])
  pedido    Pedido?  @relation(fields: [pedido_id], references: [id])

  @@unique([pedido_id, tipo])
  @@map("movimiento_puntos")
}

// ---------- Fase Siguiente - Ola S2: Proveedores, compras, almacén, créditos, iniciativas, bot, TV, contenidos ----------

model Organization {
  party_id         BigInt  @id
  razon_social     String
  nombre_comercial String?

  party            Party   @relation(fields: [party_id], references: [id])

  @@map("organization")
}

model SupplierDetail {
  party_role_id BigInt    @id
  dias_credito  Int       @default(0)
  cuenta_pago   String?
  activo        Boolean   @default(true)

  party_role    PartyRole @relation(fields: [party_role_id], references: [id])

  @@map("supplier_detail")
}

model EmployeeDetail {
  party_role_id BigInt    @id
  descuento_pct Decimal?  @db.Decimal(5, 2)

  party_role    PartyRole @relation(fields: [party_role_id], references: [id])

  @@map("employee_detail")
}

model HorarioTrabajo {
  id         BigInt   @id @default(autoincrement())
  party_id   BigInt
  dia_semana Int      @db.SmallInt // 0 = Domingo, 1 = Lunes, etc.
  entrada    DateTime @db.Time
  salida     DateTime @db.Time
  activo     Boolean  @default(true)
  // Almuerzo programado (opcional). Ambos nulos = sin almuerzo programado.
  almuerzo_inicio DateTime? @db.Time
  almuerzo_fin    DateTime? @db.Time

  party      Party    @relation(fields: [party_id], references: [id])

  @@map("horario_trabajo")
}

// Reemplazo fijo por dia de la semana: valor por defecto cuando la persona no trabaja ese dia.
// La CoberturaTurno por fecha tiene prioridad sobre este valor.
model ReemplazoDia {
  id                 BigInt  @id @default(autoincrement())
  party_id           BigInt
  dia_semana         Int     @db.SmallInt // 0 = Domingo
  reemplaza_party_id BigInt
  activo             Boolean @default(true)

  party     Party @relation("ReemplazoDiaTitular", fields: [party_id], references: [id])
  reemplaza Party @relation("ReemplazoDiaSuplente", fields: [reemplaza_party_id], references: [id])

  @@unique([party_id, dia_semana])
  @@map("reemplazo_dia")
}

model CoberturaTurno {
  id                 BigInt    @id @default(autoincrement())
  fecha              DateTime  @db.Date
  cubre_party_id     BigInt
  reemplaza_party_id BigInt?
  desde              DateTime  @db.Time
  hasta              DateTime  @db.Time
  por                BigInt

  cubreParty         Party     @relation("CoberturasCubre", fields: [cubre_party_id], references: [id])
  reemplazaParty     Party?    @relation("CoberturasReemplaza", fields: [reemplaza_party_id], references: [id])

  @@map("cobertura_turno")
}

model PedidoProveedor {
  id                 BigInt                  @id @default(autoincrement())
  proveedor_party_id BigInt
  estado             String                  @default("POR_RECIBIR") // POR_RECIBIR | PARCIAL | RECIBIDO | ANULADO
  enviado_en         DateTime?               @default(now()) @db.Timestamptz
  motivo_anulacion   String?

  proveedor          Party                   @relation(fields: [proveedor_party_id], references: [id])
  lineas             PedidoProveedorLinea[]
  compras            Compra[]

  @@map("pedido_proveedor")
}

model PedidoProveedorLinea {
  pedido_proveedor_id BigInt
  insumo_id           BigInt
  cantidad_compra     Decimal         @db.Decimal(14, 3)
  recibido            Decimal         @default(0) @db.Decimal(14, 3)

  pedidoProveedor     PedidoProveedor @relation(fields: [pedido_proveedor_id], references: [id], onDelete: Cascade)
  insumo              Insumo          @relation(fields: [insumo_id], references: [id])

  @@id([pedido_proveedor_id, insumo_id])
  @@map("pedido_proveedor_linea")
}

model Compra {
  id                  BigInt           @id @default(autoincrement())
  proveedor_party_id  BigInt
  pedido_proveedor_id BigInt?
  comprobante_tipo    String           // FACTURA | BOLETA | NOTA_VENTA | GUIA | OTRO
  comprobante_numero  String
  archivo_id          BigInt?
  condicion           String           // CONTADO | CREDITO
  total               Decimal          @db.Decimal(12, 2)
  fecha_compra        DateTime         @default(now()) @db.Date
  nota                String?
  pagada_en           DateTime?        @db.Timestamptz
  pagada_por          BigInt?
  anulada_en          DateTime?        @db.Timestamptz
  motivo_anulacion    String?
  registrado_por      BigInt?
  registrado_en       DateTime         @default(now()) @db.Timestamptz

  proveedor           Party            @relation(fields: [proveedor_party_id], references: [id])
  pedidoProveedor     PedidoProveedor? @relation(fields: [pedido_proveedor_id], references: [id])
  archivo             Archivo?         @relation(fields: [archivo_id], references: [id])
  lineas              CompraLinea[]

  @@unique([proveedor_party_id, comprobante_tipo, comprobante_numero])
  @@map("compra")
}

model CompraLinea {
  id              BigInt   @id @default(autoincrement())
  compra_id       BigInt
  insumo_id       BigInt
  cantidad_compra Decimal  @db.Decimal(14, 3)
  costo_unit      Decimal  @db.Decimal(12, 4)

  compra          Compra   @relation(fields: [compra_id], references: [id], onDelete: Cascade)
  insumo          Insumo   @relation(fields: [insumo_id], references: [id])

  @@map("compra_linea")
}

model Traslado {
  id                BigInt         @id @default(autoincrement())
  insumo_id         BigInt
  destino_lugar_id  BigInt
  enviado           Decimal        @db.Decimal(14, 3)
  recibido          Decimal?       @db.Decimal(14, 3)
  diferencia        Decimal?       @db.Decimal(14, 3)
  estado            String         @default("POR_RECIBIR") // POR_RECIBIR | RECIBIDO
  pedido_interno_id BigInt?
  enviado_por       BigInt?
  enviado_en        DateTime       @default(now()) @db.Timestamptz
  recibido_por      BigInt?
  recibido_en       DateTime?      @db.Timestamptz
  nota              String?

  insumo            Insumo         @relation(fields: [insumo_id], references: [id])
  destinoLugar      LugarStock     @relation(fields: [destino_lugar_id], references: [id])
  pedidoInterno     PedidoInterno? @relation(fields: [pedido_interno_id], references: [id])

  @@map("traslado")
}

model PedidoInterno {
  id               BigInt      @id @default(autoincrement())
  area_id          BigInt
  detalle          Json
  estado           String      @default("PENDIENTE") // PENDIENTE | RECIBIDO | ENTREGADO | ANULADO
  por              BigInt
  en               DateTime    @default(now()) @db.Timestamptz
  avisado_party_id BigInt?
  recibido_por     BigInt?
  recibido_en      DateTime?   @db.Timestamptz
  entregado_por    BigInt?
  entregado_en     DateTime?   @db.Timestamptz

  area             AreaCocina  @relation(fields: [area_id], references: [id])
  avisadoParty     Party?      @relation(fields: [avisado_party_id], references: [id])
  traslados        Traslado[]

  @@map("pedido_interno")
}

model Produccion {
  id               BigInt    @id @default(autoincrement())
  receta_id        BigInt
  tandas           Decimal   @db.Decimal(8, 2)
  unidades         Decimal   @db.Decimal(14, 3)
  producido_en     DateTime  @default(now()) @db.Timestamptz
  por              BigInt
  anulado_en       DateTime? @db.Timestamptz
  motivo_anulacion String?

  receta           Receta    @relation(fields: [receta_id], references: [id])

  @@map("produccion")
}

model CierreDia {
  id       BigInt     @id @default(autoincrement())
  fecha    DateTime   @db.Date
  lugar_id BigInt
  detalle  Json
  por      BigInt
  en       DateTime   @default(now()) @db.Timestamptz

  lugar    LugarStock @relation(fields: [lugar_id], references: [id])

  @@unique([fecha, lugar_id])
  @@map("cierre_dia")
}

model ConsumoPersonal {
  id        BigInt   @id @default(autoincrement())
  party_id  BigInt
  fecha     DateTime @db.Date
  pedido_id BigInt   @unique
  monto     Decimal  @db.Decimal(12, 2)
  creado_en DateTime @default(now()) @db.Timestamptz

  party     Party    @relation(fields: [party_id], references: [id])
  pedido    Pedido   @relation(fields: [pedido_id], references: [id])

  @@map("consumo_personal")
}

model Iniciativa {
  id                  BigInt                 @id @default(autoincrement())
  codigo              String                 @unique // IN-0001
  tipo                String                 // QUEJA | MEJORA | IDEA
  area                String                 // CARTA_WEB | PEDIDOS_CAJA | COCINA | REPARTO | ALMACEN_COMPRAS | OTRO
  titulo              String                 // char_length <= 80
  detalle             String                 // char_length <= 600
  archivo_id          BigInt?
  estado              String                 @default("NUEVA") // NUEVA | EN_REVISION | HECHA | NO_POR_AHORA
  creado_en           DateTime               @default(now()) @db.Timestamptz
  creado_por          BigInt
  estado_cambiado_en  DateTime?              @db.Timestamptz
  estado_cambiado_por BigInt?

  archivo             Archivo?               @relation(fields: [archivo_id], references: [id])
  autor               UserAccount            @relation("IniciativasCreadas", fields: [creado_por], references: [id])
  revisor             UserAccount?           @relation("IniciativasCambiadas", fields: [estado_cambiado_por], references: [id])
  comentarios         IniciativaComentario[]

  @@index([estado, creado_en(sort: Desc)])
  @@map("iniciativa")
}

model IniciativaComentario {
  id            BigInt      @id @default(autoincrement())
  iniciativa_id BigInt
  texto         String      // char_length <= 400
  creado_en     DateTime    @default(now()) @db.Timestamptz
  creado_por    BigInt

  iniciativa    Iniciativa  @relation(fields: [iniciativa_id], references: [id], onDelete: Cascade)
  autor         UserAccount @relation(fields: [creado_por], references: [id])

  @@index([iniciativa_id, creado_en])
  @@map("iniciativa_comentario")
}

model Conversacion {
  id                 BigInt             @id @default(autoincrement())
  telefono           String             @unique
  party_id           BigInt?
  duenio             String             @default("BOT") // BOT | PERSONA
  tomado_por         BigInt?
  tomado_en          DateTime?          @db.Timestamptz
  urgente            Boolean            @default(false)
  estado             String             @default("ABIERTA") // ABIERTA | VALIDAR_PAGO | ATENDIDA
  flujo              Json?
  nombre_contacto    String?
  nombre_editado     Boolean            @default(false)
  identificador_tipo String             @default("TELEFONO") // TELEFONO | USUARIO_WA
  motivo_derivacion  String?
  ultima_actividad   DateTime           @default(now()) @db.Timestamptz
  /// phone_number_id de Meta del numero al que escribio el cliente; desde ese se le responde.
  phone_number_id    String?
  /// Ese mismo numero para mostrar (display_phone_number), p. ej. 51914244077.
  numero_receptor    String?
  /// Última vez que alguien del equipo abrió el chat: lo que el cliente escribió después está «sin ver»
  visto_en           DateTime?          @db.Timestamptz
  /// Marca manual «No visto» (como WhatsApp): compartida por todo el equipo hasta abrir el chat o «Marcar como visto»
  marcado_no_visto   Boolean            @default(false)
  /// Cuándo y quién (user_account.id) lo archivó con «Atendido». Contrato para la reanudación del bot a las 00:01 de Lima.
  atendido_en        DateTime?          @db.Timestamptz
  atendido_por       BigInt?

  party              Party?           @relation(fields: [party_id], references: [id])
  tomadoPorUsuario  UserAccount?       @relation(fields: [tomado_por], references: [id])
  mensajes           MensajeChat[]
  solicitudesReserva SolicitudReserva[]
  solicitudesCambio  SolicitudCambio[]
  whatsappMensajes   WhatsappMensaje[]
  ia_consumos        IaConsumo[]
  vouchers           VoucherPago[]

  @@index([atendido_en])
  @@map("conversacion")
}

model MensajeChat {
  id                  BigInt           @id @default(autoincrement())
  conversacion_id     BigInt
  direccion           String           // ENTRA | SALE
  autor               String           // CLIENTE | BOT | PERSONA
  tipo                String           // TEXTO | IMAGEN | AUDIO | BOTON | PLANTILLA | SISTEMA
  contenido           Json
  meta_id             String?          @unique
  whatsapp_mensaje_id BigInt?
  en                  DateTime         @default(now()) @db.Timestamptz

  conversacion        Conversacion     @relation(fields: [conversacion_id], references: [id], onDelete: Cascade)
  whatsappMensaje     WhatsappMensaje? @relation(fields: [whatsapp_mensaje_id], references: [id], onDelete: SetNull)

  @@index([whatsapp_mensaje_id])
  @@map("mensaje_chat")
}

model RespuestaRapida {
  id     BigInt  @id @default(autoincrement())
  titulo String  @unique
  texto  String
  activo Boolean @default(true)

  @@map("respuesta_rapida")
}

model SolicitudReserva {
  id              BigInt        @id @default(autoincrement())
  conversacion_id BigInt?
  personas        Int?
  hora            DateTime?     @db.Timestamptz
  estado          String        @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA
  reserva_id      BigInt?
  nombre          String?
  telefono        String?
  nota            String?
  motivo_rechazo  String?
  creado_en       DateTime      @default(now()) @db.Timestamptz

  conversacion    Conversacion? @relation(fields: [conversacion_id], references: [id])
  reserva         Reserva?      @relation(fields: [reserva_id], references: [id])

  @@map("solicitud_reserva")
}

model SolicitudCambio {
  id                BigInt        @id @default(autoincrement())
  pedido_id         BigInt
  conversacion_id   BigInt?
  tipo              String        // DIRECCION | PEDIDO | CANCELAR
  detalle           String?
  estado            String        @default("PENDIENTE") // PENDIENTE | ACEPTADA | RECHAZADA
  nueva_direccion   String?
  nueva_referencia  String?
  nueva_zona_id     BigInt?
  nueva_zona_nombre String?
  nuevo_envio       Decimal?      @db.Decimal(10, 2)
  recargo_envio     Decimal?      @db.Decimal(10, 2)
  lat               Decimal?      @db.Decimal(10, 7)
  lng               Decimal?      @db.Decimal(10, 7)
  decidido_por      BigInt?
  decidido_en       DateTime?     @db.Timestamptz
  motivo            String?
  creado_en         DateTime      @default(now()) @db.Timestamptz

  pedido            Pedido        @relation(fields: [pedido_id], references: [id])
  conversacion      Conversacion? @relation(fields: [conversacion_id], references: [id])

  @@map("solicitud_cambio")
}

model Encuesta {
  id            BigInt    @id @default(autoincrement())
  pedido_id     BigInt    @unique
  nota          Int?      @db.SmallInt
  comentario    String?
  derivada      Boolean   @default(false)
  enviada_en    DateTime? @db.Timestamptz
  respondida_en DateTime? @db.Timestamptz

  pedido        Pedido    @relation(fields: [pedido_id], references: [id])

  @@map("encuesta")
}

model Notificacion {
  id            BigInt    @id @default(autoincrement())
  tipo          String
  rol_destino   String?
  party_destino BigInt?
  titulo        String
  mensaje       String?
  enlace        String?
  leida_en      DateTime? @db.Timestamptz
  en            DateTime  @default(now()) @db.Timestamptz

  rol           Rol?      @relation(fields: [rol_destino], references: [codigo])
  party         Party?    @relation(fields: [party_destino], references: [id])

  @@map("notificacion")
}

/// Estado de lectura de cada notificación POR PERSONA (clave `n:<id>` o `c:<tipo>:<firma>`).
/// leida_en NULL = marcada como no leída de forma explícita (sobrescribe el leida_en heredado de notificacion).
model NotificacionLectura {
  party_id  BigInt
  clave     String
  leida_en  DateTime? @default(now()) @db.Timestamptz

  @@id([party_id, clave])
  @@index([party_id, leida_en])
  @@map("notificacion_lectura")
}

model VersionCarta {
  id            BigInt    @id @default(autoincrement())
  estado        String    // BORRADOR | PUBLICADA | ARCHIVADA
  organizacion  String    @default("SECCIONES") // SECCIONES | LISTA | TARJETAS
  decoracion    String?   // NINGUNO | HALLOWEEN | NAVIDAD | ANONUEVO | SANVALENTIN | MADRE | PADRE | PATRIAS | NINOS
  contenido     Json      // orden, destacados superiores, ocultos
  publicada_en  DateTime? @db.Timestamptz
  publicada_por BigInt?

  @@map("version_carta")
}

model Novedad {
  id           BigInt        @id @default(autoincrement())
  tipo         String        // PROMOCION | BANNER | VIDEO | FOTOS | EVENTO | AVISO
  titulo       String
  texto        String?
  tema         String?
  video_url    String?
  evento_fecha DateTime?     @db.Timestamptz
  evento_lugar String?
  desde        DateTime?     @db.Date
  hasta        DateTime?     @db.Date
  orden        Int           @default(0)
  activo       Boolean       @default(false)
  tamano       String        @default("MEDIANO") // CHICO | MEDIANO | GRANDE | ANCHO
  creado_en    DateTime      @default(now()) @db.Timestamptz

  fotos        NovedadFoto[]

  @@map("novedad")
}

model NovedadFoto {
  novedad_id BigInt
  archivo_id BigInt
  orden      Int?    @default(0)

  novedad    Novedad @relation(fields: [novedad_id], references: [id], onDelete: Cascade)
  archivo    Archivo @relation(fields: [archivo_id], references: [id])

  @@id([novedad_id, archivo_id])
  @@map("novedad_foto")
}

model Destacada {
  id                 BigInt          @id @default(autoincrement())
  titulo             String
  portada_archivo_id BigInt?
  orden              Int             @default(0)
  archivada          Boolean         @default(false)
  creado_en          DateTime        @default(now()) @db.Timestamptz

  portada_archivo    Archivo?        @relation(fields: [portada_archivo_id], references: [id])
  fotos              DestacadaFoto[]

  @@map("destacada")
}

model DestacadaFoto {
  destacada_id BigInt
  archivo_id   BigInt
  orden        Int?      @default(0)

  destacada    Destacada @relation(fields: [destacada_id], references: [id], onDelete: Cascade)
  archivo      Archivo   @relation(fields: [archivo_id], references: [id])

  @@id([destacada_id, archivo_id])
  @@map("destacada_foto")
}

model RankingMes {
  anio_mes    String   @db.Char(7)
  producto_id BigInt
  unidades    Int
  puesto      Int?     @db.SmallInt

  producto    Producto @relation(fields: [producto_id], references: [id])

  @@id([anio_mes, producto_id])
  @@map("ranking_mes")
}

model MensajeCarta {
  id           BigInt    @id @default(autoincrement())
  tipo         String    // COMENTARIO | SUGERENCIA | FELICITACION | QUEJA
  texto        String
  nombre       String?
  contacto     String?
  atendido_en  DateTime? @db.Timestamptz
  atendido_por BigInt?
  creado_en    DateTime  @default(now()) @db.Timestamptz

  @@map("mensaje_carta")
}

model DeviceKey {
  id               BigInt      @id @default(autoincrement())
  tipo             String      // AGENTE | TV
  nombre           String
  llave_hash       String      @unique
  area_id          BigInt?
  codigo_vinculo   String?     @unique
  codigo_expira_en DateTime?   @db.Timestamptz
  ultima_conexion  DateTime?   @db.Timestamptz
  activo           Boolean     @default(true)
  creado_en        DateTime    @default(now()) @db.Timestamptz
  ultimo_latido    DateTime?   @db.Timestamptz
  latido_version   String?
  latido_impresora String?
  latido_detalle   String?
  /// Datos de la computadora informados en el latido (IP de la red local separadas por coma, IP pública vista por el servidor, nombre y sistema)
  latido_ip_local    String?
  latido_ip_publica  String?
  latido_hostname    String?
  latido_sistema     String?
  /// Identidad estable de la PC (hash que informa el programa): reconoce la misma PC al volver a vincularla
  equipo_uid         String?
  /// PC antigua archivada (soft-delete auditado: no se borra historial)
  archivada_en       DateTime?   @db.Timestamptz
  /// El dueño eliminó la PC desde el panel (soft-delete auditado)
  eliminada_en       DateTime?   @db.Timestamptz
  /// Llave de la PC que la reemplazó al volver a vincularse
  reemplazada_por    BigInt?
  /// El dueño confirmó que NO es la misma PC que otra con igual nombre
  distinta_confirmada Boolean    @default(false)

  area             AreaCocina? @relation(fields: [area_id], references: [id])
  printJobs        PrintJob[]
  configImpresion  EquipoImpresionConfig?

  @@index([equipo_uid], map: "device_key_equipo_uid_idx")
  @@map("device_key")
}

model PrintJob {
  id                  BigInt      @id @default(autoincrement())
  pedido_id           BigInt?     // NULL = prueba de impresión (sin pedido real)
  area_id             BigInt?
  tipo                String      // ETIQUETA_GENERAL | ETIQUETA_AREA | ETIQUETA_BEBIDA
  clave_idempotencia  String?     @unique
  payload             Json        @default("{}")
  copia               Boolean     @default(false)
  estado              String      @default("PENDIENTE") // PENDIENTE | IMPRIMIENDO | IMPRESO | FALLIDO | VENCIDO (sin CHECK en BD: no requiere migracion)
  intentos            Int         @default(0)
  impresora           String?
  error               String?
  en                  DateTime    @default(now()) @db.Timestamptz
  creado_en           DateTime    @default(now()) @db.Timestamptz
  tomado_en           DateTime?   @db.Timestamptz
  impreso_en          DateTime?   @db.Timestamptz
  device_key_id       BigInt?
  /// Área del equipo que imprime (sticker por área). NULL = Caja (la etiquetera y ticketera de Caja).
  destino_area_id     BigInt?
  /// Computadora que imprime este trabajo según su configuración. NULL = ninguna PC lo imprime todavía (espera en cola).
  destino_equipo_id   BigInt?

  pedido              Pedido?     @relation(fields: [pedido_id], references: [id])
  area                AreaCocina? @relation(fields: [area_id], references: [id])
  destinoArea         AreaCocina? @relation("DestinoImpresion", fields: [destino_area_id], references: [id])
  deviceKey           DeviceKey?  @relation(fields: [device_key_id], references: [id])

  @@index([destino_area_id, estado])
  @@index([destino_equipo_id, estado])
  @@map("print_job")
}

/// Qué imprime cada computadora (cada PC manda). Una PC nueva: todo apagado y configurado = false (no recibe trabajos).
model EquipoImpresionConfig {
  device_key_id        BigInt    @id
  configurado          Boolean   @default(false)
  pausado              Boolean   @default(false)
  ticketera            Boolean   @default(false)
  etiquetera           Boolean   @default(false)
  ticket_pago          Boolean   @default(false)
  comanda_salon        Boolean   @default(false)
  comanda_areas        Json      @default("[]")
  sticker_general      Boolean   @default(false)
  sticker_areas        Json      @default("[]")
  sticker_bebida_areas Json      @default("[]")
  tamanos              Json      @default("{}")
  actualizado_en       DateTime  @default(now()) @db.Timestamptz
  actualizado_por      BigInt?

  deviceKey            DeviceKey @relation(fields: [device_key_id], references: [id], onDelete: Cascade)

