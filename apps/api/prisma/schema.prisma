datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Schema mínimo para inicializar el cliente de Prisma sin tablas de negocio (HU-CAP-178)
model ControlSistema {
  id             String   @id @default(uuid())
  clave          String   @unique
  valor          String
  actualizado_en DateTime @updatedAt

  @@map("sys_control")
}

// ---------- Ola 1: personas, acceso, auditoría y configuración (ADR-004, ADR-008, ADR-014) ----------

model Party {
  id                       BigInt                 @id @default(autoincrement())
  tipo                     String // PERSONA | ORGANIZACION
  estado                   String                 @default("ACTIVO")
  creado_en                DateTime               @default(now()) @db.Timestamptz
  persona                  Person?
  documentos               PartyIdentifier[]
  usuario                  UserAccount?
  sesiones                 Sesion[]
  vouchersReemplazadosPor  VoucherPago[]          @relation("VoucherReemplazadoPor")
  pedidos                  Pedido[]               @relation("ClientePedido")
  pedidosRepartidos        Pedido[]               @relation("RepartidorPedido")
  liquidaciones            Liquidacion[]          @relation("LiquidacionesRepartidor")
  comprobantesEmitidos     Comprobante[]          @relation("ComprobantesEmitidos")
  reclamosRespondidos      Reclamo[]              @relation("ReclamosRespondidos")
  cuentaCliente            CustomerAccount?
  roles                    PartyRole[]
  consentimientos          Consent[]
  contactos                ContactMechanism[]
  movimientosPuntos        MovimientoPuntos[]
  canjesCuponesCompartidos CuponCanjeCompartido[]
  organizacion             Organization?
  horariosTrabajo          HorarioTrabajo[]
  coberturasCubre          CoberturaTurno[]       @relation("CoberturasCubre")
  coberturasReemplaza      CoberturaTurno[]       @relation("CoberturasReemplaza")
  reemplazosDia            ReemplazoDia[]         @relation("ReemplazoDiaTitular")
  reemplazaDias            ReemplazoDia[]         @relation("ReemplazoDiaSuplente")
  pedidosProveedor         PedidoProveedor[]
  comprasProveedor         Compra[]
  pedidosInternosAvisados  PedidoInterno[]
  consumosPersonal         ConsumoPersonal[]
  conversaciones           Conversacion[]
  notificaciones           Notificacion[]
  dataRequests             DataRequest[]
  pedidosComoCliente       Pedido[]              @relation("ClienteIdentificadoPedido")
  direccionesCliente       ClienteDireccion[]

  @@map("party")
}

model Person {
  party_id        BigInt    @id
  nombres         String
  apellidos       String?
  cumple_dia      Int?      @db.SmallInt
  cumple_mes      Int?      @db.SmallInt
  correo          String?
  foto_archivo_id BigInt?
  party           Party     @relation(fields: [party_id], references: [id])

  @@map("person")
}

model PartyIdentifier {
  id       BigInt @id @default(autoincrement())
  party_id BigInt
  tipo     String // DNI | RUC | CE
  numero   String
  party    Party  @relation(fields: [party_id], references: [id])

  @@unique([tipo, numero])
  @@map("party_identifier")
}

model Rol {
  codigo         String         @id
  nombre         String
  permisos       RolPermiso[]
  usuarios       UserAccount[]
  notificaciones Notificacion[]

  @@map("rol")
}

model Permiso {
  id     BigInt       @id @default(autoincrement())
  modulo String
  accion String
  roles  RolPermiso[]

  @@unique([modulo, accion])
  @@map("permiso")
}

model RolPermiso {
  rol        String
  permiso_id BigInt
  r          Rol     @relation(fields: [rol], references: [codigo])
  permiso    Permiso @relation(fields: [permiso_id], references: [id])

  @@id([rol, permiso_id])
  @@map("rol_permiso")
}

model UserAccount {
  id                    BigInt                 @id @default(autoincrement())
  party_id              BigInt                 @unique
  rol                   String
  hash                  String
  debe_cambiar          Boolean                @default(true)
  pin_hash              String?                // OBSOLETO: El PIN fijo se retiró en favor del código rotativo general (supervisor_secreto). Se mantiene por compatibilidad histórica sin uso.
  activo                Boolean                @default(true)
  alta_en               DateTime               @default(now()) @db.Date
  alertas_whatsapp              Boolean                @default(false)
  alertas_whatsapp_confirmado_en DateTime?              @db.Timestamptz
  party                 Party                  @relation(fields: [party_id], references: [id])
  r                     Rol                    @relation(fields: [rol], references: [codigo])
  iniciativasCreadas    Iniciativa[]           @relation("IniciativasCreadas")
  iniciativasCambiadas  Iniciativa[]           @relation("IniciativasCambiadas")
  iniciativaComentarios IniciativaComentario[]
  conversacionesTomadas Conversacion[]

  @@map("user_account")
}

model Sesion {
  id           BigInt    @id @default(autoincrement())
  audiencia    String // ADMIN | CARTA
  party_id     BigInt
  refresh_hash String    @unique
  dispositivo  String?
  expira_en    DateTime  @db.Timestamptz
  revocada_en  DateTime? @db.Timestamptz
  party        Party     @relation(fields: [party_id], references: [id])

  @@map("sesion")
}

model Parametro {
  clave String @id
  valor Json

  @@map("parametro")
}

// Solo se inserta: los triggers de la migración encadenan el hash y bloquean update y delete.
model Auditoria {
  id            BigInt   @id @default(autoincrement())
  categoria     String // CAMBIO | ACCESO | LECTURA_SENSIBLE
  modulo        String
  accion        String
  resultado     String   @default("OK")
  entidad       String?
  entidad_id    BigInt?
  antes         Json?
  despues       Json?
  motivo        String?
  party_id      BigInt?
  con_pin_admin Boolean  @default(false)
  ip            String?  @db.Inet
  dispositivo   String?
  request_id    String?
  en            DateTime @default(now()) @db.Timestamptz
  hash_anterior Bytes?
  hash          Bytes    @default(dbgenerated("'\\x'::bytea"))

  @@index([en(sort: Desc), modulo, party_id], map: "ix_auditoria_busqueda")
  @@index([entidad, entidad_id], map: "ix_auditoria_entidad")
  @@map("auditoria")
}

// ---------- Ola 2: catálogo, local y archivos (FT-CAR-01, FT-CFG-01/02, ADR-012) ----------

model Lista {
  id      BigInt          @id @default(autoincrement())
  codigo  String          @unique
  nombre  String
  valores ListaValor[]
  grupos  GrupoOpciones[]

  @@map("lista")
}

model ListaValor {
  id              BigInt           @id @default(autoincrement())
  lista_id        BigInt
  nombre          String
  orden           Int              @default(0)
  activo          Boolean          @default(true)
  lista           Lista            @relation(fields: [lista_id], references: [id])
  productoTamanos ProductoTamano[]
  opciones        Opcion[]
  movimientosOrigen  MovimientoStock[] @relation("MovimientoStockOrigen")
  movimientosDestino MovimientoStock[] @relation("MovimientoStockDestino")
  recetas            Receta[]
  combosPrecio       ComboPrecio[]

  @@unique([lista_id, nombre])
  @@map("lista_valor")
}

model HorarioDia {
  dia_semana Int       @id @db.SmallInt
  abre       DateTime? @db.Time
  cierra     DateTime? @db.Time
  cerrado    Boolean   @default(false)

  @@map("horario_dia")
}

model FechaEspecial {
  fecha   DateTime  @id @db.Date
  cerrado Boolean
  abre    DateTime? @db.Time
  cierra  DateTime? @db.Time
  motivo  String?

  @@map("fecha_especial")
}

model Archivo {
  id                 BigInt             @id @default(autoincrement())
  ruta               String             @unique
  tipo_mime          String
  bytes              Int
  privado            Boolean            @default(false)
  foto_local         FotoLocal?
  productos          Producto[]
  incidentes         IncidenteEntrega[]
  compras            Compra[]
  iniciativas        Iniciativa[]
  novedadesFotos     NovedadFoto[]
  destacadasPortadas Destacada[]
  ofertasImagen      Oferta[]
  destacadasFotos    DestacadaFoto[]
  vouchers           VoucherPago[]

  @@map("archivo")
}

model FotoLocal {
  archivo_id BigInt  @id
  slot       String? @unique
  orden      Int     @default(0)
  activo     Boolean @default(true)
  archivo    Archivo @relation(fields: [archivo_id], references: [id])

  @@map("foto_local")
}

model AreaCocina {
  id              BigInt          @id @default(autoincrement())
  nombre          String          @unique
  propia          Boolean         @default(false)
  impresora       String?
  etiquetera      String?
  activo          Boolean         @default(true)
  categorias      Categoria[]
  pedidoLineas    PedidoLinea[]
  comandas        ComandaArea[]
  altasDemanda    AltaDemanda[]
  lugaresStock    LugarStock[]
  pedidosInternos PedidoInterno[]
  deviceKeys      DeviceKey[]
  printJobs       PrintJob[]

  @@map("area_cocina")
}

model Categoria {
  id             BigInt     @id @default(autoincrement())
  nombre         String     @unique
  lleva_opciones Boolean    @default(true)
  area_id        BigInt
  orden          Int        @default(0)
  oculta         Boolean    @default(false)
  area           AreaCocina @relation(fields: [area_id], references: [id])
  productos      Producto[]
  ofertasAlcance Oferta[]
  cuponesAlcance Cupon[]

  @@map("categoria")
}

model Producto {
  id                 BigInt           @id @default(autoincrement())
  categoria_id       BigInt
  nombre             String           @unique
  descripcion        String?
  foto_archivo_id    BigInt?
  precio             Decimal          @db.Decimal(12, 2)
  por_lote           Boolean          @default(false)
  vida_util_horas    Int?
  orden              Int              @default(0)
  oculto             Boolean          @default(false)
  agotado_hasta      DateTime?        @db.Timestamptz
  no_suma_beneficios Boolean          @default(false)
  // Cocina: resaltar la opción menos pedida (últimos 30 días) de cada grupo de este producto
  resaltar_opcion_menos_pedida Boolean @default(false)
  categoria          Categoria        @relation(fields: [categoria_id], references: [id])
  foto_archivo       Archivo?         @relation(fields: [foto_archivo_id], references: [id])
  tamanos            ProductoTamano[]
  grupos             ProductoGrupo[]
  sabores            Sabor[]
  pedidoLineas       PedidoLinea[]
  agotados           Agotado[]
  stocks             Stock[]
  movimientosStock   MovimientoStock[]
  recetas            Receta[]
  ofertasAlcance     Oferta[]
  comboReemplazos    ComboParteReemplazo[]
  cuponesAlcance     Cupon[]
  rankingsMes        RankingMes[]

  @@map("producto")
}

model ProductoTamano {
  id              BigInt        @id @default(autoincrement())
  producto_id     BigInt
  tamano_valor_id BigInt
  precio          Decimal       @db.Decimal(12, 2)
  activo          Boolean       @default(true)
  producto        Producto      @relation(fields: [producto_id], references: [id])
  tamano_valor    ListaValor    @relation(fields: [tamano_valor_id], references: [id])
  recetaLineas    RecetaLinea[]

  @@unique([producto_id, tamano_valor_id])
  @@map("producto_tamano")
}

model GrupoOpciones {
  id          BigInt          @id @default(autoincrement())
  nombre      String          @unique
  lista_id    BigInt?
  obligatorio Boolean         @default(false)
  minimo      Int             @default(0)
  maximo      Int             @default(1)
  activo      Boolean         @default(true)
  lista       Lista?          @relation(fields: [lista_id], references: [id])
  opciones    Opcion[]
  productos   ProductoGrupo[]

  @@map("grupo_opciones")
}

model Opcion {
  id            BigInt        @id @default(autoincrement())
  grupo_id      BigInt
  valor_id      BigInt
  precio_extra  Decimal       @default(0) @db.Decimal(12, 2)
  activo              Boolean              @default(true)
  agotado_hasta       DateTime?            @db.Timestamptz
  grupo               GrupoOpciones        @relation(fields: [grupo_id], references: [id])
  valor               ListaValor           @relation(fields: [valor_id], references: [id])
  pedidoLineaOpciones PedidoLineaOpcion[]
  agotados            Agotado[]
  ajustes             AjusteOpcion[]

  @@unique([grupo_id, valor_id])
  @@map("opcion")
}

model ProductoGrupo {
  id          BigInt        @id @default(autoincrement())
  producto_id BigInt
  grupo_id    BigInt
  orden       Int           @default(0)
  producto    Producto      @relation(fields: [producto_id], references: [id])
  grupo       GrupoOpciones @relation(fields: [grupo_id], references: [id])

  @@unique([producto_id, grupo_id])
  @@map("producto_grupo")
}

model Sabor {
  id            BigInt    @id @default(autoincrement())
  producto_id   BigInt
  nombre        String
  activo        Boolean   @default(true)
  agotado_hasta DateTime? @db.Timestamptz
  producto      Producto  @relation(fields: [producto_id], references: [id])
  agotados      Agotado[]

  @@unique([producto_id, nombre])
  @@map("sabor")
}

// ---------- Ola 3: zonas de reparto y pedidos de la carta (FT-DEL-01, FT-PED-01..03, DT-57) ----------

model ZonaReparto {
  id        BigInt             @id @default(autoincrement())
  codigo    String             @unique
  poligono  Json
  tarifa    Decimal            @db.Decimal(12, 2)
  activa    Boolean            @default(true)
  minutos_min Int?
  minutos_max Int?
  pedidos   Pedido[]
  contactos ContactMechanism[]
  direcciones ClienteDireccion[]

  @@map("zona_reparto")
}

model Pedido {
  id                     BigInt                  @id @default(autoincrement())
  codigo                 String                  @unique
  canal                  String                  @default("CARTA")
  modalidad              String
  estado                 String                  @default("COLA")
  party_id               BigInt?
  es_personal            Boolean                 @default(false)
  cliente_nombre         String?
  cliente_telefono       String?
  entrega_direccion      String?
  entrega_referencia     String?
  entrega_lat            Decimal?                @db.Decimal(9, 6)
  entrega_lng            Decimal?                @db.Decimal(9, 6)
  entrega_origen         String?
  zona_id                BigInt?
  pago_metodo            String?
  pago_estado            String?                 @default("PENDIENTE")
  pago_preferido         String?
  paga_con               Decimal?                @db.Decimal(12, 2)
  subtotal               Decimal                 @db.Decimal(12, 2)
  descuento              Decimal                 @default(0) @db.Decimal(12, 2)
  envio                  Decimal?                @db.Decimal(12, 2)
  total                  Decimal                 @db.Decimal(12, 2)
  comprobante_tipo       String                  @default("BOLETA")
  comprobante_doc        String?
  comprobante_razon      String?
  nota                   String?
  clave_idempotencia     String?                 @unique
  oferta_id              BigInt?
  cupon_id               BigInt?
  cupon_emitido_id       BigInt?
  descuento_detalle      Json?
  puntos_ganados         Decimal                 @default(0) @db.Decimal(12, 2)
  puntos_canjeados       Decimal                 @default(0) @db.Decimal(12, 2)
  pago_coordinado_en     DateTime?               @db.Timestamptz
  pago_coordinado_por    BigInt?
  despachado_en          DateTime?               @db.Timestamptz
  despachado_por         BigInt?
  confirmado_en          DateTime?               @db.Timestamptz
  confirmado_por         BigInt?
  pasa_cocina_en         DateTime?               @db.Timestamptz
  listo_en               DateTime?               @db.Timestamptz
  entregado_en           DateTime?               @db.Timestamptz
  anulado_en             DateTime?               @db.Timestamptz
  anulado_por            BigInt?
  motivo_anulacion       String?
  anulacion_aprobada_por BigInt?
  creado_en              DateTime                @default(now()) @db.Timestamptz
  eta_min                Int?
  eta_max                Int?
  // Cliente con cuenta identificado (carta, WhatsApp o DNI del mozo); null = invitado
  cliente_party_id       BigInt?
  // Reparto (Ola 4)
  repartidor_party_id    BigInt?
  tomado_en              DateTime?               @db.Timestamptz
  salio_en               DateTime?               @db.Timestamptz
  llego_en               DateTime?               @db.Timestamptz
  motivo_falla           String?
  // Salón (Ola 6)
  mesa_nombre            String?
  entregado_mesa_en      DateTime?               @db.Timestamptz

  party                  Party?                  @relation("ClientePedido", fields: [party_id], references: [id])
  repartidor             Party?                  @relation("RepartidorPedido", fields: [repartidor_party_id], references: [id])
  zona                   ZonaReparto?            @relation(fields: [zona_id], references: [id])
  oferta                 Oferta?                 @relation(fields: [oferta_id], references: [id])
  cupon                  Cupon?                  @relation(fields: [cupon_id], references: [id])
  cuponEmitido           CuponEmitido?           @relation("PedidoCuponEmitido", fields: [cupon_emitido_id], references: [id])
  lineas                 PedidoLinea[]
  historial              PedidoEstadoHistorial[]
  cobros                 Cobro[]
  incidentes             IncidenteEntrega[]
  mensajesReparto        MensajeReparto[]
  comandas               ComandaArea[]
  movimientosStock       MovimientoStock[]
  mesas                  PedidoMesa[]
  reservas               Reserva[]
  comprobante            Comprobante?
  reclamos               Reclamo[]
  cuponesEmitidosOrigen  CuponEmitido[]          @relation("CuponesEmitidosOrigen")
  cuponesEmitidosCanje   CuponEmitido[]          @relation("CuponesEmitidosCanje")
  cuponesCanjeCompartido CuponCanjeCompartido[]
  movimientosPuntos      MovimientoPuntos[]
  consumoPersonal        ConsumoPersonal?
  solicitudesCambio      SolicitudCambio[]
  encuesta               Encuesta?
  printJobs              PrintJob[]
  salientesWhatsapp      SalienteWhatsapp[]
  whatsappMensajes       WhatsappMensaje[]
  encuestaPosventa       EncuestaPosventa?
  quejasWhatsapp         QuejaWhatsapp[]
  vouchers               VoucherPago[]
  planPago               PedidoPagoPlan[]
  clienteIdentificado    Party?                 @relation("ClienteIdentificadoPedido", fields: [cliente_party_id], references: [id])

  @@index([cliente_party_id], map: "pedido_cliente_party_id_idx")
  @@map("pedido")
}

model ClienteDireccion {
  id            BigInt      @id @default(autoincrement())
  party_id      BigInt
  direccion     String
  referencia    String?
  lat           Decimal?    @db.Decimal(10, 7)
  lng           Decimal?    @db.Decimal(10, 7)
  zona_id       BigInt?
  origen        String // CARTA | MOZO | WHATSAPP | MAPA | ESCRITA
  alias         String?
  usos          Int         @default(1)
  ultimo_uso_en DateTime    @db.Timestamptz
  activo        Boolean     @default(true)
  creado_en     DateTime    @default(now()) @db.Timestamptz
  party         Party       @relation(fields: [party_id], references: [id])
  zona          ZonaReparto? @relation(fields: [zona_id], references: [id])

  @@index([party_id, activo, ultimo_uso_en(sort: Desc)], map: "cliente_direccion_party_activo_uso_idx")
  @@map("cliente_direccion")
}

model PedidoLinea {
  id               BigInt              @id @default(autoincrement())
  pedido_id        BigInt
  producto_id      BigInt?
  oferta_id        BigInt?
  linea_combo_id   BigInt?
  nombre           String
  tamano           String?
  opciones         Json                @default("[]")
  sabor            String?
  nota             String?
  cantidad         Int
  precio_unit      Decimal             @db.Decimal(12, 2)
  subtotal         Decimal?            @db.Decimal(12, 2)
  area_id          BigInt?
  adicional        Boolean             @default(false)
  nombres_persona  String[]
  pedido           Pedido              @relation(fields: [pedido_id], references: [id])
  producto         Producto?           @relation(fields: [producto_id], references: [id])
  oferta           Oferta?             @relation(fields: [oferta_id], references: [id])
  area             AreaCocina?         @relation(fields: [area_id], references: [id])
  lineaComboPadre  PedidoLinea?        @relation("ComboPartes", fields: [linea_combo_id], references: [id])
  lineasComboHijas PedidoLinea[]       @relation("ComboPartes")
  opcionesElegidas PedidoLineaOpcion[]

  @@map("pedido_linea")
}

model PedidoLineaOpcion {
  id              BigInt      @id @default(autoincrement())
  pedido_linea_id BigInt
  opcion_id       BigInt?
  grupo_nombre    String
  opcion_nombre   String
  precio_unit     Decimal     @default(0) @db.Decimal(12, 2)
  precio_extra    Decimal     @default(0) @db.Decimal(12, 2)
  nombre_persona  String?
  pedido_linea    PedidoLinea @relation(fields: [pedido_linea_id], references: [id])
  opcion          Opcion?     @relation(fields: [opcion_id], references: [id])

  @@map("pedido_linea_opcion")
}

model PedidoEstadoHistorial {
  id              BigInt   @id @default(autoincrement())
  pedido_id       BigInt
  estado_anterior String?
  estado_nuevo    String
  motivo          String?
  por_party_id    BigInt?
  en              DateTime @default(now()) @db.Timestamptz
  pedido          Pedido   @relation(fields: [pedido_id], references: [id])

  @@map("pedido_estado_historial")
}

model SecuenciaPedido {
  nombre String @id
  ultimo Int    @default(0)

  @@map("secuencia_pedido")
}

// ---------- Ola 4: caja, cobros, cierres y reparto ----------

model Caja {
  id          BigInt      @id @default(autoincrement())
  fecha       DateTime    @unique @db.Date
  apertura    Decimal     @default(0) @db.Decimal(12, 2)
  estado      String      @default("ABIERTA")
  abierta_por BigInt
  cerrada_por BigInt?
  cerrada_en  DateTime?   @db.Timestamptz

  cobros        Cobro[]
  movimientos   MovimientoCaja[]
  liquidaciones Liquidacion[]
  cierre        CierreCaja?
  conteos       ConteoCierre[]

  @@map("caja")
}

model Cobro {
  id               BigInt      @id @default(autoincrement())
  // Un pedido puede tener varios cobros, pero solo uno vigente (anulado_en IS NULL): índice único parcial
  // cobro_pedido_vigente_key, creado en la migración 20261024200000_cobro_anulado_conservado (Prisma no lo declara).
  pedido_id        BigInt
  caja_id          BigInt
  total            Decimal     @db.Decimal(12, 2)
  credito_personal Boolean     @default(false)
  cobrado_por      BigInt
  en               DateTime    @default(now()) @db.Timestamptz
  anulado_en       DateTime?   @db.Timestamptz
  anulado_por      BigInt?
  motivo_anulacion String?

  pedido           Pedido      @relation(fields: [pedido_id], references: [id])
  caja             Caja        @relation(fields: [caja_id], references: [id])
  pagos            CobroPago[]

  @@map("cobro")
}

model CobroPago {
  id       BigInt   @id @default(autoincrement())
  cobro_id BigInt
  medio    String
  monto    Decimal  @db.Decimal(12, 2)
  recibido Decimal? @db.Decimal(12, 2)
  vuelto   Decimal? @db.Decimal(12, 2)

  cobro    Cobro    @relation(fields: [cobro_id], references: [id])

  @@map("cobro_pago")
}

model MovimientoCaja {
  id               BigInt    @id @default(autoincrement())
  caja_id          BigInt
  tipo             String
  monto            Decimal   @db.Decimal(12, 2)
  motivo           String
  anulado_en       DateTime? @db.Timestamptz
  motivo_anulacion String?

  caja             Caja      @relation(fields: [caja_id], references: [id])

  @@map("movimiento_caja")
}

model Liquidacion {
  id                  BigInt   @id @default(autoincrement())
  caja_id             BigInt
  repartidor_party_id BigInt
  esperado            Decimal  @db.Decimal(12, 2)
  entregado           Decimal  @db.Decimal(12, 2)
  en                  DateTime @default(now()) @db.Timestamptz

  caja                Caja     @relation(fields: [caja_id], references: [id])
  repartidor          Party    @relation("LiquidacionesRepartidor", fields: [repartidor_party_id], references: [id])

  @@map("liquidacion")
}

model CierreCaja {
  caja_id      BigInt        @id
  conteo       Json
  resultado    String
  aprobado_por BigInt?
  nota         String?

  caja         Caja          @relation(fields: [caja_id], references: [id])
  medios       CierreMedio[]

  @@map("cierre_caja")
}

model ConteoCierre {
  caja_id   BigInt
  intento   Int      @db.SmallInt
  conteo    Json
  medios    Json
  resultado String
  por       BigInt
  en        DateTime @default(now()) @db.Timestamptz

  caja      Caja     @relation(fields: [caja_id], references: [id])

  @@id([caja_id, intento])
  @@map("conteo_cierre")
}

model CierreMedio {
  caja_id    BigInt
  medio      String
  sistema    Decimal    @db.Decimal(12, 2)
  visto      Decimal    @db.Decimal(12, 2)
  diferencia Decimal?   @default(dbgenerated("(visto - sistema)")) @db.Decimal(12, 2)

  cierre     CierreCaja @relation(fields: [caja_id], references: [caja_id])

  @@id([caja_id, medio])
  @@map("cierre_medio")
}

model IncidenteEntrega {
  id              BigInt    @id @default(autoincrement())
  pedido_id       BigInt
  motivo          String
  intento         Int
  en              DateTime  @default(now()) @db.Timestamptz
  cierre          String?
  recargo         Decimal?  @db.Decimal(12, 2)
  cerrado_por     BigInt?
  contactos       Json      @default("[]")
  foto_archivo_id BigInt?

  pedido          Pedido    @relation(fields: [pedido_id], references: [id])
  foto_archivo    Archivo?  @relation(fields: [foto_archivo_id], references: [id])

  @@map("incidente_entrega")
}

model MensajeReparto {
  pedido_id     BigInt
  numero        Int       @db.SmallInt
  enviado_en    DateTime  @default(now()) @db.Timestamptz
  respondido_en DateTime? @db.Timestamptz
  estado        String    @default("ENVIADO")

  pedido        Pedido    @relation(fields: [pedido_id], references: [id])

  @@id([pedido_id, numero])
  @@map("mensaje_reparto")
}

// ---------- Ola 5: cocina por áreas, stock y recetas (FT-COC-01..03, FT-STK-01..03) ----------

model ComandaArea {
  pedido_id     BigInt
  area_id       BigInt
  estado        String    @default("EN_COCINA") // EN_COCINA | DESPEJADA
  llego_en      DateTime  @default(now()) @db.Timestamptz
  despejada_en  DateTime? @db.Timestamptz
  despejada_por BigInt?
  devuelta_en   DateTime? @db.Timestamptz
  devuelta_por  BigInt?

  pedido Pedido     @relation(fields: [pedido_id], references: [id])
  area   AreaCocina @relation(fields: [area_id], references: [id])

  @@id([pedido_id, area_id])
  @@map("comanda_area")
}

model Agotado {
  id            BigInt    @id @default(autoincrement())
  producto_id   BigInt?
  opcion_id     BigInt?
  sabor_id      BigInt?
  tipo          String?   // PRODUCTO | SABOR | OPCION
  alcance       String    // HOY | HASTA_REACTIVAR | INDEFINIDO
  desde         DateTime  @default(now()) @db.Timestamptz
  hasta         DateTime? @db.Timestamptz
  reactivado_en DateTime? @db.Timestamptz
  por           BigInt

  producto Producto? @relation(fields: [producto_id], references: [id])
  opcion   Opcion?   @relation(fields: [opcion_id], references: [id])
  sabor    Sabor?    @relation(fields: [sabor_id], references: [id])

  @@map("agotado")
}

model AltaDemanda {
  id      BigInt      @id @default(autoincrement())
  minutos Int
  pausa   Boolean     @default(false)
  desde   DateTime    @default(now()) @db.Timestamptz
  hasta   DateTime?   @db.Timestamptz
  por     BigInt
  area_id BigInt?

  area AreaCocina? @relation(fields: [area_id], references: [id])

  @@map("alta_demanda")
}

model LugarStock {
  id               BigInt            @id @default(autoincrement())
  nombre           String            @unique
  tipo             String            // ALMACEN | AREA
  area_id          BigInt?
  area             AreaCocina?       @relation(fields: [area_id], references: [id])
  insumosConsumo   Insumo[]          @relation("InsumoLugarConsumo")
  stocks           Stock[]
  movimientos      MovimientoStock[]
  trasladosDestino Traslado[]
  cierresDia       CierreDia[]

  @@map("lugar_stock")
}

model Insumo {
  id                    BigInt                 @id @default(autoincrement())
  nombre                String                 @unique
  unidad_compra         String
  unidad_almacen        String
  unidad_receta         String
  factor_compra         Decimal                @db.Decimal(14, 3)
  factor_receta         Decimal                @db.Decimal(14, 6)
  minimo                Decimal                @db.Decimal(14, 3)
  intermedio            Decimal?               @db.Decimal(14, 3)
  maximo                Decimal                @db.Decimal(14, 3)
  lugar_consumo_id      BigInt?
  costo_unit            Decimal?               @db.Decimal(12, 4)
  proveedor_a           BigInt?
  proveedor_b           BigInt?
  proveedor_c           BigInt?
  activo                Boolean                @default(true)

  lugarConsumo          LugarStock?            @relation("InsumoLugarConsumo", fields: [lugar_consumo_id], references: [id])
  stocks                Stock[]
  movimientos           MovimientoStock[]
  recetaLineas          RecetaLinea[]
  ajustesOpcion         AjusteOpcion[]         @relation("AjusteInsumo")
  ajustesReemplaza      AjusteOpcion[]         @relation("AjusteReemplazaInsumo")
  pedidoProveedorLineas PedidoProveedorLinea[]
  compraLineas          CompraLinea[]
  traslados             Traslado[]

  @@map("insumo")
}

model Stock {
  id          BigInt      @id @default(autoincrement())
  insumo_id   BigInt?
  producto_id BigInt?
  lugar_id    BigInt
  cantidad    Decimal     @db.Decimal(14, 3)

  insumo      Insumo?     @relation(fields: [insumo_id], references: [id])
  producto    Producto?   @relation(fields: [producto_id], references: [id])
  lugar       LugarStock  @relation(fields: [lugar_id], references: [id])

  @@map("stock")
}

model MovimientoStock {
  id                    BigInt            @id @default(autoincrement())
  tipo                  String            // ENTRADA | SALIDA | AJUSTE | MERMA | DEVOLUCION | VENTA | PRODUCCION_CONSUMO | PRODUCCION_ALTA | TRASLADO_SALIDA | TRASLADO_ENTRADA | DIFERENCIA_CONTEO | ANULACION
  insumo_id             BigInt?
  producto_id           BigInt?
  lugar_id              BigInt
  cantidad              Decimal           @db.Decimal(14, 3)
  origen_valor_id       BigInt?
  destino_valor_id      BigInt?
  pedido_id             BigInt?
  produccion_id         BigInt?
  traslado_id           BigInt?
  compra_id             BigInt?
  nota                  String?
  movimiento_anulado_id BigInt?
  por                   BigInt
  en                    DateTime          @default(now()) @db.Timestamptz

  insumo                Insumo?           @relation(fields: [insumo_id], references: [id])
  producto              Producto?         @relation(fields: [producto_id], references: [id])
  lugar                 LugarStock        @relation(fields: [lugar_id], references: [id])
  origen_valor          ListaValor?       @relation("MovimientoStockOrigen", fields: [origen_valor_id], references: [id])
  destino_valor         ListaValor?       @relation("MovimientoStockDestino", fields: [destino_valor_id], references: [id])
  pedido                Pedido?           @relation(fields: [pedido_id], references: [id])
  movimientoAnulado     MovimientoStock?  @relation("MovimientosAnulados", fields: [movimiento_anulado_id], references: [id])
  movimientosRevertidos MovimientoStock[] @relation("MovimientosAnulados")

  @@map("movimiento_stock")
}

model Receta {
  id              BigInt        @id @default(autoincrement())
  producto_id     BigInt
  tamano_valor_id BigInt?
  es_produccion   Boolean       @default(false)
  rinde           Decimal?      @db.Decimal(14, 3)

  producto        Producto      @relation(fields: [producto_id], references: [id])
  tamano_valor    ListaValor?   @relation(fields: [tamano_valor_id], references: [id])
  lineas          RecetaLinea[]
  producciones    Produccion[]

  @@unique([producto_id, tamano_valor_id, es_produccion])
  @@map("receta")
}

model RecetaLinea {
  receta_id          BigInt
  insumo_id          BigInt
  cantidad           Decimal         @db.Decimal(14, 3)
  producto_tamano_id BigInt?

  receta             Receta          @relation(fields: [receta_id], references: [id])
  insumo             Insumo          @relation(fields: [insumo_id], references: [id])
  productoTamano     ProductoTamano? @relation(fields: [producto_tamano_id], references: [id])

  @@id([receta_id, insumo_id])
  @@map("receta_linea")
}

model AjusteOpcion {
  opcion_id           BigInt
  insumo_id           BigInt
  efecto              String          // SUMA | QUITA | REEMPLAZA
  reemplaza_insumo_id BigInt?
  cantidad            Decimal?        @db.Decimal(14, 3)

  opcion              Opcion          @relation(fields: [opcion_id], references: [id])
  insumo              Insumo          @relation("AjusteInsumo", fields: [insumo_id], references: [id])
  reemplazaInsumo     Insumo?         @relation("AjusteReemplazaInsumo", fields: [reemplaza_insumo_id], references: [id])

  @@id([opcion_id, insumo_id])
  @@map("ajuste_opcion")
}

// ---------- Ola 6: salón, plano, mesas y reservas (FT-SAL-01..03) ----------

model Piso {
  id               BigInt          @id @default(autoincrement())
  nombre           String
  activo           Boolean         @default(true)
  cuadricula_ancho Int
  cuadricula_alto  Int
  elementos        ElementoPlano[]

  @@map("piso")
}

model ElementoPlano {
  id           BigInt        @id @default(autoincrement())
  piso_id      BigInt
  tipo         String
  nombre       String?
  x            Int
  y            Int
  ancho        Int
  alto         Int
  numero       Int?
  asientos     Int?
  activo       Boolean       @default(true)

  piso         Piso          @relation(fields: [piso_id], references: [id])
  pedidosMesa  PedidoMesa[]
  reservasMesa ReservaMesa[]

  @@map("elemento_plano")
}

model Reserva {
  id                 BigInt        @id @default(autoincrement())
  nombre             String
  telefono           String
  personas           Int
  hora               DateTime      @db.Timestamptz
  tolerancia_min     Int
  estado             String        @default("ACTIVA")
  motivo_cancelacion String?
  pedido_id          BigInt?
  recordatorio_enviado Boolean     @default(false)
  origen             String        @default("LOCAL")
  nota               String?

  pedido             Pedido?            @relation(fields: [pedido_id], references: [id])
  mesas              ReservaMesa[]
  solicitudesReserva SolicitudReserva[]

  @@map("reserva")
}

model ReservaMesa {
  id         BigInt         @id @default(autoincrement())
  reserva_id BigInt
  mesa_id    BigInt?

  reserva    Reserva        @relation(fields: [reserva_id], references: [id], onDelete: Cascade)
  mesa       ElementoPlano? @relation(fields: [mesa_id], references: [id], onDelete: SetNull)

  @@map("reserva_mesa")
}

model PedidoMesa {
  id          BigInt         @id @default(autoincrement())
  pedido_id   BigInt
  mesa_id     BigInt?
  mesa_nombre String?
  abierta     Boolean        @default(true)

  pedido      Pedido         @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  mesa        ElementoPlano? @relation(fields: [mesa_id], references: [id], onDelete: SetNull)

  @@map("pedido_mesa")
}

// ---------- Ola 7: comprobantes y obligaciones legales (FT-LEG-01, FT-LEG-02) ----------

model Comprobante {
  id                 BigInt    @id @default(autoincrement())
  pedido_id          BigInt    @unique
  tipo               String    // NOTA_VENTA | BOLETA | FACTURA
  serie              String
  numero             Int
  numero_texto       String    @unique
  documento          String?
  razon_social       String?
  emision            String    @default("POR_EMITIR") // INTERNA | POR_EMITIR | EMITIDO
  emitido_en         DateTime? @db.Timestamptz
  emitido_por        BigInt?
  referencia_externa String?
  copias_impresas    Int       @default(0)
  creado_en          DateTime  @default(now()) @db.Timestamptz

  pedido             Pedido    @relation(fields: [pedido_id], references: [id])
  emitidoPor         Party?    @relation("ComprobantesEmitidos", fields: [emitido_por], references: [id])

  @@unique([serie, numero])
  @@map("comprobante")
}

model SecuenciaComprobante {
  serie         String @id
  ultimo_numero Int    @default(0)

  @@map("secuencia_comprobante")
}

model Reclamo {
  id                    BigInt    @id @default(autoincrement())
  numero                String    @unique
  tipo                  String    // RECLAMO | QUEJA
  nombre                String
  documento             String
  domicilio             String
  telefono              String
  correo                String?
  pedido_id             BigInt?
  detalle               String
  monto_reclamado       Decimal?  @db.Decimal(12, 2)
  estado                String    @default("RECIBIDO") // RECIBIDO | EN_REVISION | RESPONDIDO
  respuesta             String?
  respondido_por        BigInt?
  respondido_en         DateTime? @db.Timestamptz
  fecha_limite          DateTime  @db.Date
  aceptacion_privacidad Boolean   @default(true)
  aceptado_en           DateTime  @default(now()) @db.Timestamptz
  creado_en             DateTime  @default(now()) @db.Timestamptz

  pedido                Pedido?   @relation(fields: [pedido_id], references: [id])
  respondidoPor         Party?    @relation("ReclamosRespondidos", fields: [respondido_por], references: [id])

  @@map("reclamo")
}

// ---------- Fase Siguiente - Ola S1: Promociones, ofertas, cupones y cuenta del cliente ----------

model CustomerAccount {
  id        BigInt   @id @default(autoincrement())
  party_id  BigInt   @unique
  hash      String?
  activo    Boolean  @default(true)
  creado_en DateTime @default(now()) @db.Timestamptz
  /// Celular de 9 dígitos: identidad de la cuenta. Único entre cuentas activas (índice parcial en la migración).
  telefono          String?   @db.VarChar(9)
  /// Sesiones emitidas antes de esta fecha ya no valen.
  clave_cambiada_en DateTime? @db.Timestamptz

  party     Party    @relation(fields: [party_id], references: [id])

  @@map("customer_account")
}

model PartyRole {
  id              BigInt          @id @default(autoincrement())
  party_id        BigInt
  rol             String          // CLIENTE | TRABAJADOR | PROVEEDOR
  desde           DateTime        @default(now()) @db.Date
  hasta           DateTime?       @db.Date

  party           Party           @relation(fields: [party_id], references: [id])
  customer_detail CustomerDetail?
  employee_detail EmployeeDetail?
  supplier_detail SupplierDetail?

  @@map("party_role")
}

model CustomerDetail {
  party_role_id BigInt   @id
  puntos        Decimal  @default(0) @db.Decimal(12, 2)
  envio_tipo    String?  // FIJO | PORCENTAJE
  envio_valor   Decimal? @db.Decimal(12, 2)

  party_role    PartyRole @relation(fields: [party_role_id], references: [id])

  @@map("customer_detail")
}

model Consent {
  id            BigInt    @id @default(autoincrement())
  party_id      BigInt
  version_texto String
  canal         String    // CARTA | CAJA | BOT | ADMIN
  aceptado_en   DateTime  @default(now()) @db.Timestamptz
  revocado_en   DateTime? @db.Timestamptz

  party         Party     @relation(fields: [party_id], references: [id])

  @@map("consent")
}

model ContactMechanism {
  id         BigInt       @id @default(autoincrement())
  party_id   BigInt
  tipo       String       // TELEFONO | WHATSAPP | CORREO | DIRECCION
  valor      String
  lat        Decimal?     @db.Decimal(9, 6)
  lng        Decimal?     @db.Decimal(9, 6)
  referencia String?
  zona_id    BigInt?
  principal  Boolean      @default(false)
  activo     Boolean      @default(true)

  party      Party        @relation(fields: [party_id], references: [id])
  zona       ZonaReparto? @relation(fields: [zona_id], references: [id])

  @@index([tipo, valor], map: "ix_contacto_valor")
  @@map("contact_mechanism")
}

model Oferta {
  id                   BigInt         @id @default(autoincrement())
  tipo                 String         // COMBO | LLEVA_PAGA | DESCUENTO
  nombre               String         @unique
  descripcion          String?
  lleva                Int?
  paga                 Int?
  alcance_categoria_id BigInt?
  alcance_producto_id  BigInt?
  descuento_tipo       String?        // PORCENTAJE | MONTO
  descuento_valor      Decimal?       @db.Decimal(12, 2)
  compra_minima        Decimal?       @db.Decimal(12, 2)
  dias                 Int[]
  hora_desde           DateTime?      @db.Time
  hora_hasta           DateTime?      @db.Time
  fecha_desde          DateTime?      @db.Date
  fecha_hasta          DateTime?      @db.Date
  canales              String[]       @default(["CARTA", "ADMIN", "BOT"])
  limite_usos          Int?
  usos_actuales        Int            @default(0)
  no_suma_beneficios   Boolean        @default(false)
  orden                Int            @default(0)
  activo               Boolean        @default(false)
  creado_en            DateTime       @default(now()) @db.Timestamptz
  imagen_archivo_id    BigInt?

  categoria            Categoria?     @relation(fields: [alcance_categoria_id], references: [id])
  producto             Producto?      @relation(fields: [alcance_producto_id], references: [id])
  imagen_archivo       Archivo?       @relation(fields: [imagen_archivo_id], references: [id])
  combosPrecio         ComboPrecio[]
  combosParte          ComboParte[]
  pedidos              Pedido[]
  pedidoLineas         PedidoLinea[]

  @@map("oferta")
}

model ComboPrecio {
  oferta_id       BigInt
  tamano_valor_id BigInt
  precio          Decimal    @db.Decimal(12, 2)

  oferta          Oferta     @relation(fields: [oferta_id], references: [id], onDelete: Cascade)
  tamano_valor    ListaValor @relation(fields: [tamano_valor_id], references: [id])

  @@id([oferta_id, tamano_valor_id])
  @@map("combo_precio")
}

model ComboParte {
  id         BigInt   @id @default(autoincrement())
  oferta_id  BigInt
  tipo       String   // A_ELECCION | UNA_DE | FIJO
  cantidad   Int      @default(1)
  categorias BigInt[]
  productos  BigInt[]

  oferta     Oferta   @relation(fields: [oferta_id], references: [id], onDelete: Cascade)
  reemplazos ComboParteReemplazo[]

  @@map("combo_parte")
}

/// Plan B, plan C...: productos que reemplazan al principal de una parte FIJO cuando se agota (mismo precio del combo)
model ComboParteReemplazo {
  id             BigInt @id @default(autoincrement())
  combo_parte_id BigInt
  producto_id    BigInt
  orden          Int    @default(0)

  parte    ComboParte @relation(fields: [combo_parte_id], references: [id], onDelete: Cascade)
  producto Producto   @relation(fields: [producto_id], references: [id])

  @@unique([combo_parte_id, producto_id])
  @@index([combo_parte_id, orden])
  @@map("combo_parte_reemplazo")
}

model ReglaAcumulacion {
  id                      Int     @id @default(1)
  cupon_con_descuento     Boolean @default(false)
  promo_con_descuento     Boolean @default(false)
  cupones_por_comprobante Int     @default(2)
  texto_pie               String?

  @@map("regla_acumulacion")
}

model Cupon {
  id                 BigInt                  @id @default(autoincrement())
  modo               String                  // UNICO_COMPROBANTE | COMPARTIDO
  codigo_base        String                  @unique
  descripcion        String?
  descuento_tipo     String                  // PORCENTAJE | MONTO
  descuento_valor    Decimal                 @db.Decimal(12, 2)
  compra_minima      Decimal?                @db.Decimal(12, 2)
  categoria_id       BigInt?
  producto_id        BigInt?
  canales            String[]                @default(["CARTA", "CAJA", "BOT"])
  requiere_cuenta    Boolean                 @default(false)
  dias_validez       Int?                    @default(15)
  tope_usos          Int?
  usos_actuales      Int                     @default(0)
  max_por_cliente    Int?
  orden              Int                     @default(0)
  activo             Boolean                 @default(true)
  creado_en          DateTime                @default(now()) @db.Timestamptz

  categoria          Categoria?              @relation(fields: [categoria_id], references: [id])
  producto           Producto?               @relation(fields: [producto_id], references: [id])
  cuponesEmitidos    CuponEmitido[]
  canjesCompartidos  CuponCanjeCompartido[]
  pedidos            Pedido[]

  @@map("cupon")
}

model CuponEmitido {
  id                 BigInt    @id @default(autoincrement())
  cupon_id           BigInt
  codigo             String    @unique
  pedido_origen_id   BigInt?
  vence_en           DateTime? @db.Timestamptz
  estado             String    @default("VIGENTE") // VIGENTE | CANJEADO | VENCIDO | ANULADO
  canjeado_en        DateTime? @db.Timestamptz
  pedido_canje_id    BigInt?
  motivo_anulacion   String?
  anulado_en         DateTime? @db.Timestamptz
  anulado_por        BigInt?
  creado_en          DateTime  @default(now()) @db.Timestamptz

  cupon              Cupon     @relation(fields: [cupon_id], references: [id])
  pedidoOrigen       Pedido?   @relation("CuponesEmitidosOrigen", fields: [pedido_origen_id], references: [id])
  pedidoCanje        Pedido?   @relation("CuponesEmitidosCanje", fields: [pedido_canje_id], references: [id])
  pedidosQueUsaron   Pedido[]  @relation("PedidoCuponEmitido")

  @@map("cupon_emitido")
}

model CuponCanjeCompartido {
  cupon_id  BigInt
  pedido_id BigInt
  party_id  BigInt?
  en        DateTime @default(now()) @db.Timestamptz

  cupon     Cupon    @relation(fields: [cupon_id], references: [id])
  pedido    Pedido   @relation(fields: [pedido_id], references: [id])
  party     Party?   @relation(fields: [party_id], references: [id])

  @@id([cupon_id, pedido_id])
  @@map("cupon_canje_compartido")
}

model MovimientoPuntos {
  id        BigInt   @id @default(autoincrement())
  party_id  BigInt
  pedido_id BigInt?
  puntos    Decimal  @db.Decimal(12, 2)
  tipo      String   // SUMA | REVERSA | CANJE | DEVOLUCION_CANJE
  motivo    String?
  en        DateTime @default(now()) @db.Timestamptz

  party     Party    @relation(fields: [party_id], references: [id])
  pedido    Pedido?  @relation(fields: [pedido_id], references: [id])

  @@unique([pedido_id, tipo])
  @@map("movimiento_puntos")
}

// ---------- Fase Siguiente - Ola S2: Proveedores, compras, almacén, créditos, iniciativas, bot, TV, contenidos ----------

model Organization {
  party_id         BigInt  @id
  razon_social     String
  nombre_comercial String?

  party            Party   @relation(fields: [party_id], references: [id])

  @@map("organization")
}

model SupplierDetail {
  party_role_id BigInt    @id
  dias_credito  Int       @default(0)
  cuenta_pago   String?
  activo        Boolean   @default(true)

  party_role    PartyRole @relation(fields: [party_role_id], references: [id])

  @@map("supplier_detail")
}

model EmployeeDetail {
  party_role_id BigInt    @id
  descuento_pct Decimal?  @db.Decimal(5, 2)

  party_role    PartyRole @relation(fields: [party_role_id], references: [id])

  @@map("employee_detail")
}

model HorarioTrabajo {
  id         BigInt   @id @default(autoincrement())
  party_id   BigInt
  dia_semana Int      @db.SmallInt // 0 = Domingo, 1 = Lunes, etc.
  entrada    DateTime @db.Time
  salida     DateTime @db.Time
  activo     Boolean  @default(true)

  party      Party    @relation(fields: [party_id], references: [id])

  @@map("horario_trabajo")
}

// Reemplazo fijo por dia de la semana: valor por defecto cuando la persona no trabaja ese dia.
// La CoberturaTurno por fecha tiene prioridad sobre este valor.
model ReemplazoDia {
  id                 BigInt  @id @default(autoincrement())
  party_id           BigInt
  dia_semana         Int     @db.SmallInt // 0 = Domingo
  reemplaza_party_id BigInt
  activo             Boolean @default(true)

  party     Party @relation("ReemplazoDiaTitular", fields: [party_id], references: [id])
  reemplaza Party @relation("ReemplazoDiaSuplente", fields: [reemplaza_party_id], references: [id])

  @@unique([party_id, dia_semana])
  @@map("reemplazo_dia")
}

model CoberturaTurno {
  id                 BigInt    @id @default(autoincrement())
  fecha              DateTime  @db.Date
  cubre_party_id     BigInt
  reemplaza_party_id BigInt?
  desde              DateTime  @db.Time
  hasta              DateTime  @db.Time
  por                BigInt

  cubreParty         Party     @relation("CoberturasCubre", fields: [cubre_party_id], references: [id])
  reemplazaParty     Party?    @relation("CoberturasReemplaza", fields: [reemplaza_party_id], references: [id])

  @@map("cobertura_turno")
}

model PedidoProveedor {
  id                 BigInt                  @id @default(autoincrement())
  proveedor_party_id BigInt
  estado             String                  @default("POR_RECIBIR") // POR_RECIBIR | PARCIAL | RECIBIDO | ANULADO
  enviado_en         DateTime?               @default(now()) @db.Timestamptz
  motivo_anulacion   String?

  proveedor          Party                   @relation(fields: [proveedor_party_id], references: [id])
  lineas             PedidoProveedorLinea[]
  compras            Compra[]

  @@map("pedido_proveedor")
}

model PedidoProveedorLinea {
  pedido_proveedor_id BigInt
  insumo_id           BigInt
  cantidad_compra     Decimal         @db.Decimal(14, 3)
  recibido            Decimal         @default(0) @db.Decimal(14, 3)

  pedidoProveedor     PedidoProveedor @relation(fields: [pedido_proveedor_id], references: [id], onDelete: Cascade)
  insumo              Insumo          @relation(fields: [insumo_id], references: [id])

  @@id([pedido_proveedor_id, insumo_id])
  @@map("pedido_proveedor_linea")
}

model Compra {
  id                  BigInt           @id @default(autoincrement())
  proveedor_party_id  BigInt
  pedido_proveedor_id BigInt?
  comprobante_tipo    String           // FACTURA | BOLETA | NOTA_VENTA | GUIA | OTRO
  comprobante_numero  String
  archivo_id          BigInt?
  condicion           String           // CONTADO | CREDITO
  total               Decimal          @db.Decimal(12, 2)
  fecha_compra        DateTime         @default(now()) @db.Date
  nota                String?
  pagada_en           DateTime?        @db.Timestamptz
  pagada_por          BigInt?
  anulada_en          DateTime?        @db.Timestamptz
  motivo_anulacion    String?
  registrado_por      BigInt?
  registrado_en       DateTime         @default(now()) @db.Timestamptz

  proveedor           Party            @relation(fields: [proveedor_party_id], references: [id])
  pedidoProveedor     PedidoProveedor? @relation(fields: [pedido_proveedor_id], references: [id])
  archivo             Archivo?         @relation(fields: [archivo_id], references: [id])
  lineas              CompraLinea[]

  @@unique([proveedor_party_id, comprobante_tipo, comprobante_numero])
  @@map("compra")
}

model CompraLinea {
  id              BigInt   @id @default(autoincrement())
  compra_id       BigInt
  insumo_id       BigInt
  cantidad_compra Decimal  @db.Decimal(14, 3)
  costo_unit      Decimal  @db.Decimal(12, 4)

  compra          Compra   @relation(fields: [compra_id], references: [id], onDelete: Cascade)
  insumo          Insumo   @relation(fields: [insumo_id], references: [id])

  @@map("compra_linea")
}

model Traslado {
  id                BigInt         @id @default(autoincrement())
  insumo_id         BigInt
  destino_lugar_id  BigInt
  enviado           Decimal        @db.Decimal(14, 3)
  recibido          Decimal?       @db.Decimal(14, 3)
  diferencia        Decimal?       @db.Decimal(14, 3)
  estado            String         @default("POR_RECIBIR") // POR_RECIBIR | RECIBIDO
  pedido_interno_id BigInt?
  enviado_por       BigInt?
  enviado_en        DateTime       @default(now()) @db.Timestamptz
  recibido_por      BigInt?
  recibido_en       DateTime?      @db.Timestamptz
  nota              String?

  insumo            Insumo         @relation(fields: [insumo_id], references: [id])
  destinoLugar      LugarStock     @relation(fields: [destino_lugar_id], references: [id])
  pedidoInterno     PedidoInterno? @relation(fields: [pedido_interno_id], references: [id])

  @@map("traslado")
}

model PedidoInterno {
  id               BigInt      @id @default(autoincrement())
  area_id          BigInt
  detalle          Json
  estado           String      @default("PENDIENTE") // PENDIENTE | RECIBIDO | ENTREGADO | ANULADO
  por              BigInt
  en               DateTime    @default(now()) @db.Timestamptz
  avisado_party_id BigInt?
  recibido_por     BigInt?
  recibido_en      DateTime?   @db.Timestamptz
  entregado_por    BigInt?
  entregado_en     DateTime?   @db.Timestamptz

  area             AreaCocina  @relation(fields: [area_id], references: [id])
  avisadoParty     Party?      @relation(fields: [avisado_party_id], references: [id])
  traslados        Traslado[]

  @@map("pedido_interno")
}

model Produccion {
  id               BigInt    @id @default(autoincrement())
  receta_id        BigInt
  tandas           Decimal   @db.Decimal(8, 2)
  unidades         Decimal   @db.Decimal(14, 3)
  producido_en     DateTime  @default(now()) @db.Timestamptz
  por              BigInt
  anulado_en       DateTime? @db.Timestamptz
  motivo_anulacion String?

  receta           Receta    @relation(fields: [receta_id], references: [id])

  @@map("produccion")
}

model CierreDia {
  id       BigInt     @id @default(autoincrement())
  fecha    DateTime   @db.Date
  lugar_id BigInt
  detalle  Json
  por      BigInt
  en       DateTime   @default(now()) @db.Timestamptz

  lugar    LugarStock @relation(fields: [lugar_id], references: [id])

  @@unique([fecha, lugar_id])
  @@map("cierre_dia")
}

model ConsumoPersonal {
  id        BigInt   @id @default(autoincrement())
  party_id  BigInt
  fecha     DateTime @db.Date
  pedido_id BigInt   @unique
  monto     Decimal  @db.Decimal(12, 2)
  creado_en DateTime @default(now()) @db.Timestamptz

  party     Party    @relation(fields: [party_id], references: [id])
  pedido    Pedido   @relation(fields: [pedido_id], references: [id])

  @@map("consumo_personal")
}

model Iniciativa {
  id                  BigInt                 @id @default(autoincrement())
  codigo              String                 @unique // IN-0001
  tipo                String                 // QUEJA | MEJORA | IDEA
  area                String                 // CARTA_WEB | PEDIDOS_CAJA | COCINA | REPARTO | ALMACEN_COMPRAS | OTRO
  titulo              String                 // char_length <= 80
  detalle             String                 // char_length <= 600
  archivo_id          BigInt?
  estado              String                 @default("NUEVA") // NUEVA | EN_REVISION | HECHA | NO_POR_AHORA
  creado_en           DateTime               @default(now()) @db.Timestamptz
  creado_por          BigInt
  estado_cambiado_en  DateTime?              @db.Timestamptz
  estado_cambiado_por BigInt?

  archivo             Archivo?               @relation(fields: [archivo_id], references: [id])
  autor               UserAccount            @relation("IniciativasCreadas", fields: [creado_por], references: [id])
  revisor             UserAccount?           @relation("IniciativasCambiadas", fields: [estado_cambiado_por], references: [id])
  comentarios         IniciativaComentario[]

  @@index([estado, creado_en(sort: Desc)])
  @@map("iniciativa")
}

model IniciativaComentario {
  id            BigInt      @id @default(autoincrement())
  iniciativa_id BigInt
  texto         String      // char_length <= 400
  creado_en     DateTime    @default(now()) @db.Timestamptz
  creado_por    BigInt

  iniciativa    Iniciativa  @relation(fields: [iniciativa_id], references: [id], onDelete: Cascade)
  autor         UserAccount @relation(fields: [creado_por], references: [id])

  @@index([iniciativa_id, creado_en])
  @@map("iniciativa_comentario")
}

model Conversacion {
  id                 BigInt             @id @default(autoincrement())
  telefono           String             @unique
  party_id           BigInt?
  duenio             String             @default("BOT") // BOT | PERSONA
  tomado_por         BigInt?
  tomado_en          DateTime?          @db.Timestamptz
  urgente            Boolean            @default(false)
  estado             String             @default("ABIERTA") // ABIERTA | VALIDAR_PAGO | ATENDIDA
  flujo              Json?
  nombre_contacto    String?
  nombre_editado     Boolean            @default(false)
  identificador_tipo String             @default("TELEFONO") // TELEFONO | USUARIO_WA
  motivo_derivacion  String?
  ultima_actividad   DateTime           @default(now()) @db.Timestamptz

  party              Party?             @relation(fields: [party_id], references: [id])
  tomadoPorUsuario   UserAccount?       @relation(fields: [tomado_por], references: [id])
  mensajes           MensajeChat[]
  solicitudesReserva SolicitudReserva[]
  solicitudesCambio  SolicitudCambio[]
  whatsappMensajes   WhatsappMensaje[]
  ia_consumos        IaConsumo[]
  vouchers           VoucherPago[]

  @@map("conversacion")
}

model MensajeChat {
  id                  BigInt           @id @default(autoincrement())
  conversacion_id     BigInt
  direccion           String           // ENTRA | SALE
  autor               String           // CLIENTE | BOT | PERSONA
  tipo                String           // TEXTO | IMAGEN | AUDIO | BOTON | PLANTILLA | SISTEMA
  contenido           Json
  meta_id             String?          @unique
  whatsapp_mensaje_id BigInt?
  en                  DateTime         @default(now()) @db.Timestamptz

  conversacion        Conversacion     @relation(fields: [conversacion_id], references: [id], onDelete: Cascade)
  whatsappMensaje     WhatsappMensaje? @relation(fields: [whatsapp_mensaje_id], references: [id], onDelete: SetNull)

  @@index([whatsapp_mensaje_id])
  @@map("mensaje_chat")
}

model RespuestaRapida {
  id     BigInt  @id @default(autoincrement())
  titulo String  @unique
  texto  String
  activo Boolean @default(true)

  @@map("respuesta_rapida")
}

model SolicitudReserva {
  id              BigInt        @id @default(autoincrement())
  conversacion_id BigInt?
  personas        Int?
  hora            DateTime?     @db.Timestamptz
  estado          String        @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA
  reserva_id      BigInt?
  nombre          String?
  telefono        String?
  nota            String?
  motivo_rechazo  String?
  creado_en       DateTime      @default(now()) @db.Timestamptz

  conversacion    Conversacion? @relation(fields: [conversacion_id], references: [id])
  reserva         Reserva?      @relation(fields: [reserva_id], references: [id])

