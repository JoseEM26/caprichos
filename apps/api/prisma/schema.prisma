  lng_anterior            Decimal?        @db.Decimal(9, 6)
  direccion_anterior      String?
  referencia_anterior     String?
  zona_anterior_id        BigInt?
  lat_nueva               Decimal         @db.Decimal(9, 6)
  lng_nueva               Decimal         @db.Decimal(9, 6)
  direccion_nueva         String?
  referencia_nueva        String?
