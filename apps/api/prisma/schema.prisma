}

model SolicitudCambio {
  id                BigInt        @id @default(autoincrement())
  pedido_id         BigInt
  conversacion_id   BigInt?
  tipo              String        // DIRECCION | PEDIDO | CANCELAR
  detalle           String?
  estado            String        @default("PENDIENTE") // PENDIENTE | ACEPTADA | RECHAZADA
  nueva_direccion   String?
  nueva_referencia  String?
  nueva_zona_id     BigInt?
  nueva_zona_nombre String?
  nuevo_envio       Decimal?      @db.Decimal(10, 2)
  recargo_envio     Decimal?      @db.Decimal(10, 2)
  lat               Decimal?      @db.Decimal(10, 7)
  lng               Decimal?      @db.Decimal(10, 7)
  decidido_por      BigInt?
  decidido_en       DateTime?     @db.Timestamptz
  motivo            String?
  creado_en         DateTime      @default(now()) @db.Timestamptz

  pedido            Pedido        @relation(fields: [pedido_id], references: [id])
  conversacion      Conversacion? @relation(fields: [conversacion_id], references: [id])

  @@map("solicitud_cambio")
}

model Encuesta {
  id            BigInt    @id @default(autoincrement())
  pedido_id     BigInt    @unique
  nota          Int?      @db.SmallInt
  comentario    String?
  derivada      Boolean   @default(false)
  enviada_en    DateTime? @db.Timestamptz
  respondida_en DateTime? @db.Timestamptz

  pedido        Pedido    @relation(fields: [pedido_id], references: [id])

  @@map("encuesta")
}

model Notificacion {
  id            BigInt    @id @default(autoincrement())
  tipo          String
  rol_destino   String?
  party_destino BigInt?
  titulo        String
  mensaje       String?
  enlace        String?
  leida_en      DateTime? @db.Timestamptz
  en            DateTime  @default(now()) @db.Timestamptz

  rol           Rol?      @relation(fields: [rol_destino], references: [codigo])
  party         Party?    @relation(fields: [party_destino], references: [id])

  @@map("notificacion")
}

/// Estado de lectura de cada notificación POR PERSONA (clave `n:<id>` o `c:<tipo>:<firma>`).
/// leida_en NULL = marcada como no leída de forma explícita (sobrescribe el leida_en heredado de notificacion).
model NotificacionLectura {
  party_id  BigInt
  clave     String
  leida_en  DateTime? @default(now()) @db.Timestamptz

  @@id([party_id, clave])
  @@index([party_id, leida_en])
  @@map("notificacion_lectura")
}

model VersionCarta {
  id            BigInt    @id @default(autoincrement())
  estado        String    // BORRADOR | PUBLICADA | ARCHIVADA
  organizacion  String    @default("SECCIONES") // SECCIONES | LISTA | TARJETAS
  decoracion    String?   // NINGUNO | HALLOWEEN | NAVIDAD | ANONUEVO | SANVALENTIN | MADRE | PADRE | PATRIAS | NINOS
  contenido     Json      // orden, destacados superiores, ocultos
  publicada_en  DateTime? @db.Timestamptz
  publicada_por BigInt?

  @@map("version_carta")
}

model Novedad {
  id           BigInt        @id @default(autoincrement())
  tipo         String        // PROMOCION | BANNER | VIDEO | FOTOS | EVENTO | AVISO
  titulo       String
  texto        String?
  tema         String?
  video_url    String?
  evento_fecha DateTime?     @db.Timestamptz
  evento_lugar String?
  desde        DateTime?     @db.Date
  hasta        DateTime?     @db.Date
  orden        Int           @default(0)
  activo       Boolean       @default(false)
  tamano       String        @default("MEDIANO") // CHICO | MEDIANO | GRANDE | ANCHO
  creado_en    DateTime      @default(now()) @db.Timestamptz

