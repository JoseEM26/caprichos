{
  "name": "@caprichos/agente-local",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run src",
    "probar": "node dist/cli.js probar",
    "volcar": "node dist/cli.js volcar",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "empaquetar:win": "tsc && pkg dist/index.js --targets node22-win-x64 --output dist-exe/agente-impresion-windows.exe",
    "empaquetar:linux": "tsc && pkg dist/index.js --targets node22-linux-x64 --output dist-exe/agente-impresion-linux"
  },
  "dependencies": {
    "@caprichos/compartido": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5",
    "@yao-pkg/pkg": "^6.0.0"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ]
  }
}
